@@ -0,0 +1,101 @@
+"""Opt-in HC4 FP32 normalization only; projection/gates/softmax/mixing stay Torch."""
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+
+import torch
+import triton
+import triton.language as tl
+
+_IDENTITY_EMITTED = False
+
+
+@triton.jit
+def _sum4_balanced_01(value, columns):
+    # Actual NPU Torch last-axis ReduceSum uses (v0+v1)+(v2+v3).
+    # Masked two-element reductions preserve each intermediate FP32 rounding.
+    return tl.sum(tl.where(columns < 2, value, 0.0), 0) + tl.sum(tl.where(columns >= 2, value, 0.0), 0)
+
+
+@triton.jit
+def _sinkhorn_hc4_fp32_kernel(Comb, Out, EPS: tl.constexpr):
+    token = tl.program_id(0)
+    columns = tl.arange(0, 4)
+    r0 = tl.load(Comb + token * 16 + columns).to(tl.float32)
+    r1 = tl.load(Comb + token * 16 + 4 + columns).to(tl.float32)
+    r2 = tl.load(Comb + token * 16 + 8 + columns).to(tl.float32)
+    r3 = tl.load(Comb + token * 16 + 12 + columns).to(tl.float32)
+    # Actual NPU Torch non-last-axis ReduceSum is left-associated.
+    col = ((r0 + r1) + r2) + r3 + EPS
+    r0 = tl.div_rn(r0, col)
+    r1 = tl.div_rn(r1, col)
+    r2 = tl.div_rn(r2, col)
+    r3 = tl.div_rn(r3, col)
+    for _ in tl.static_range(19):
+        r0 = tl.div_rn(r0, _sum4_balanced_01(r0, columns) + EPS)
+        r1 = tl.div_rn(r1, _sum4_balanced_01(r1, columns) + EPS)
+        r2 = tl.div_rn(r2, _sum4_balanced_01(r2, columns) + EPS)
+        r3 = tl.div_rn(r3, _sum4_balanced_01(r3, columns) + EPS)
+        col = ((r0 + r1) + r2) + r3 + EPS
+        r0 = tl.div_rn(r0, col)
+        r1 = tl.div_rn(r1, col)
+        r2 = tl.div_rn(r2, col)
+        r3 = tl.div_rn(r3, col)
+    tl.store(Out + token * 16 + columns, r0)
+    tl.store(Out + token * 16 + 4 + columns, r1)
+    tl.store(Out + token * 16 + 8 + columns, r2)
+    tl.store(Out + token * 16 + 12 + columns, r3)
+
+
+def _record_first_execution(comb, sinkhorn_eps):
+    global _IDENTITY_EMITTED
+    location = os.environ.get("GLM53_EXECUTION_IDENTITY_DIR")
+    if _IDENTITY_EMITTED or not location:
+        return
+    # Startup-only synchronization, before any measured request. A record
+    # proves the actual fused invocation completed, rather than mere import.
+    torch.npu.synchronize(comb.device)
+    import torch.distributed as dist
+    rank = dist.get_rank() if dist.is_initialized() else 0
+    source = Path(__file__).resolve()
+    caller = source.with_name("mhc.py")
+    value = {"pid": os.getpid(), "rank": rank,
+             "candidate_commit": os.environ.get("GLM53_CANDIDATE_COMMIT"),
+             "selected_implementation": "triton-hc4-fp32-normalization-only",
+             "first_shape": list(comb.shape), "input_dtype": str(comb.dtype),
+             "output_dtype": "torch.float32", "sinkhorn_eps": sinkhorn_eps,
+             "sinkhorn_repeat": 20, "first_execution_synchronized": True,
+             "source": {"path": str(source), "sha256": hashlib.sha256(source.read_bytes()).hexdigest()},
+             "caller": {"path": str(caller), "sha256": hashlib.sha256(caller.read_bytes()).hexdigest()}}
+    directory = Path(location); directory.mkdir(parents=True, exist_ok=True)
+    target = directory / ("mhc-fused-rank-" + str(rank) + ".json")
+    with target.open("x") as stream:
+        json.dump(value, stream, indent=2); stream.write("\n")
+    _IDENTITY_EMITTED = True
+    print("GLM53_MHC_FUSED_EXECUTION " + json.dumps(value), flush=True)
+
+
+def fused_sinkhorn_normalize(comb: torch.Tensor, sinkhorn_eps: float,
+                             sinkhorn_repeat: int = 20) -> torch.Tensor:
+    """Normalize positive FP32 [T,4,4] after the unchanged softmax+epsilon.
+
+    This experimental entry has an explicit HC4/20-iteration contract; unsupported
+    inputs fail rather than silently changing arithmetic or falling back.
+    """
+    if comb.device.type != "npu" or comb.dtype != torch.float32:
+        raise ValueError("mHC fused normalization requires NPU FP32 input")
+    if comb.ndim != 3 or tuple(comb.shape[1:]) != (4, 4) or not comb.is_contiguous():
+        raise ValueError("mHC fused normalization requires contiguous [T,4,4]")
+    if type(sinkhorn_repeat) is not int or sinkhorn_repeat != 20:
+        raise ValueError("mHC fused normalization supports exactly 20 Sinkhorn iterations")
+    if isinstance(sinkhorn_eps, bool) or not isinstance(sinkhorn_eps, (int, float)) or not math.isfinite(sinkhorn_eps) or sinkhorn_eps <= 0:
+        raise ValueError("mHC fused normalization requires finite positive epsilon")
+    result = torch.empty_like(comb)
+    if comb.shape[0] == 0:
+        return result
+    _sinkhorn_hc4_fp32_kernel[(comb.shape[0],)](comb, result, float(sinkhorn_eps),
+                                              num_warps=4, enable_fp_fusion=False)
+    _record_first_execution(comb, float(sinkhorn_eps))
+    return result
