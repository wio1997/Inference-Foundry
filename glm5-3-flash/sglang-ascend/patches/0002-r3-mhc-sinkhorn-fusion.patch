+# SPDX-License-Identifier: MIT
+"""Pure ctypes runtime for the fixed public ordered HC4 tail's existing C ABI.
+
+ABI source: tile-ai/tilelang-ascend@2f22c6ac17a4235aa3de5ccf25729c3553b46e02,
+examples/gemm_aot/test_example_gemm.py and src/target/codegen_ascend.cc.
+Math remains the already tested c27 ordered public tail; no compiler/frontend
+module, pickle, new math kernel, device switch or global library-path edit here.
+Library identity is checked before load; first completed call is recorded only.
+"""
+import ctypes
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import sys
+import threading
+import time
+
+import torch
+
+_LIB = None
+_LIB_ID = None
+_LOADER_LOCK = threading.Lock()
+_EXECUTION_RECORDED = False
+_SELECTED_KERNEL_SHA = "8b4ab5f9c4eb37f64b4d9746def519a2247a959119db6e19caae0297af988945"
+_SELECTED_SOURCE_SHA = "c6b161af7acf52e25019a730d201811179ac73cf58101850f6c61a3a51949331"
+
+
+def _identity(path):
+    path = Path(path).resolve(strict=True)
+    before = path.stat()
+    h = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            h.update(block)
+    after = path.stat()
+    if (before.st_size, before.st_mtime_ns, before.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):
+        raise RuntimeError("bound artifact changed while hashing")
+    return {"path": str(path), "bytes": after.st_size, "sha256": h.hexdigest(), "stat_stable": True}
+
+
+def _library():
+    global _LIB, _LIB_ID
+    if _LIB is not None:
+        return _LIB
+    with _LOADER_LOCK:
+        if _LIB is not None:
+            return _LIB
+        location = os.environ.get("GLM53_MHC_AOT_LIBRARY")
+        expected = os.environ.get("GLM53_MHC_AOT_SHA256", "")
+        if not location or not re.fullmatch(r"[0-9a-f]{64}", expected):
+            raise RuntimeError("explicit AOT library path and full expected SHA256 are required")
+        if expected != _SELECTED_KERNEL_SHA:
+            raise RuntimeError("only the fixed already selected public c27 artifact is supported")
+        observed = _identity(location)
+        if observed["sha256"] != expected:
+            raise RuntimeError("AOT kernel SHA256 does not match the declared artifact")
+        lib = ctypes.CDLL(observed["path"], mode=ctypes.RTLD_LOCAL)
+        lib.call.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int64, ctypes.c_void_p]
+        lib.call.restype = None  # Existing AscendC launcher returns void, not status int.
+        # No lib.init(): public NPU AOT example and Cython adapter do not call it.
+        _LIB_ID, _LIB = observed, lib
+        return _LIB
+
+
+def _record_first_execution(comb):
+    global _EXECUTION_RECORDED
+    location = os.environ.get("GLM53_EXECUTION_IDENTITY_DIR")
+    if _EXECUTION_RECORDED or not location:
+        return
+    with _LOADER_LOCK:
+        if _EXECUTION_RECORDED:
+            return
+        torch.npu.synchronize(comb.device)  # First warmup only; no per-token hash/sync.
+        observed_epoch = time.time()
+        import torch.distributed as dist
+        rank = dist.get_rank() if dist.is_initialized() else 0
+        caller_frame = sys._getframe(2)
+        tvm = sys.modules.get("tvm")  # CANN may own its own TVM; this module never imports it.
+        value = {"pid": os.getpid(), "rank": rank,
+            "candidate_commit": os.environ.get("GLM53_CANDIDATE_COMMIT"),
+            "selected_implementation": "tilelang-public-ordered-tail-aot-ctypes",
+            "math_origin_commit": "c27da9d1b830db29237fe26f61a637a27ef5aabe",
+            "upstream_commit": "2f22c6ac17a4235aa3de5ccf25729c3553b46e02",
+            "source": _identity(__file__), "caller": _identity(caller_frame.f_code.co_filename),
+            "kernel_library": _LIB_ID, "call_abi": "void(void*,void*,int64_t,aclrtStream)",
+            "generated_source_sha256": _SELECTED_SOURCE_SHA,
+            "target": "ascendc", "platform": "A3", "sinkhorn_eps": 1e-6, "sinkhorn_repeat": 20,
+            "observed_epoch": observed_epoch, "input_dtype": str(comb.dtype), "output_dtype": "torch.float32",
+            "first_shape": list(comb.shape), "first_stride": list(comb.stride()),
+            "first_execution_synchronized": True,
+            "phase_contract": "controller must bind first nonempty call to warmup before formal timing",
+            "tilelang_python_present": "tilelang" in sys.modules,
+            "existing_tvm_module_file": getattr(tvm, "__file__", None),
+            "loader_policy": "RTLD_LOCAL; no compiler import, dlpack, namespace or environment mutation"}
+        directory = Path(location)
+        directory.mkdir(parents=True, exist_ok=True)
+        with (directory / f"mhc-fused-rank-{rank}.json").open("x") as stream:
+            json.dump(value, stream, indent=2)
+            stream.write("\n")
+        _EXECUTION_RECORDED = True
+        print("GLM53_MHC_FUSED_EXECUTION " + json.dumps(value), flush=True)
+
+
+def fused_sinkhorn_normalize(comb: torch.Tensor, sinkhorn_eps: float,
+                             sinkhorn_repeat: int = 20) -> torch.Tensor:
+    """Same strict [T,4,4] contract; compiled epsilon/iterations are immutable."""
+    if not isinstance(comb, torch.Tensor) or comb.device.type != "npu" or comb.dtype != torch.float32:
+        raise ValueError("AOT public normalization requires NPU FP32")
+    if comb.ndim != 3 or tuple(comb.shape[1:]) != (4, 4) or not comb.is_contiguous():
+        raise ValueError("AOT public normalization requires contiguous [T,4,4]")
+    if type(sinkhorn_repeat) is not int or sinkhorn_repeat != 20:
+        raise ValueError("AOT artifact is specialized for 20 Sinkhorn iterations")
+    if isinstance(sinkhorn_eps, bool) or not isinstance(sinkhorn_eps, (int, float)) or sinkhorn_eps != 1e-6:
+        raise ValueError("AOT artifact is specialized for epsilon 1e-6")
+    if torch.npu.current_device() != comb.device.index:
+        raise ValueError("input must belong to the current NPU device")
+    result = torch.empty_like(comb)
+    if comb.shape[0] == 0:
+        return result
+    lib = _library()
+    stream = torch.npu.current_stream()
+    # Preserve tensor lifetime on the actual launch stream for the external call.
+    comb.record_stream(stream)
+    result.record_stream(stream)
+    lib.call(ctypes.c_void_p(comb.data_ptr()), ctypes.c_void_p(result.data_ptr()),
+             ctypes.c_int64(comb.shape[0]), ctypes.c_void_p(stream.npu_stream))
+    if not _EXECUTION_RECORDED:
+        _record_first_execution(comb)
+    return result
