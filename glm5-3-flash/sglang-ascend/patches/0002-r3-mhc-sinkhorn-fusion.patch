+def fused_sinkhorn_normalize(comb: torch.Tensor, sinkhorn_eps: float,
+                             sinkhorn_repeat: int = 20) -> torch.Tensor:
+    """Strict FP32 contiguous NPU [T,4,4] adapter; no hidden fallback.
+
+    JIT target/platform/out_idx are supported by the fixed source API, but
+    compilation, generated reduction order and exact numerical gates remain
+    unverified until the caller's isolated-container component execution.
+    """
+    if not isinstance(comb, torch.Tensor) or comb.device.type != "npu" or comb.dtype != torch.float32:
+        raise ValueError("mHC TileLang normalization requires NPU FP32 input")
+    if comb.ndim != 3 or tuple(comb.shape[1:]) != (4, 4) or not comb.is_contiguous():
+        raise ValueError("mHC TileLang normalization requires contiguous [T,4,4]")
+    if type(sinkhorn_repeat) is not int or sinkhorn_repeat != 20:
+        raise ValueError("mHC TileLang normalization supports exactly 20 Sinkhorn iterations")
+    if isinstance(sinkhorn_eps, bool) or not isinstance(sinkhorn_eps, (int, float)) or not math.isfinite(sinkhorn_eps) or sinkhorn_eps <= 0:
+        raise ValueError("mHC TileLang normalization requires finite positive epsilon")
+    if comb.shape[0] == 0:
+        return torch.empty_like(comb)
+    if torch.npu.current_device() != comb.device.index:
+        raise ValueError("mHC TileLang input must belong to the current NPU device")
+    kernel = _sinkhorn_hc4_fp32(float(sinkhorn_eps))
+    result = kernel(comb)
+    if not isinstance(result, torch.Tensor) or result.dtype != comb.dtype or result.device != comb.device or tuple(result.shape) != tuple(comb.shape) or not result.is_contiguous():
+        raise RuntimeError("TileLang single-output allocation did not preserve the declared comb contract")
+    if not _IDENTITY_EMITTED:
+        _record_first_execution(comb, float(sinkhorn_eps))
+    return result
