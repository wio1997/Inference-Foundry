+LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+SOFTWARE
+"""
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import sys
+import threading
+import time
+
+import torch
+import tilelang
+from tilelang import language as T
+
+UPSTREAM_COMMIT = "2f22c6ac17a4235aa3de5ccf25729c3553b46e02"
+UPSTREAM_FILE = "examples/deepseek_v4/hc_split_sinkhorn.py"
+UPSTREAM_SHA256 = "73b90d4279be959b5436941072bd6428bdc0ccc9e9f22989c874081a250d5400"
+_IDENTITY_EMITTED = False
+_IDENTITY_LOCK = threading.Lock()
+_PASS_CONFIGS = {
+    tilelang.PassConfigKey.TL_ASCEND_AUTO_CV_COMBINE: True,
+    tilelang.PassConfigKey.TL_ASCEND_AUTO_SYNC: True,
+    tilelang.PassConfigKey.TL_ASCEND_MEMORY_PLANNING: True,
+}
+
+
+@tilelang.jit(out_idx=[1], workspace_idx=None, target="ascendc", platform="A3",
+              pass_configs=_PASS_CONFIGS)
+def _sinkhorn_hc4_fp32(sinkhorn_eps: float):
+    n = T.symbolic("n")
+    block_M, VEC_NUM = 2, 2
+    m_num = tilelang.cdiv(n, block_M)
+
+    @T.prim_func
+    def main(comb: T.Tensor([n, 4, 4], "float"),
+             out: T.Tensor([n, 4, 4], "float")):
+        with T.Kernel(m_num, is_npu=True) as (cid, vid):
+            value = T.alloc_shared((4, 8), "float")
+            row_sum = T.alloc_shared(8, "float")
+            col_sum = T.alloc_shared((1, 8), "float")
+            row_div = T.alloc_shared((4, 8), "float")
+            col_broadcast = T.alloc_shared((4, 8), "float")
+            column_row = T.alloc_shared((1, 8), "float")
+            if cid * block_M + vid * block_M // VEC_NUM < n:
+                # Logical width is four; physical rows stay 32-byte aligned.
+                T.tile.fill(value, 0.0)
+                for i in T.serial(4):
+                    T.copy(comb[cid * block_M + vid * block_M // VEC_NUM, i, 0:4],
+                           value[i, 0:4])
+                # Input already equals the existing Torch softmax(-1) + eps.
+                # Match the measured Torch non-last-axis FP32 order:
+                # ((row0 + row1) + row2) + row3, with separate UB FP32 stores.
+                T.copy(value[0:1, :], col_sum)
+                for column_i in T.serial(1, 4):
+                    T.copy(value[column_i:column_i + 1, :], column_row)
+                    T.tile.add(col_sum, col_sum, column_row)
+                T.tile.add(col_sum, col_sum, sinkhorn_eps)
+                T.tile.broadcast(col_broadcast, col_sum)
+                T.tile.div(value, value, col_broadcast)
+                for _ in T.serial(19):
+                    T.reduce_sum(value, row_sum, dim=-1, real_shape=[4, 4])
+                    T.tile.add(row_sum, row_sum, sinkhorn_eps)
+                    for i in T.serial(4):
+                        T.tile.fill(row_div[i, :], row_sum[i])
+                    T.tile.div(value, value, row_div)
+                    # Match the measured Torch non-last-axis FP32 order:
+                    # ((row0 + row1) + row2) + row3, with separate UB FP32 stores.
+                    T.copy(value[0:1, :], col_sum)
+                    for column_i in T.serial(1, 4):
+                        T.copy(value[column_i:column_i + 1, :], column_row)
+                        T.tile.add(col_sum, col_sum, column_row)
+                    T.tile.add(col_sum, col_sum, sinkhorn_eps)
+                    T.tile.broadcast(col_broadcast, col_sum)
+                    T.tile.div(value, value, col_broadcast)
+                for i in T.serial(4):
+                    T.copy(value[i, 0:4],
+                           out[cid * block_M + vid * block_M // VEC_NUM, i, 0:4])
+    return main
+
+
+def _file_identity(path):
+    path = Path(path).resolve()
+    try:
+        before = path.stat()
+        h = hashlib.sha256()
+        with path.open("rb") as stream:
+            for block in iter(lambda: stream.read(1024 * 1024), b""):
+                h.update(block)
+        after = path.stat()
+        return {"path": str(path), "bytes": after.st_size, "sha256": h.hexdigest(),
+                "stat_stable": (before.st_size, before.st_mtime_ns, before.st_ino) ==
+                               (after.st_size, after.st_mtime_ns, after.st_ino)}
+    except OSError as error:
+        return {"path": str(path), "sha256": None, "error": type(error).__name__}
+
+
+def _mapped_tilelang_libraries():
+    paths = set()
+    try:
+        for line in Path("/proc/self/maps").read_text().splitlines():
+            parts = line.split(None, 5)
+            if len(parts) == 6 and parts[5].startswith("/"):
+                path = parts[5]
+                if ".so" in Path(path).name and any(word in path.lower() for word in ("tilelang", "tvm")):
+                    paths.add(path)
+        return [{**_file_identity(path), "mapped_path": path} for path in sorted(paths)], None
+    except OSError as error:
+        return [], type(error).__name__
+
+
+def _record_first_execution(comb, sinkhorn_eps):
+    global _IDENTITY_EMITTED
+    location = os.environ.get("GLM53_EXECUTION_IDENTITY_DIR")
+    if _IDENTITY_EMITTED or not location:
+        return
+    with _IDENTITY_LOCK:
+        if _IDENTITY_EMITTED:
+            return
+        # Startup-only proof of the completed nonempty call. The controller
+        # must schedule this first invocation in warmup, not timed requests.
+        torch.npu.synchronize(comb.device)
+        import torch.distributed as dist
+        rank = dist.get_rank() if dist.is_initialized() else 0
