@@ -0,0 +1,115 @@
+"""Opt-in R4: narrow eager KPool CPU metadata snapshot cache.
+
+No environment is changed here. The production caller must keep all original
+validation, per-layer tail zeroing and audit calls outside this helper.
+Inference tensors have no version counter: reuse for them is justified only by
+this exact eager/no-preplan/no-TBO/no-spec lifecycle and read-only source path.
+This is not a general mutation-safe tensor memoizer.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Optional
+
+import torch
+
+_CACHE_ATTRIBUTE = "_glm53_kpool_cpu_metadata_snapshot"
+
+
+@dataclass(frozen=True)
+class _TensorKey:
+    tensor: torch.Tensor  # Strong reference; no id-reuse ambiguity.
+    layout: tuple
+    version: Optional[int]
+
+    @classmethod
+    def of(cls, tensor):
+        try:
+            version = tensor._version
+        except RuntimeError:
+            # Inference tensors do not track version counters. See module
+            # contract. We still retain object identity and the eager lifetime.
+            version = None
+        return cls(tensor, (tuple(tensor.shape), tuple(tensor.stride()),
+                           tensor.storage_offset(), tensor.dtype, tensor.device),
+                   version)
+
+    def matches(self, other):
+        return (self.tensor is other.tensor and self.layout == other.layout
+                and self.version == other.version)
+
+
+@dataclass(frozen=True)
+class _Key:
+    mode: object
+    count: int
+    tensors: tuple[_TensorKey, ...]
+
+    def matches(self, other):
+        return (self.mode == other.mode and self.count == other.count
+                and len(self.tensors) == len(other.tensors)
+                and all(a.matches(b) for a, b in zip(self.tensors, other.tensors)))
+
+
+@dataclass(frozen=True)
+class _Entry:
+    key: _Key
+    # Four flat immutable CPU tuples in original readback order.
+    values: tuple[tuple, tuple, tuple, tuple]
+
+
+def _eligible(enabled, backend, forward_batch, positions):
+    mode = forward_batch.forward_mode
+    return (
+        enabled
+        and getattr(backend, "graph_mode", None) is False
+        and getattr(forward_batch, "spec_info", None) is None
+        and not bool(getattr(forward_batch, "can_run_tbo", True))
+        # False forces eager_runner to init a new ForwardMetadata for this pass.
+        # Pre-planned/skip-init paths intentionally retain original readbacks.
+        and getattr(forward_batch, "forward_metadata_ready", True) is False
+        and (mode.is_decode() or mode.is_extend())
+        and not mode.is_target_verify()
+        and not mode.is_draft_extend_v2()
+        and positions.dim() == 1
+        and forward_batch.seq_lens.dim() == 1
+        and forward_batch.req_pool_indices.dim() == 1
+        and (not mode.is_extend()
+             or forward_batch.extend_seq_lens.dim() == 1)
+    )
+
+
+def _read(query_lens, seq_lens, slots, positions):
+    # Preserve readback ordering: first barrier remains at the first KPool layer.
+    return (query_lens.detach().cpu().tolist(),
+            seq_lens.detach().cpu().tolist(),
+            slots.detach().cpu().tolist(),
+            positions.detach().cpu().tolist())
+
+
+def read_kpool_cpu_metadata(backend, forward_batch, positions, query_lens,
+                            seq_lens, slots, count, *, enabled=False):
+    """Return (four original-list values, event) for the existing validation.
+
+    event is only a cheap optional diagnostic token: bypass/miss/hit. Do not log
+    per-layer values in timed runs. This helper does not cache validation or
+    persistent state operations. Decode key uses original seq_lens/mode, never
+    its fresh per-layer ones_like query_lens. .to() temporaries are not keys.
+    """
+    if not _eligible(enabled, backend, forward_batch, positions):
+        return _read(query_lens, seq_lens, slots, positions), "bypass"
+    originals = (forward_batch.seq_lens, forward_batch.req_pool_indices,
+                 positions)
+    if forward_batch.forward_mode.is_extend():
+        originals += (forward_batch.extend_seq_lens,)
+    key = _Key(forward_batch.forward_mode, count,
+               tuple(_TensorKey.of(t) for t in originals))
+    metadata = backend.forward_metadata
+    previous = getattr(metadata, _CACHE_ATTRIBUTE, None)
+    if previous is not None and previous.key.matches(key):
+        # Fresh lists preserve original audit_context types and isolate callers.
+        return tuple(list(v) for v in previous.values), "hit"
+    values = _read(query_lens, seq_lens, slots, positions)
+    setattr(metadata, _CACHE_ATTRIBUTE,
+            _Entry(key, tuple(tuple(v) for v in values)))
+    return values, "miss"
