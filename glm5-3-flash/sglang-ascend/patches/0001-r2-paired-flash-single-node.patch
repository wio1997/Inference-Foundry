+def tensor_meta(x):
+    return {'shape':list(x.shape),'stride':list(x.stride()),'dtype':str(x.dtype),'device':str(x.device),'ptr':int(x.data_ptr()),'storage_offset':int(x.storage_offset()),'storage_bytes':int(x.untyped_storage().nbytes())}
