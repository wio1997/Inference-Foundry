+"""Opt-in one-time startup identity; no tensor reads or per-token hooks."""
+import collections
+import hashlib
+import inspect
+import json
+import os
+from pathlib import Path
+
+def record_backend(backend, runner, core):
+    location = os.environ.get("GLM53_EXECUTION_IDENTITY_DIR")
+    if not location:
+        return
+    def identity(obj):
+        p = Path(inspect.getsourcefile(inspect.unwrap(obj))).resolve()
+        return {"path": str(p), "sha256": hashlib.sha256(p.read_bytes()).hexdigest()}
+    quant = collections.Counter()
+    examples = {}
+    for name, module in runner.model.named_modules():
+        method = getattr(module, "quant_method", None)
+        if method is not None:
+            kind = type(method).__module__ + "." + type(method).__qualname__
+            quant[kind] += 1
+            examples.setdefault(kind, name)
+    value = {"pid": os.getpid(), "tp_rank": runner.tp_rank, "gpu_id": runner.gpu_id,
+             "candidate_commit": os.environ.get("GLM53_CANDIDATE_COMMIT"),
+             "backend_class": type(backend).__module__ + "." + type(backend).__qualname__,
+             "extend_class": type(backend.kernel_dispatcher.extend_kernel).__module__ + "." + type(backend.kernel_dispatcher.extend_kernel).__qualname__,
+             "backend_source": identity(type(backend)), "core_source": identity(core),
+             "quant_method_counts": dict(quant), "quant_method_examples": examples}
+    directory = Path(location); directory.mkdir(parents=True, exist_ok=True)
+    target = directory / ("tp-rank-" + str(runner.tp_rank) + ".json")
+    with target.open("x") as out:
+        json.dump(value, out, indent=2); out.write("\n")
+    print("GLM53_EXECUTION_IDENTITY " + json.dumps(value), flush=True)
