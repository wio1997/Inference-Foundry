+                qbar,
+                cache,
+                cum_query_lens,
+                indexer_seq_lens,
+                indexer_block_table,
+                positions,
+                scores,
+                start,
+                rows,
+                max_pool_seq_len,
+                cum_query_lens.numel(),
+                indexer_cache.shape[0],
+                0 if packed_cache else cache.stride(0),
+                cache.stride(1),
+                cache.stride(3),
+                *indexer_block_table.stride(),
+                indexer_cache.shape[1],
+                QUERY_END_SENTINEL,
+                next_power_of_2(cum_query_lens.numel()),
