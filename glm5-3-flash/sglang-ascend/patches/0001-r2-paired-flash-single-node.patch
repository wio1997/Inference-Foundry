+            indexer_block_table,
+            indexer_seq_lens,
+            cache,
+            cum_query_lens.numel(),
+            max_pool_seq_len,
+            indexer_cache.shape[0],
+            indexer_cache.shape[1],
+            indexer_cache.stride(0),
+            indexer_cache.stride(1),
+            indexer_cache.stride(3),
+            *indexer_block_table.stride(),
+            head_dim,
+            TRITON_POOL_CHUNK_SIZE,
+        )
