diff --git a/bootstrap/vllm_target_handoff.py b/bootstrap/vllm_target_handoff.py
index 707fc13..537f484 100644
--- a/bootstrap/vllm_target_handoff.py
+++ b/bootstrap/vllm_target_handoff.py
@@ -185,8 +185,34 @@ class DirectTargetHandoff:
         return output

     def binding(self) -> FixedTargetBinding:
+        start_pos_buffers = []
+        seen = set()
+        metadata_values = []
+        pending = [self.attn_metadata]
+        seen_containers = set()
+        while pending:
+            current = pending.pop()
+            if id(current) in seen_containers:
+                continue
+            seen_containers.add(id(current))
+            if isinstance(current, dict):
+                pending.extend(current.values())
+            elif isinstance(current, (list, tuple)):
+                pending.extend(current)
+            else:
+                metadata_values.append(current)
+        for metadata in metadata_values:
+            for owner in (
+                getattr(metadata, "decode", None),
+                getattr(metadata, "req_metadata", None),
+            ):
+                start_pos = getattr(owner, "start_pos", None)
+                if torch.is_tensor(start_pos) and start_pos.data_ptr() not in seen:
+                    seen.add(start_pos.data_ptr())
+                    start_pos_buffers.append(start_pos)
         return FixedTargetBinding(
             forward=self.forward,
             compute_logits=self.model.compute_logits,
             state_fingerprint=lambda: {},
+            dsa_start_pos_buffers=tuple(start_pos_buffers),
         )
