+"""Exact GLM HC4 Sinkhorn stages fused for the fixed Triton Ascend backend.
+
+Keeps row softmax, epsilon placement and all 39 FP32 normalizations. This
+candidate is not promoted into serving until numerical and graph gates pass.
+"""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _sinkhorn(X, Y, T: tl.constexpr, S0: tl.constexpr, S1: tl.constexpr,
+              S2: tl.constexpr, EPS: tl.constexpr, ITERS: tl.constexpr,
+              BT: tl.constexpr):
+    t = tl.program_id(0) * BT + tl.arange(0, BT)
+    i = tl.arange(0, 4)
+    j = tl.arange(0, 4)
+    offsets = t[:, None, None] * S0 + i[None, :, None] * S1 + j[None, None, :] * S2
+    a = tl.load(X + offsets, mask=t[:, None, None] < T, other=0).to(tl.float32)
+    z = a - tl.max(a, axis=2)[:, :, None]
+    e = tl.exp(z)
+    v = e / tl.sum(e, axis=2)[:, :, None] + EPS
+    v = v / (tl.sum(v, axis=1)[:, None, :] + EPS)
+    for _ in range(ITERS - 1):
+        v = v / (tl.sum(v, axis=2)[:, :, None] + EPS)
+        v = v / (tl.sum(v, axis=1)[:, None, :] + EPS)
+    dst = t[:, None, None] * 16 + i[None, :, None] * 4 + j[None, None, :]
+    tl.store(Y + dst, v, mask=t[:, None, None] < T)
+
+
+def fused_sinkhorn(comb, eps, iters):
+    if comb.device.type != 'npu' or comb.dtype != torch.float32 or comb.ndim != 3 or tuple(comb.shape[1:]) != (4, 4):
+        raise ValueError('Requires FP32 NPU [T,4,4] residual logits')
+    if not isinstance(iters, int) or iters < 1:
+        raise ValueError('Positive integer iteration count required')
+    out = torch.empty(comb.shape, device=comb.device, dtype=torch.float32)
+    if comb.shape[0]:
+        _sinkhorn[(triton.cdiv(comb.shape[0], 32),)](
+            comb, out, comb.shape[0], *comb.stride(), float(eps), iters, 32,
+            enable_fp_fusion=False)
+    return out
