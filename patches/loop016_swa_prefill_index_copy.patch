+    def dsa_kv_compress_scatter(cache, x, slot_mapping, unique_write_slots=False):
         """Scatter KV into cache. Non-A5: simple scatter of pre-quantized tensor."""
+        global _LOOP016_SCATTER_RECORDED
+        flag = os.environ.get("LOOP016_INDEX_COPY_FLAG")
+        if (
+            unique_write_slots
+            and flag
+            and os.path.exists(flag)
+            and x.shape[0] >= 1024
+            and slot_mapping.ndim == 2
+            and slot_mapping.shape[1] == 2
+            and cache.ndim == 4
