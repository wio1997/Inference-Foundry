+                and cache.stride(0) % row_width == 0
+                and cache.stride(1) % row_width == 0
+            ):
+                block_stride = cache.stride(0) // row_width
+                offset_stride = cache.stride(1) // row_width
+                span = (cache.shape[0] - 1) * block_stride + (cache.shape[1] - 1) * offset_stride + 1
+                rows = cache.as_strided((span, row_width), (row_width, 1))
+                physical_index = (
+                    slot_mapping[:, 0] * block_stride + slot_mapping[:, 1] * offset_stride
+                ).contiguous()
+                rows.index_copy_(0, physical_index, x.reshape(-1, row_width))
