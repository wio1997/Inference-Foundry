+  if key not in seen:
+   seen.add(key)
+   owners=[{'tag':_room_tag(req.bootstrap_room),'req_slot':_scalar(req.kv.req_pool_idx),'mamba_slot':_scalar(req.kv.mamba_pool_idx),'holds_kv':bool(req.kv.holds_kv),'holds_mamba':bool(req.kv.holds_mamba)} for req in reqs]
