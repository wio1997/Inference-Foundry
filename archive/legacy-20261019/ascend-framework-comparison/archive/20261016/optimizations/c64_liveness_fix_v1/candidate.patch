+    def _defer_hicache_prefetch_until_bootstrap(self) -> bool:
+        """Do not pin a finite L2 bounce while waiting for decode capacity.
+
+        With early decode allocation and no optimistic prefill, a request
+        cannot consume its staged KV before bootstrap. Staging such requests
+        can exhaust L2 ahead of another request whose decode KV is already
