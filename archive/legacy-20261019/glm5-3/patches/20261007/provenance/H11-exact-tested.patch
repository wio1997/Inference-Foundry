+    def _glm_k1_stage_block_table(self, common_attn_metadata):
+        # The SFA builder retains a local view of this table. Bind persistent
+        # storage before building metadata, including the first draft step.
+        source = common_attn_metadata.block_table_tensor
+        target = self.block_table_tensor_clone
+        assert target is not None and source.ndim == target.ndim == 2
+        assert source.shape[0] <= target.shape[0] and source.shape[1] == target.shape[1]
+        view = target[: source.shape[0]]
+        if source.data_ptr() != view.data_ptr() or source.stride() != view.stride():
+            view.copy_(source)
+        common_attn_metadata.block_table_tensor = view
+
+    def _glm_k1_graph_contract(self, kwargs):
+        n = kwargs["num_input_tokens"]
+        batch = kwargs["batch_size"]
+        indices = kwargs["token_indices_to_sample"]
+        steps = kwargs["multi_steps_attn_metadata"]
+        if (
+            self.num_speculative_tokens != 1
+            or kwargs.get("is_prefill", False)
+            or n != 2 * batch
+            or kwargs["num_tokens"] != n
+            or tuple(indices.shape) != (batch,)
+            or kwargs["inputs_embeds"] is not None
+            or len(steps) != 1
+        ):
+            return None
+
+        def tensor_signature(tensor):
+            if tensor is None:
+                return None
+            if not isinstance(tensor, torch.Tensor):
+                raise TypeError("GLM graph metadata must contain tensors")
+            return (tensor.data_ptr(), tuple(tensor.shape), tuple(tensor.stride()), str(tensor.dtype), str(tensor.device))
+
+        inputs = (self.input_ids[:n], self._get_positions(n), self.hidden_states[:n], indices)
+        signatures = [tuple(tensor_signature(t) for t in inputs)]
+        for name, layer in sorted(self._glm_k1_layers.items()):
+            caches = getattr(layer, "kv_cache", ())
+            if isinstance(caches, torch.Tensor):
+                caches = (caches,)
+            impl = getattr(layer, "impl", None)
+            # SFA's separate indexer owns key/scale KV outside layer.kv_cache.
+            # The composer only joins handles; it submits no device work.
+            caches = impl._compose_sfa_kv_cache(caches)
+            signatures.append((name, tuple(tensor_signature(t) for t in caches),
+                               tensor_signature(getattr(impl, "topk_indices_buffer", None))))
+        for name, metadata in sorted(steps[0].items()):
+            if (
+                type(metadata).__name__ != "AscendSFADCPMetadata"
+                or metadata.num_input_tokens != n
+                or metadata.num_prefills != 0
+                or metadata.num_decodes != batch
+                or metadata.num_decode_tokens != n
+                or metadata.attn_state not in (AscendAttentionState.DecodeOnly, AscendAttentionState.SpecDecoding)
+                or metadata.dcp_context is None
+            ):
+                return None
+            # CPU seq mirrors and num_actual_tokens are preparation-only for
+            # this decode branch. K1 reads the refreshed device buffers below.
+            fields = ("cum_query_lens", "seq_lens", "slot_mapping", "pcp_slot_mapping", "block_table",
+                      "sin", "cos", "attn_mask", "group_len", "group_key_idx", "group_key_cache_idx")
+            context = metadata.dcp_context
+            if context.kv_gather_block_ids is not None or context.kv_gather_block_table is not None:
+                return None
+            signatures.append((name, metadata.head_dim, metadata.block_size,
+                               tuple(tensor_signature(getattr(metadata, key)) for key in fields),
+                               tuple(tensor_signature(getattr(context, key)) for key in ("slot_mapping", "block_table", "seq_lens"))))
+        return (n, batch, tuple(signatures)) if steps[0] else None
+
+    def _run_glm_k1_graph(self, **kwargs):
+        context = get_forward_context()
+        if context.cudagraph_runtime_mode != CUDAGraphMode.FULL:
+            return self._glm_k1_acl(**kwargs)
+        descriptor = context.batch_descriptor
+        signature = self._glm_k1_graph_contract(kwargs) if descriptor.uniform and descriptor.num_tokens == kwargs["num_input_tokens"] else None
+        previous = self._glm_k1_contracts.get(descriptor)
+        if signature is None or (previous is not None and signature != previous):
+            # No graph work has been submitted: native eager is safe here.
+            mode = context.cudagraph_runtime_mode
+            context.cudagraph_runtime_mode = CUDAGraphMode.NONE
+            try:
+                return self._glm_k1_acl(**kwargs)
+            finally:
+                context.cudagraph_runtime_mode = mode
+        result = self._glm_k1_acl(**kwargs)
+        if previous is None:
+            self._glm_k1_contracts[descriptor] = signature
+        if tuple(result.shape) != (kwargs["batch_size"], 1):
+            raise RuntimeError("Unexpected GLM K1 graph draft output shape")
+        # A graph reuses output storage. Give callers an owned main-stream copy
+        # before any delayed draft D2H/next replay can consume or overwrite it.
+        return result.clone()
 
