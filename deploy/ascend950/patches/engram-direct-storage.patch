+            tensors.push_back(torch::from_blob(
+                ptr, {rows, engram_hidden}, [context = context](void*) {},
+                torch::TensorOptions().dtype(dtype).device(TORCH_DEVICE_NPU)));
+            ptr = math::advance_ptr<void>(ptr, static_cast<int64_t>(rows) * engram_hidden * engram_elem_size);
+        }
+        return tensors;
+    }
