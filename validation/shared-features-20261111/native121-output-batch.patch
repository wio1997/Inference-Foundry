+def _collect_step_outputs(pointers, output_type, active, completed_ids, stats):
+    """Consume an already completed native step, preserving per-request order.
+
+    Native output pointers remain borrowed only until the next engine step.
+    Keep the terminal pointer for its finish reason; never buffer across steps.
+    """
+    grouped = {}
+    stats['engine_steps'] += 1
+    for pointer in pointers:
+        pointer = int(pointer)
+        rid = output_type.get_request_id(pointer)
+        token = int(output_type.get_token_id(pointer))
+        if rid not in active or (rid in grouped and grouped[rid]['terminal'] is not None):
+            if token < 0 and (rid in completed_ids or rid in grouped):
+                continue
+            raise RuntimeError('output does not belong to an active HTTP request')
+        item = grouped.setdefault(rid, {'terminal': None, 'tokens': 0})
+        if token >= 0:
+            active[rid]['ids'].append(token)
+            item['tokens'] += 1
+            stats['token_pointers'] += 1
+        if output_type.get_finished(pointer):
+            item['terminal'] = pointer
+    for item in grouped.values():
+        stats['request_steps'] += 1
+        stats['multi_token_request_steps'] += int(item['tokens'] > 1)
+        stats['max_tokens_per_request_step'] = max(
+            stats['max_tokens_per_request_step'], item['tokens'])
+    return grouped
+
+
+def _step_text_delta(tokenizer, state, finished, stats):
+    """Decode once per request/step; incomplete UTF-8 stays until the next step."""
+    stats['decode_calls'] += 1
+    text = tokenizer.decode(state['ids'], skip_special_tokens=True)
+    if not finished and text.endswith('\ufffd'):
+        return ''
+    if not text.startswith(state['decoded']):
+        raise RuntimeError('unstable final prefix' if finished else 'tokenizer changed an emitted prefix')
+    delta = text[len(state['decoded']):]
+    state['decoded'] = text
+    return delta
+
