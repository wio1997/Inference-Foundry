diff --git a/DeepInfer/tests/test_glm_sdk_http_batch_output.py b/DeepInfer/tests/test_glm_sdk_http_batch_output.py
new file mode 100644
index 0000000..3a1ba4c
--- /dev/null
+++ b/DeepInfer/tests/test_glm_sdk_http_batch_output.py
@@ -0,0 +1,94 @@
+"""Transport contracts only; no model, torch, NPU or CPU model simulation."""
+import importlib.util
+from pathlib import Path
+import sys
+import unittest
+
+PATH = Path(__file__).resolve().parents[1] / 'deepinfer/model_executor/models/glm5_next/full_model/sdk_http.py'
+spec = importlib.util.spec_from_file_location('sdk_http_transport_only', PATH)
+http = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = http
+spec.loader.exec_module(http)
+
+
+def stats():
+    return dict(engine_steps=0, token_pointers=0, request_steps=0,
+                multi_token_request_steps=0, max_tokens_per_request_step=0,
+                decode_calls=0, text_events=0, terminal_events=0)
+
+
+def state():
+    return {'ids': [], 'decoded': ''}
+
+
+class Outputs:
+    def __init__(self, rows):
+        self.rows = rows
+
+    def get_request_id(self, pointer):
+        return self.rows[pointer][0]
+
+    def get_token_id(self, pointer):
+        return self.rows[pointer][1]
+
+    def get_finished(self, pointer):
+        return self.rows[pointer][2]
+
+
+class ByteTokenizer:
+    def decode(self, ids, skip_special_tokens):
+        assert skip_special_tokens
+        return bytes(ids).decode('utf-8', errors='replace')
+
+
+class BatchOutputContracts(unittest.TestCase):
+    def test_interleaved_requests_preserve_all_tokens_and_terminal(self):
+        rows = [('a', 65, False), ('b', 88, False), ('a', 66, False),
+                ('b', 89, True), ('a', 67, True), ('a', -1, True)]
+        active = {'a': state(), 'b': state()}; count = stats()
+        grouped = http._collect_step_outputs(range(len(rows)), Outputs(rows), active, set(), count)
+        self.assertEqual(active['a']['ids'], [65, 66, 67])
+        self.assertEqual(active['b']['ids'], [88, 89])
+        self.assertEqual(grouped['a']['terminal'], 4)
+        self.assertEqual(grouped['b']['terminal'], 3)
+        self.assertEqual(count['multi_token_request_steps'], 2)
+        self.assertEqual(count['token_pointers'], 5)
+        text = {rid: http._step_text_delta(ByteTokenizer(), active[rid], True, count) for rid in grouped}
+        self.assertEqual(text, {'a': 'ABC', 'b': 'XY'})
+        self.assertEqual(count['decode_calls'], 2)
+
+    def test_utf8_split_across_steps_and_final_flush(self):
+        s = state(); count = stats(); tokenizer = ByteTokenizer()
+        s['ids'] = [0xe4, 0xbd]
+        self.assertEqual(http._step_text_delta(tokenizer, s, False, count), '')
+        self.assertEqual(s['decoded'], '')
+        s['ids'].extend([0xa0, 0x21])
+        self.assertEqual(http._step_text_delta(tokenizer, s, False, count), '你!')
+        self.assertEqual(http._step_text_delta(tokenizer, s, True, count), '')
+        s['ids'].append(0xe4)
+        self.assertEqual(http._step_text_delta(tokenizer, s, True, count), '\ufffd')
+
+    def test_completed_sentinel_is_reaped_but_late_token_fails(self):
+        self.assertEqual(http._collect_step_outputs([0], Outputs([('done', -1, True)]), {}, {'done'}, stats()), {})
+        with self.assertRaises(RuntimeError):
+            http._collect_step_outputs([0], Outputs([('done', 65, True)]), {}, {'done'}, stats())
+        with self.assertRaises(RuntimeError):
+            http._collect_step_outputs([0, 1], Outputs([('a', 65, True), ('a', 66, False)]), {'a': state()}, set(), stats())
+
+    def test_empty_terminal_and_cross_step_continuation(self):
+        active = {'a': state()}; count = stats()
+        g = http._collect_step_outputs([0], Outputs([('a', 65, False)]), active, set(), count)
+        self.assertIsNone(g['a']['terminal'])
+        self.assertEqual(http._step_text_delta(ByteTokenizer(), active['a'], False, count), 'A')
+        g = http._collect_step_outputs([0], Outputs([('a', -1, True)]), active, set(), count)
+        self.assertEqual(g['a']['terminal'], 0)
+        self.assertEqual(http._step_text_delta(ByteTokenizer(), active['a'], True, count), '')
+
+    def test_already_emitted_prefix_may_not_change(self):
+        s = {'ids': [66], 'decoded': 'A'}
+        with self.assertRaises(RuntimeError):
+            http._step_text_delta(ByteTokenizer(), s, False, stats())
+
+
+if __name__ == '__main__':
+    unittest.main()
