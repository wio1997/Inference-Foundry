+++ b/DeepInfer/deepinfer/model_executor/models/glm5_next/full_model/native_terminal_prefill.py
@@ -0,0 +1,131 @@
+"""Keep a cached terminal-prefill batch free of a partial trailing request.
+
+The existing native scheduler still owns token budgets, physical allocations,
+metadata and request progress. A single-call fence uses its existing writable
+Sequence.schedulable binding. Only the rank-zero engine thread may call this
+adapter. No flag survives the C++ schedule call, including an exception.
+
+Eligibility is an advisory rank-zero cache lookup, never permission to skip a
+forward: NativePrefillState retains its full all-rank/state-ownership checks.
+"""
+from collections import Counter
+import threading
+import time
+
+
+class NativeTerminalPrefill:
+    def __init__(self, controller, memo):
+        if controller is None or memo is None:
+            raise ValueError('terminal-prefill batching needs driver controller and state owner')
+        self.controller = controller
+        self.memo = memo
+        self.owner_thread = threading.get_ident()
+        self.active = False
+        self.counts = Counter()
+        self.events = []
+
+    def _eligible_span(self, seq, waiting_status):
+        if (seq.status != waiting_status or not seq.schedulable
+                or seq.multi_modal_data is not None
+                or getattr(seq.sampling_params, 'so_args', None) is not None
+                or seq.branch_id.startswith('_')):
+            return None
+        registered = self.controller.requests.get(seq.request_id)
+        if registered is None or (registered.seq_id is not None and registered.seq_id != seq.seq_id):
+            return None
+        request = registered.request
+        prompt = request.prompt_token_ids
+        start, stop = int(seq.num_cached_tokens), len(prompt)
+        if (request.output_token_ids or seq.get_len() != stop or seq.get_prompt_len() != stop
+                or not 0 < start < stop
+                or any(start < int(pos) < stop for pos in seq.chunk_checkpoints)):
+            return None
+        entry = self.memo.entries.get(tuple(prompt))
+        if entry is None or start < entry['start']:
+            return None
+        return start, stop
+
+    def schedule(self, scheduler, metadata_pool, *, token_budget, cp_size, waiting_status):
+        if threading.get_ident() != self.owner_thread or self.active:
+            raise RuntimeError('terminal-prefill fence requires its sole engine-thread owner')
+        if (type(token_budget) is not int or token_budget != self.controller.max_batch_tokens
+                or token_budget < 1 or type(cp_size) is not int or cp_size < 1):
+            raise ValueError('native and compute token budgets and CP alignment must agree')
+        self.counts['schedule_calls'] += 1
+        if self.memo.closed or self.memo.descriptor is not None:
+            raise RuntimeError('terminal-prefill state owner is closed or executing')
+        # Match Scheduler::cp_align; this is the native scheduler CP group,
+        # not an independently selected SDK tensor-parallel group.
+        align = cp_size * 2 if cp_size > 1 else 1
+        selected = {}
+        padded_tokens = 0
+        fence = None
+        reason = None
+        for seq in scheduler.waiting:
+            if not seq.schedulable or seq.status != waiting_status:
+                # Never mask terminal cleanup or somebody else's readiness.
+                break
+            span = self._eligible_span(seq, waiting_status)
+            cost = ((span[1]-span[0]+align-1)//align*align) if span else 0
+            if span is None or padded_tokens + cost > token_budget:
+                if selected and seq.multi_modal_data is None and getattr(seq.sampling_params, 'so_args', None) is None:
+                    fence = seq
+                    reason = 'non_reusable_follower' if span is None else 'terminal_tail_exceeds_remaining_budget'
+                break
+            selected[seq.request_id] = span
+            padded_tokens += cost
+        if fence is None:
+            self.counts['ordinary_schedule_calls'] += 1
+            return scheduler.schedule(metadata_pool)
+
+        # Positive eligible prefix only: an oversized/cold head always runs
+        # ordinary scheduling. This prevents an empty-batch retry loop.
+        assert selected and fence.schedulable
+        started = time.monotonic_ns()
+        self.active = True
+        self.counts['fenced_calls'] += 1
+        self.counts[reason] += 1
+        try:
+            fence.schedulable = False
+            result = scheduler.schedule(metadata_pool)
+        except BaseException:
+            self.counts['schedule_failures'] += 1
+            raise
+        finally:
+            # The text-only rank-zero engine is the sole readiness writer.
+            # Do not hold the fence across model execution or async output.
+            fence.schedulable = True
+            self.active = False
+            self.counts['fences_restored'] += 1
+
+        metadata, outputs = result
+        actual_tokens = 0
+        if outputs.prompt_run:
+            for seq, meta in zip(outputs.scheduled_seqs, metadata, strict=True):
+                expected = selected.get(seq.request_id)
+                if (expected is None or meta.request_id != seq.request_id
+                        or int(meta.seqlen_q) != expected[1]-expected[0]
+                        or int(meta.seqlen_k) != expected[1]):
+                    self.counts['contract_failures'] += 1
+                    raise RuntimeError('native scheduler did not preserve the selected terminal spans')
+                actual_tokens += int(meta.seqlen_q)
+            self.counts['verified_terminal_batches'] += bool(metadata)
+            self.counts['verified_terminal_requests'] += len(metadata)
+            self.counts['verified_terminal_tokens'] += actual_tokens
+        else:
+            self.counts['native_decode_selected'] += 1
+        if len(self.events) < 128:
+            self.events.append({'started_monotonic_ns': started,
+                'returned_monotonic_ns': time.monotonic_ns(), 'reason': reason,
+                'planned_requests': len(selected), 'planned_padded_tokens': padded_tokens,
+                'scheduled_requests': len(metadata), 'scheduled_terminal_tokens': actual_tokens,
+                'prompt_run': bool(outputs.prompt_run)})
+        else:
+            self.counts['events_dropped'] += 1
+        return result
+
+    def snapshot(self):
+        return {'enabled': True, 'active_fence': self.active,
+                'counts': dict(self.counts), 'events': list(self.events),
+                'scope': 'one native schedule call;cached terminal queue prefix only;no state/progress mutation',
+                'NPU_validated': False}
