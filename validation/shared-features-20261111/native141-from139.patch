diff --git a/DeepInfer/tests/test_native_terminal_prefill.py b/DeepInfer/tests/test_native_terminal_prefill.py
new file mode 100644
index 0000000..8130cf0
--- /dev/null
+++ b/DeepInfer/tests/test_native_terminal_prefill.py
@@ -0,0 +1,177 @@
+"""Queue/ownership contracts only; no model execution or numerical simulation."""
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace as NS
+import threading
+import unittest
+
+SOURCE = Path(__file__).parents[1] / 'deepinfer/model_executor/models/glm5_next/full_model/native_terminal_prefill.py'
+spec = importlib.util.spec_from_file_location('terminal_prefill_under_test', SOURCE)
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+
+
+class Contracts(unittest.TestCase):
+    def make(self, n=8, *, start=640, length=1024, budget=1792):
+        seqs, registered, entries = [], {}, {}
+        for i in range(n):
+            rid = str(i)
+            prompt = [i] * length
+            seqs.append(NS(request_id=rid, seq_id=i, num_cached_tokens=start,
+                status='waiting', schedulable=True, multi_modal_data=None,
+                sampling_params=NS(so_args=None), branch_id='', chunk_checkpoints=[],
+                get_len=lambda: length, get_prompt_len=lambda: length))
+            registered[rid] = NS(seq_id=None, request=NS(prompt_token_ids=prompt, output_token_ids=[]))
+            entries[tuple(prompt)] = {'start': start}
+        memo = NS(entries=entries, closed=False, descriptor=None)
+        controller = NS(requests=registered, max_batch_tokens=budget)
+        policy = mod.NativeTerminalPrefill(controller, memo)
+        return policy, seqs
+
+    def result(self, seqs, *, q=384, stop=1024, prompt=True):
+        return ([NS(request_id=s.request_id, seqlen_q=q, seqlen_k=stop) for s in seqs],
+                NS(prompt_run=prompt, scheduled_seqs=seqs))
+
+    def run_policy(self, policy, seqs, call, *, cp=8, budget=1792):
+        return policy.schedule(NS(waiting=seqs, schedule=call), object(),
+            token_budget=budget, cp_size=cp, waiting_status='waiting')
+
+    def test_observed_1792_boundary_fences_fifth_and_restores_without_progress_change(self):
+        policy, seqs = self.make()
+        before = [s.num_cached_tokens for s in seqs]
+        expected = self.result(seqs[:4])
+        def native(_):
+            self.assertEqual([s.schedulable for s in seqs], [True]*4+[False]+[True]*3)
+            return expected
+        self.assertIs(self.run_policy(policy, seqs, native), expected)
+        self.assertTrue(all(s.schedulable for s in seqs))
+        self.assertEqual([s.num_cached_tokens for s in seqs], before)
+        self.assertEqual(policy.counts['verified_terminal_tokens'], 1536)
+        self.assertFalse(policy.active)
+
+    def test_cold_head_and_oversized_head_never_fence(self):
+        for case in ('cold', 'oversized'):
+            with self.subTest(case=case):
+                p, seqs = self.make()
+                if case == 'cold':
+                    p.memo.entries.clear()
+                else:
+                    p.controller.max_batch_tokens = 256
+                def native(_):
+                    self.assertTrue(all(s.schedulable for s in seqs))
+                    return 'ordinary'
+                self.assertEqual(self.run_policy(p, seqs, native, budget=p.controller.max_batch_tokens), 'ordinary')
+                self.assertEqual(p.counts['fenced_calls'], 0)
+
+    def test_cold_follower_does_not_poison_eligible_prefix(self):
+        p, seqs = self.make(3)
+        p.memo.entries.pop(tuple(p.controller.requests['1'].request.prompt_token_ids))
+        def native(_):
+            self.assertEqual([s.schedulable for s in seqs], [True,False,True])
+            return self.result(seqs[:1])
+        self.run_policy(p, seqs, native)
+        self.assertEqual(p.counts['non_reusable_follower'], 1)
+        self.assertTrue(all(s.schedulable for s in seqs))
+
+    def test_exception_restores_readiness_and_next_call_can_run(self):
+        p, seqs = self.make()
+        def failed(_):
+            self.assertFalse(seqs[4].schedulable)
+            raise RuntimeError('native allocation failed')
+        with self.assertRaisesRegex(RuntimeError, 'allocation failed'):
+            self.run_policy(p, seqs, failed)
+        self.assertTrue(seqs[4].schedulable)
+        self.assertFalse(p.active)
+        self.run_policy(p, seqs, lambda _: self.result(seqs[:4]))
+        self.assertEqual(p.counts['fences_restored'], 2)
+
+    def test_partial_native_result_fails_before_model_and_after_restoring_fence(self):
+        p, seqs = self.make()
+        with self.assertRaisesRegex(RuntimeError, 'preserve the selected terminal spans'):
+            self.run_policy(p, seqs, lambda _: self.result(seqs[:4], q=256, stop=896))
+        self.assertTrue(all(s.schedulable for s in seqs))
+        self.assertFalse(p.active)
+
+    def test_decode_selection_keeps_native_step_choice(self):
+        p, seqs = self.make()
+        expected = self.result(seqs[:2], q=6, stop=1100, prompt=False)
+        self.assertIs(self.run_policy(p, seqs, lambda _: expected), expected)
+        self.assertEqual(p.counts['native_decode_selected'], 1)
+        self.assertEqual(p.counts['verified_terminal_batches'], 0)
+
+    def test_cp_padding_budget_is_used(self):
+        p, seqs = self.make(3, start=640, length=1025, budget=768)
+        def native(_):
+            self.assertEqual([s.schedulable for s in seqs], [True,False,True])
+            return self.result(seqs[:1], q=385, stop=1025)
+        self.run_policy(p, seqs, native, budget=768)
+        self.assertEqual(p.events[0]['planned_padded_tokens'], 400)
+
+    def test_nonterminal_checkpoint_or_missing_coverage_cannot_be_advertised(self):
+        for case in ('checkpoint', 'missing_coverage', 'already_decoding', 'wrong_sequence'):
+            with self.subTest(case=case):
+                p, seqs = self.make()
+                registered = p.controller.requests['0']
+                if case == 'checkpoint':
+                    seqs[0].chunk_checkpoints = [896]
+                elif case == 'missing_coverage':
+                    p.memo.entries[tuple(registered.request.prompt_token_ids)]['start'] = 896
+                elif case == 'already_decoding':
+                    registered.request.output_token_ids = [10]
+                else:
+                    registered.seq_id = 999
+                self.assertEqual(self.run_policy(p, seqs, lambda _: 'ordinary'), 'ordinary')
+                self.assertEqual(p.counts['fenced_calls'], 0)
+
+    def test_terminal_cleanup_and_external_not_ready_flag_are_untouched(self):
+        for case in ('aborted', 'not_ready'):
+            with self.subTest(case=case):
+                p, seqs = self.make()
+                if case == 'aborted':
+                    seqs[1].status = 'aborted'
+                else:
+                    seqs[1].schedulable = False
+                before = [(s.status,s.schedulable) for s in seqs]
+                self.assertEqual(self.run_policy(p, seqs, lambda _: 'cleanup'), 'cleanup')
+                self.assertEqual([(s.status,s.schedulable) for s in seqs], before)
+                self.assertEqual(p.counts['fenced_calls'], 0)
+
+    def test_multimodal_or_structured_readiness_writer_is_never_fenced(self):
+        for case in ('multimodal','structured'):
+            with self.subTest(case=case):
+                p, seqs = self.make()
+                if case == 'multimodal':
+                    seqs[1].multi_modal_data = object()
+                else:
+                    seqs[1].sampling_params.so_args = object()
+                self.assertEqual(self.run_policy(p, seqs, lambda _: 'ordinary'), 'ordinary')
+                self.assertEqual(p.counts['fenced_calls'], 0)
+
+    def test_thread_ownership_reentry_and_closed_owner_fail(self):
+        p, seqs = self.make()
+        errors = []
+        def other_thread():
+            try:
+                self.run_policy(p, seqs, lambda _: self.fail('must not schedule'))
+            except RuntimeError as error:
+                errors.append(str(error))
+        thread = threading.Thread(target=other_thread)
+        thread.start(); thread.join()
+        self.assertEqual(len(errors), 1)
+        p.active = True
+        with self.assertRaisesRegex(RuntimeError, 'sole engine-thread owner'):
+            self.run_policy(p, seqs, lambda _: None)
+        p.active = False
+        p.memo.closed = True
+        with self.assertRaisesRegex(RuntimeError, 'closed or executing'):
+            self.run_policy(p, seqs, lambda _: None)
+        self.assertTrue(all(s.schedulable for s in seqs))
+
+    def test_mismatched_budget_fails_without_native_call(self):
+        p, seqs = self.make()
+        with self.assertRaisesRegex(ValueError, 'budgets and CP alignment'):
+            self.run_policy(p, seqs, lambda _: self.fail('must not schedule'), budget=1536)
+
+
+if __name__ == '__main__':
+    unittest.main()
