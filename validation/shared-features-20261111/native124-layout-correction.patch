diff --git a/DeepInfer/tests/ascend/test_native_mtp_metadata_plan.py b/DeepInfer/tests/ascend/test_native_mtp_metadata_plan.py
new file mode 100644
index 0000000..1e31421
--- /dev/null
+++ b/DeepInfer/tests/ascend/test_native_mtp_metadata_plan.py
@@ -0,0 +1,62 @@
+"""Host-only metadata contract checks; no client-side model or NPU simulation."""
+import importlib.util
+from pathlib import Path
+import unittest
+from dataclasses import dataclass
+
+P = Path(__file__).resolve().parents[2] / 'deepinfer/model_executor/models/glm5_next/full_model/native_mtp_metadata_plan.py'
+spec = importlib.util.spec_from_file_location('metadata_plan', P)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+class AdmissionTests(unittest.TestCase):
+    def base(self, **changes):
+        v=dict(prefill_requests=0, decode_requests=4, request_ids=('a','b','c','d'),
+               previous_request_ids=('a','b','c','d'), draft_width=5, uniform=True)
+        v.update(changes)
+        return module.stable_decode_scope(**v)
+
+    def test_unchanged_decode_admitted(self):
+        self.assertTrue(self.base())
+
+    def test_equal_batch_size_does_not_allow_replacement_or_reordering(self):
+        for ids in [('x','b','c','d'), ('b','a','c','d')]:
+            with self.subTest(ids=ids): self.assertFalse(self.base(request_ids=ids))
+
