+"""Host checks of integer ownership and capture contracts; no model execution."""
+import ast
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+PATH = ROOT / 'deepinfer/model_executor/models/glm5_next/full_model/native_mtp_compact_tail.py'
+spec = importlib.util.spec_from_file_location('native_mtp_compact_tail', PATH)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+class IntBuffer:
+    """A shared integer-storage view, sufficient for metadata ownership tests."""
+    def __init__(self, data, start=0, stop=None):
+        self.data, self.start = data, start
+        self.stop = len(data) if stop is None else stop
+
+    def __len__(self):
+        return self.stop - self.start
+
+    def __getitem__(self, item):
+        if isinstance(item, slice):
+            start, stop, step = item.indices(len(self))
+            assert step == 1
+            return IntBuffer(self.data, self.start + start, self.start + stop)
+        return self.data[self.start + item]
+
+    def values(self):
+        return self.data[self.start:self.stop]
+
+    def copy_(self, other):
+        values = other.values()
+        assert len(values) == len(self)
+        self.data[self.start:self.stop] = values
+        return self
+
+    def fill_(self, value):
+        self.data[self.start:self.stop] = [value] * len(self)
+        return self
+
+    def zero_(self):
+        return self.fill_(0)
+
+    def new_tensor(self, values):
+        return IntBuffer(list(values))
+
+
+def capture_fixture(rows, requests):
+    def adjust(tensor, width):
+        values = tensor.values()
+        return IntBuffer((values + [0] * width)[:width])
+    d = SimpleNamespace(
+        arange=IntBuffer(list(range(64))), _adjust_tensor=adjust,
+        query_start_loc_group=[IntBuffer([-9] * 65) for _ in range(5)],
+        seq_lens_group=[IntBuffer([17] * requests + [0] * (64 - requests)) for _ in range(5)],
+        slot_mapping_group=[IntBuffer(list(range(64))) for _ in range(5)],
+    )
+    m = SimpleNamespace(num_input_tokens=rows, num_reqs=requests,
+        num_actual_tokens=rows, max_query_len=6, decode_token_per_req=6,
+        query_start_loc=IntBuffer(list(range(0, rows + 1, 6))),
+        query_start_loc_cpu=IntBuffer(list(range(0, rows + 1, 6))),
+        seq_lens=IntBuffer([17] * requests), block_table_tensor=IntBuffer(list(range(requests))),
+        positions=IntBuffer(list(range(rows))), slot_mapping=IntBuffer(list(range(rows))),
+        seq_lens_cpu=IntBuffer([17] * requests), _seq_lens_cpu=None,
+        is_prefilling=IntBuffer([0] * requests))
+    return d, m
+
+
+class CompactTailContractTests(unittest.TestCase):
+    def test_full_buckets_and_fallback(self):
+        for rows, max_requests in [(24, 4), (48, 8)]:
+            for requests in range(1, max_requests + 1):
+                self.assertEqual(module.tail_width(rows, requests, True), 8)
+                self.assertEqual(module.tail_width(rows, requests, False), rows)
+        self.assertEqual(module.tail_width(96, 8, True), 96)
+        with self.assertRaises(ValueError):
+            module.tail_width(24, 8, True)
+
+    def test_first_pass_unchanged_and_capture_tails_independent(self):
+        d, first = capture_fixture(24, 4)
+        self.assertIs(module.compact_capture_view(d, first, 0), first)
+        views = [module.compact_capture_view(d, first, i) for i in range(1, 5)]
+        self.assertEqual((first.num_input_tokens, first.num_reqs, first.max_query_len), (24, 4, 6))
+        self.assertEqual(first.query_start_loc.values(), [0, 6, 12, 18, 24])
+        for v in views:
+            self.assertEqual((v.num_input_tokens, v.num_reqs, v.num_actual_tokens), (8, 8, 4))
+            self.assertEqual(v.query_start_loc.values(), list(range(9)))
+            self.assertEqual(v.seq_lens.values(), [17] * 4 + [0] * 4)
+            self.assertEqual(v.block_table_tensor.values(), [0, 1, 2, 3, 0, 0, 0, 0])
+            self.assertEqual(v.slot_mapping.values()[4:], [-1] * 60)
+        views[0].query_start_loc.fill_(77)
+        views[0].seq_lens.fill_(99)
+        self.assertEqual(views[1].query_start_loc.values(), list(range(9)))
+        self.assertEqual(views[1].seq_lens.values(), [17] * 4 + [0] * 4)
+        self.assertEqual(first.seq_lens.values(), [17] * 4)
+
+    def test_c8_capture_has_one_query_per_rank(self):
+        d, first = capture_fixture(48, 8)
+        tail = module.compact_capture_view(d, first, 1)
+        self.assertEqual(tail.num_actual_tokens, 8)
+        self.assertEqual(tail.query_start_loc.values(), list(range(9)))
+        self.assertEqual(tail.slot_mapping.values()[:8], list(range(8)))
+
+    def test_shared_topk_source_and_destination_ownership(self):
+        # Each selected row may live on any first-pass rank. After compaction,
+        # request i must live on rank i, not on the old 3/6-rows-per-rank owner.
+        for first_rows, maximum in [(24, 4), (48, 8)]:
+            for requests in range(1, maximum + 1):
+                selected = [6 * i + (i % 6) for i in range(requests)]
+                reduced = [0] * requests
+                owners = [0] * requests
+                for rank in range(8):
+                    start, count, _, _ = module.topk_row_layout(first_rows, 8, requests, rank)
+                    for i, source_row in enumerate(selected):
+                        if start <= source_row < start + count:
+                            reduced[i] += source_row + 100
+                            owners[i] += 1
+                self.assertEqual(owners, [1] * requests)
+                received = {}
+                for rank in range(8):
+                    _, _, start, count = module.topk_row_layout(first_rows, 8, requests, rank)
+                    if count:
+                        received[rank] = reduced[start:start + count]
+                self.assertEqual(received, {i: [row + 100] for i, row in enumerate(selected)})
+
+    def test_specialization_has_only_three_expected_edits(self):
+        source = '''def _run_merged_draft(self, num_input_tokens, batch_size):
+    first = self.model(num_input_tokens)
+    compact_mtp_topk_indices(first, indices, num_input_tokens)
+    input_batch_size = num_input_tokens if (self.method == "mtp" or self.use_cuda_graph) else batch_size
+    forward_context = get_forward_context()
+    _EXTRA_CTX.num_tokens = input_batch_size
+    _EXTRA_CTX.num_accept_tokens = batch_size
+    return self.model(input_batch_size)
+'''
+        tree = module.specialize_merged_draft(source)
+        rendered = ast.unparse(tree)
+        self.assertIn('_native_tail.model_width(num_input_tokens, batch_size)', rendered)
+        self.assertIn('_native_tail.compact_topk_indices', rendered)
+        self.assertIn('_native_tail.enter_tail', rendered)
+        self.assertEqual(rendered.count('self.model('), 2)
+        with self.assertRaises(ValueError):
+            module.specialize_merged_draft(source.replace('else batch_size', 'else num_input_tokens'))
+        with self.assertRaises(ValueError):
+            module.specialize_merged_draft(source.replace('compact_mtp_topk_indices', 'new_sdk_topk'))
+
+    def test_install_precedes_capture_and_closes_before_observer(self):
+        src = (PATH.parent / 'sdk_runtime.py').read_text()
+        self.assertLess(src.index('worker.initialize_from_config(physical)'), src.index('compact_tail = NativeMTPCompactTail'))
+        self.assertLess(src.index('compact_tail = NativeMTPCompactTail'), src.index('worker.compile_or_warm_up_model()'))
+        self.assertLess(src.index('self.native_compact_mtp_tail.close()'), src.index('self.kda_capture.close()'))
+
+
+if __name__ == '__main__':
+    unittest.main()
