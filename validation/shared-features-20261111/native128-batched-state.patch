 class Contracts(unittest.TestCase):
+    def test_batched_descriptors_preserve_exact_byte_extents_and_tails(self):
+        rows = [(4096, 1000000, 65537), (80000, 2000000, 17)]
+        plan = M.plan_byte_copies(rows, 3)
+        self.assertEqual(plan, ((4096, 1000000, 65536), (69632, 1065536, 1),
+                                (80000, 2000000, 17)))
+        self.assertEqual(sum(n for _s, _d, n in plan), sum(n for _s, _d, n in rows))
+        for s, d, n in plan:
+            self.assertTrue(any(a <= s < s+n <= a+length and b <= d < d+n <= b+length
+                                and s-a == d-b for a, b, length in rows))
+
+    def test_batched_copy_rejects_cross_region_alias_and_overflow(self):
+        for rows, capacity in [([(1000, 2000, 32), (1100, 2010, 16)], 4),
+                               ([(1000, 2000, 128), (3000, 1100, 32)], 4),
+                               ([(1000, 1000, 32)], 4),
+                               ([(1000, 1000000, 65537)], 1),
+                               ([(1000, 2**63-1, 2)], 4), ([], 4)]:
+            with self.subTest(rows=rows), self.assertRaises(ValueError):
+                M.plan_byte_copies(rows, capacity)
+
+    def test_pending_raw_storage_survives_wait_failure(self):
+        memo = M.NativePrefillState.__new__(M.NativePrefillState)
+        memo.counts = Counter()
+        storage = object()
+        def wait():
+            self.assertIs(memo.pending_copy_buffers[0][1], storage)
+            raise RuntimeError('device wait failed')
+        pending = [(NS(query=lambda: False, synchronize=wait), storage)]
+        pending += [(NS(query=lambda: False), object()) for _ in range(M.MAX_PENDING_COPY_HOST_BUFFERS-1)]
+        memo.pending_copy_buffers = pending.copy()
+        with self.assertRaisesRegex(RuntimeError, 'device wait failed'):
+            memo._retire_copy_buffers()
+        self.assertEqual(memo.pending_copy_buffers, pending)
+        self.assertEqual(memo.counts['copy_host_backpressure_waits'], 1)
+
+    def test_retire_only_completed_or_successfully_waited_buffers(self):
+        memo = M.NativePrefillState.__new__(M.NativePrefillState)
+        memo.counts = Counter()
+        pending = [(NS(query=lambda: False, synchronize=lambda: None), object())
+                   for _ in range(M.MAX_PENDING_COPY_HOST_BUFFERS)]
+        memo.pending_copy_buffers = [(NS(query=lambda: True), object())] + pending
+        memo._retire_copy_buffers()
+        self.assertEqual(memo.pending_copy_buffers, pending[1:])
+
+    def test_repeated_close_preserves_device_timing_receipt(self):
+        memo = M.NativePrefillState.__new__(M.NativePrefillState)
+        memo.closed = True
+        memo.copy_timings_ms = [{'example': 'already collected'}]
+        memo.close()
+        self.assertEqual(memo.copy_timings_ms, [{'example': 'already collected'}])
