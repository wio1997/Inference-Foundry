@@ -0,0 +1,558 @@
+"""Instance-local target-prefill memoization with real hybrid-state writeback.
+
+Only a whole, eager, final-prefill batch can skip target forward. The SDK still
+prepares every input and cache allocation, computes logits, samples, runs MTP,
+and accounts for the real positive input span. Entries contain target state and
+hidden activations, never sampled tokens or responses. The arena is deducted
+from the configured cache budget before the ordinary pool is allocated.
+"""
+from collections import Counter, OrderedDict
+from dataclasses import dataclass
+import hashlib
+import importlib
+import json
+from pathlib import Path
+import re
+import time
+from types import MethodType
+
+
+PINS = {
+    'vllm.v1.worker.mamba_utils': '23fdaa4e8f63ee8f938eaa1a2b39f803cb04fa6ecd69789563254b1a0691413a',
+    'vllm_ascend.worker.model_runner_v1': '568c3049205b9caff5c656a7f5dd4c6e79fb358abe526f89fb9fb3f70a60a43c',
+    'vllm_ascend.models.glm5next.model': '2a9381fa5897578bf4922b4b2bef99635dbc58236cd0f31fe5f93664b7252bbe',
+    'vllm_ascend.models.glm5next.kda': 'b2e0dca0ed6f9b686e9e3e4a73ba2a610860d62ece1be271a14627c6cb4a9924',
+    'vllm_ascend.models.glm5next.cache_config': '00559085edd75a1719254b3f52dedbcd4fb0ce93c511b17c06ab3d975ed2e1e4',
+    'vllm_ascend.models.glm5next.cache_views': 'd95fe2831045f102435db21bf2760d6716ecf48906b8e2ae459de8fe9af3ef6c',
+    'vllm_ascend.models.glm5next.kv_cache': '6d790b58a9ebbaf3b8f89146418e1de22053478459fc13703a2058a84c929e58',
+}
+
+# One fixed launch plan, not a shape/tile sweep. Split large byte ranges because
+# the existing SDK helper assigns a sequential byte-copy loop to each program.
+COPY_SEGMENT_BYTES = 64 * 1024
+MAX_PENDING_COPY_HOST_BUFFERS = 4
+
+
+def plan_byte_copies(rows, capacity):
+    """Validate disjoint byte ranges and split them for the fixed SDK helper.
+
+    The helper uses raw addresses, so it does not retain Tensor storage or make
+    cross-program overlap safe. Callers own both lifetimes and stream ordering.
+    """
+    rows = tuple(rows)
+    if not rows or capacity <= 0:
+        raise ValueError('empty copy plan or nonpositive descriptor capacity')
+    if any(len(row) != 3 or not all(isinstance(x, int) and 0 < x < 2**63 for x in row)
+           for row in rows):
+        raise ValueError('copy addresses and lengths must be positive integers')
+    if any(max(s, d) + n >= 2**63 for s, d, n in rows):
+        raise ValueError('copy address range exceeds signed descriptor width')
+    sources = sorted((s, s + n) for s, _d, n in rows)
+    destinations = sorted((d, d + n) for _s, d, n in rows)
+    if any(b > c for (_a, b), (c, _d) in zip(destinations, destinations[1:])):
+        raise ValueError('copy destinations overlap')
+    i = j = 0
+    while i < len(sources) and j < len(destinations):
+        a, b = sources[i]
+        c, d = destinations[j]
+        if a < d and c < b:
+            raise ValueError('copy source overlaps a destination')
+        if b <= c:
+            i += 1
+        else:
+            j += 1
+    count = sum((n + COPY_SEGMENT_BYTES - 1) // COPY_SEGMENT_BYTES for _s, _d, n in rows)
+    if count > capacity:
+        raise ValueError('copy descriptor capacity exceeded')
+    return tuple((s + offset, d + offset, min(COPY_SEGMENT_BYTES, n - offset))
+                 for s, d, n in rows for offset in range(0, n, COPY_SEGMENT_BYTES))
+
+
+def align_bytes(n):
+    return (n + 511) // 512 * 512
+
+
+def written_columns(role, start, stop, block_size):
+    """Logical columns actually written by target prefill, not draft lookahead."""
+    if not (0 <= start < stop and block_size > 0):
+        raise ValueError('invalid positive prefill span')
+    if role == 'tail':
+        return (0,)
+    if role == 'mamba':
+        return ((stop - 1) // block_size,)
+    if role == 'attention':
+        return tuple(range(start // block_size, (stop - 1) // block_size + 1))
+    raise ValueError('unsupported cache role')
+
+
+def reusable_suffix_start(start, stop, block_size):
+    """Retain only the last nonterminal page and available hidden rows."""
+    written_columns('attention', start, stop, block_size)
+    return max(start, (stop - 1) // block_size * block_size)
+
+
+class ByteArena:
+    """Host allocation ledger; no model arithmetic or hidden device allocations."""
+    def __init__(self, capacity):
+        if capacity < 512 or capacity % 512:
+            raise ValueError('arena capacity must be 512-byte aligned')
+        self.capacity = capacity
+        self.free = [(0, capacity)]
+        self.live = {}
+
+    def allocate(self, owner, size):
+        size = align_bytes(size)
+        if owner in self.live or size <= 0:
+            raise ValueError('duplicate owner or empty allocation')
+        for i, (offset, length) in enumerate(self.free):
+            if length >= size:
+                self.free[i:i + 1] = ([(offset + size, length - size)] if length > size else [])
+                self.live[owner] = (offset, size)
+                return offset
+        return None
+
+    def release(self, owner):
+        self.free.append(self.live.pop(owner))
+        merged = []
+        for offset, length in sorted(self.free):
+            if merged and merged[-1][0] + merged[-1][1] == offset:
+                a, n = merged[-1]
+                merged[-1] = (a, n + length)
+            else:
+                merged.append((offset, length))
+        self.free = merged
+
+
+@dataclass
+class Layer:
+    name: str
+    gid: int
+    role: str
+    block_size: int
+    raw_pages: object
+    views: tuple
+
+
+class NativePrefillState:
+    def __init__(self, runner, *, reserve_bytes, total_cache_bytes, native_group):
+        import torch
+        for name, digest in PINS.items():
+            module = importlib.import_module(name)
+            if hashlib.sha256(Path(module.__file__).read_bytes()).hexdigest() != digest:
+                raise ValueError('prefill state source contract differs: ' + name)
+        config = runner.vllm_config
+        if (config.parallel_config.pipeline_parallel_size != 1
+                or config.parallel_config.data_parallel_size != 1
+                or config.parallel_config.tensor_parallel_size != 8
+                or config.num_speculative_tokens != 5
+                or config.model_config.dtype != torch.bfloat16
+                or config.kv_transfer_config is not None
+                or runner.use_aux_hidden_state_outputs
+                or runner.dynamic_eplb
+                or getattr(runner.kvpp, 'scheduler', None) is not None
+                or getattr(runner, 'sparse_kv_offload_enabled', False)
+                or config.cache_config.mamba_cache_mode != 'align'):
+            raise ValueError('unsupported target-prefill state configuration')
+        self.torch, self.runner, self.group = torch, runner, native_group
+        self.reserve_bytes, self.total_cache_bytes = reserve_bytes, total_cache_bytes
+        self.ledger = ByteArena(reserve_bytes)
+        self.arena = torch.empty(reserve_bytes, dtype=torch.uint8, device=runner.device)
+        self.entries = OrderedDict()
+        self.counts = Counter()
+        self.events = []
+        self.layers = []
+        self.descriptor = None
+        self.owner_cache = None
+        self.stats_path = None
+        self.closed = False
+        self.last_use = None
+        self.original_reshape = runner._reshape_kv_cache_tensors
+        self.original_forward = runner._model_forward
+        self.batch_memcpy = importlib.import_module('vllm.v1.worker.mamba_utils').batch_memcpy
+        self.pending_copy_buffers = []
+        self.copy_events = []
+        self.copy_timings_ms = []
+        self.raw, self.views = None, None
+        owner = self
+
+        def reshape(_runner, cache_config, raw, *args, **kwargs):
+            views = owner.original_reshape(cache_config, raw, *args, **kwargs)
+            if owner.raw is not None:
+                raise RuntimeError('cache pool was initialized twice')
+            owner.raw, owner.views = raw, views
+            return views
+
+        runner._reshape_kv_cache_tensors = MethodType(reshape, runner)
+
+    def attach(self, cache_manager):
+        from vllm.v1.kv_cache_interface import MambaSpec
+        from vllm_ascend.core.kv_cache_interface import AscendIndexerKPoolTailSpec
+        r, torch = self.runner, self.torch
+        if self.raw is None or self.views is None:
+            raise RuntimeError('fixed SDK did not expose its actual cache allocation')
+        raw_payloads = {}
+        raw_storages = {}
+        for value in self.raw.values():
+            parts = value if isinstance(value, tuple) else (value,)
+            for part in parts:
+                raw_payloads[(part.data_ptr(), part.numel(), part.element_size())] = part.numel() * part.element_size()
+                storage = part.untyped_storage()
+                raw_storages[storage.data_ptr()] = storage.nbytes()
+        self.physical_pool_payload_bytes = sum(raw_payloads.values())
+        self.physical_pool_storage_bytes = sum(raw_storages.values())
+        if self.physical_pool_payload_bytes + self.reserve_bytes > self.total_cache_bytes:
+            raise ValueError('actual pooled payload plus memo arena exceeds total cache budget')
+        specs = r._get_layer_kv_cache_specs(r.kv_cache_config)
+        n_layers = r.model_config.hf_text_config.num_hidden_layers
+        if n_layers != 45:
+            raise ValueError('unexpected target layer count')
+        roles = Counter()
+        for gid, group in enumerate(r.kv_cache_config.kv_cache_groups):
+            for name in group.layer_names:
+                match = re.search(r'\.layers\.(\d+)\.', name)
+                if match is None:
+                    raise ValueError('unclassified cache layer: ' + name)
+                if int(match[1]) >= n_layers:
+                    continue  # Draft caches remain owned and updated by the SDK.
+                spec = specs[name]
+                if isinstance(spec, MambaSpec):
+                    role = 'mamba'
+                elif isinstance(spec, AscendIndexerKPoolTailSpec):
+                    role = 'tail'
+                elif getattr(spec, 'model_version', None) == 'glm5_next':
+                    role = 'attention'
+                else:
+                    raise ValueError('unclassified target cache spec: ' + name)
+                raw = self.raw[name]
+                if (not isinstance(raw, torch.Tensor) or not raw.is_contiguous()
+                        or raw.element_size() != 1
+                        or raw.numel() != r.kv_cache_config.num_blocks * spec.page_size_bytes):
+                    raise ValueError('noncanonical target cache backing: ' + name)
+                views = self.views[name]
+                if not isinstance(views, (list, tuple)):
+                    views = (views,)
+                if role == 'mamba' and (len(views) != 2 or any(
+                        t.shape[0] != r.kv_cache_config.num_blocks for t in views)):
+                    raise ValueError('KDA state must expose conv and recurrent slots')
+                self.layers.append(Layer(name, gid, role, spec.block_size,
+                    raw.view(torch.uint8).view(r.kv_cache_config.num_blocks, spec.page_size_bytes),
+                    tuple(views)))
+                roles[role] += 1
+        if roles != {'mamba': 34, 'attention': 22, 'tail': 11}:
+            raise ValueError('incomplete target-state coverage: ' + repr(roles))
+        self.layers.sort(key=lambda x: x.name)
+        block_sizes = {x.block_size for x in self.layers if x.role != 'tail'}
+        if len(block_sizes) != 1:
+            raise ValueError('target state groups require one shared token alignment')
+        self.block_size = block_sizes.pop()
+        self.state_bytes_per_entry = sum(
+            sum(t[0].numel() * t.element_size() for t in x.views)
+            if x.role == 'mamba' else int(x.raw_pages.shape[1])
+            for x in self.layers)
+        state_sizes = []
+        for layer in self.layers:
+            state_sizes.extend([t[0].numel() * t.element_size() for t in layer.views]
+                               if layer.role == 'mamba' else [int(layer.raw_pages.shape[1])])
+        hidden_size = self.block_size * r.model_config.hf_text_config.hidden_size * 2
+        self.copy_descriptor_capacity = sum(
+            (n + COPY_SEGMENT_BYTES - 1) // COPY_SEGMENT_BYTES for n in state_sizes + [hidden_size])
+        self.copy_metadata_bytes = align_bytes(3 * 8 * self.copy_descriptor_capacity)
+        self.copy_metadata_offset = self.ledger.allocate('_copy_metadata', self.copy_metadata_bytes)
+        if self.copy_metadata_offset is None:
+            raise ValueError('memo arena cannot hold copy metadata within its budget')
+        self.owner_cache = cache_manager
+        self.runner._reshape_kv_cache_tensors = self.original_reshape
+        owner = self
+
+        def forward(_runner, *args, **kwargs):
+            return owner.forward(*args, **kwargs)
+
+        self.runner._model_forward = MethodType(forward, self.runner)
+        self.layout = [(x.name, x.gid, x.role, x.block_size,
+                        int(x.raw_pages.shape[1]),
+                        [(tuple(t.shape[1:]), str(t.dtype)) for t in x.views] if x.role == 'mamba' else [])
+                       for x in self.layers]
+
+    def begin(self, descriptor):
+        if self.descriptor is not None or self.closed:
+            raise RuntimeError('prefill memo execution overlap or use after close')
+        self.descriptor = descriptor
+
+    def end(self):
+        self.descriptor = None
+
+    def _records(self):
+        r, d = self.runner, self.descriptor
+        if d is None or not d.total_num_scheduled_tokens or d.scheduled_spec_decode_tokens:
+            return None
+        from vllm.forward_context import get_forward_context
+        from vllm.config.compilation import CUDAGraphMode
+        if get_forward_context().cudagraph_runtime_mode != CUDAGraphMode.NONE:
+            return None
+        records, offset = [], 0
+        for rid in r.input_batch.req_ids:
+            state = r.requests[rid]
+            q = d.num_scheduled_tokens[rid]
+            start = int(state.num_computed_tokens)
+            stop = start + q
+            prompt = state.prompt_token_ids
+            if start >= len(prompt) or stop > len(prompt) or state.output_token_ids:
+                return None
+            key = tuple(prompt) if stop == len(prompt) else None
+            records.append((rid, start, stop, offset, key))
+            offset += q
+        if offset != d.total_num_scheduled_tokens:
+            raise RuntimeError('SDK input row order disagrees with scheduled spans')
+        return records
+
+    def _segments(self, record):
+        rid, start, stop, _offset, _key = record
+        state = self.runner.requests[rid]
+        tensors, addresses = [], []
+        for layer in self.layers:
+            for column in written_columns(layer.role, start, stop, layer.block_size):
+                blocks = state.block_ids[layer.gid]
+                if not 0 <= column < len(blocks):
+                    raise ValueError('missing request cache column')
+                block_id = blocks[column]
+                if not 0 <= block_id < layer.raw_pages.shape[0]:
+                    raise ValueError('cache slot out of bounds')
+                if layer.role == 'mamba' and self.runner.mamba_state_idx[rid] != column:
+                    raise ValueError('running KDA state column differs from fixed SDK contract')
+                if self.owner_cache is not None:
+                    manager = self.owner_cache.coordinator.single_type_managers[layer.gid]
+                    block = manager.req_to_blocks[rid][column]
+                    if block.block_id != block_id or block.is_null or block.ref_cnt != 1:
+                        raise ValueError('state writeback requires request-private live slots')
+                parts = ([t[block_id] for t in layer.views] if layer.role == 'mamba'
+                         else [layer.raw_pages[block_id]])
+                for part in parts:
+                    if not part.is_contiguous():
+                        raise ValueError('individual state row must be contiguous')
+                    tensors.append(part)
+                addresses.append((layer.gid, column, block_id))
+        return tensors, addresses
+
+    @staticmethod
+    def _signature(tensors):
+        return tuple((tuple(t.shape), str(t.dtype)) for t in tensors)
+
+    def _view(self, offset, tensor):
+        size = tensor.numel() * tensor.element_size()
+        return self.arena.narrow(0, offset, size).view(tensor.dtype).view(tensor.shape)
+
+    def _consensus(self, payload):
+        import torch.distributed as dist
+        # Every rank must make the same skip/execute decision before collectives.
+        found = [None] * dist.get_world_size(self.group)
+        dist.all_gather_object(found, payload, group=dist.group.WORLD)
+        if any(value != found[0] for value in found) or payload.get('error'):
+            raise RuntimeError('target-prefill state ownership/decision disagrees across ranks: ' + repr(found))
+
+    def _retire_copy_buffers(self):
+        self.pending_copy_buffers = [item for item in self.pending_copy_buffers if not item[0].query()]
+        if len(self.pending_copy_buffers) >= MAX_PENDING_COPY_HOST_BUFFERS:
+            self.counts['copy_host_backpressure_waits'] += 1
+            # Keep storage owned even if waiting raises. Popping first would
+            # release raw-pointer storage before completion on the error path.
+            self.pending_copy_buffers[0][0].synchronize()
+            del self.pending_copy_buffers[0]
+
+    def _copy_parts(self, sources, destinations, stream, operation):
+        torch = self.torch
+        rows = []
+        for source, destination in zip(sources, destinations, strict=True):
+            if (not source.is_contiguous() or not destination.is_contiguous()
+                    or source.shape != destination.shape or source.dtype != destination.dtype
+                    or source.device != destination.device):
+                raise ValueError('batched state copy requires matching contiguous device tensors')
+            rows.append((source.data_ptr(), destination.data_ptr(),
+                         source.numel() * source.element_size()))
+        plan = plan_byte_copies(rows, self.copy_descriptor_capacity)
+        # Bound pinned host memory and raw-pointer Tensor lifetimes. Any wait
+        # is counted, never silently treated as asynchronous.
+        self._retire_copy_buffers()
+        host = torch.empty((3, len(plan)), dtype=torch.int64, device='cpu', pin_memory=True)
+        host.numpy()[:] = tuple(zip(*plan))
+        metadata = self.arena.narrow(0, self.copy_metadata_offset, 3 * len(plan) * 8).view(
+            torch.int64).view(3, len(plan))
+        before = torch.npu.Event(enable_timing=True)
+        after = torch.npu.Event(enable_timing=True)
+        # Own raw-pointer storage before the first asynchronous enqueue. If
+        # launch raises after the H2D copy, the finally event still guards it.
+        self.pending_copy_buffers.append((after, host, tuple(sources), tuple(destinations)))
+        before.record(stream)
+        try:
+            metadata.copy_(host, non_blocking=True)
+            self.batch_memcpy(metadata[0], metadata[1], metadata[2])
+        finally:
+            after.record(stream)
+        self.counts['state_copy_kernel_launches'] += 1
+        self.counts['state_copy_descriptors'] += len(plan)
+        self.counts['state_copy_original_tensor_calls_replaced'] += len(rows)
+        self.counts['state_copy_metadata_bytes_uploaded'] += host.numel() * host.element_size()
+        if len(self.copy_events) < 256:
+            self.copy_events.append((before, after, operation, len(rows), len(plan), sum(n for _s, _d, n in rows)))
