diff --git a/DeepInfer/tests/test_native_prefill_state.py b/DeepInfer/tests/test_native_prefill_state.py
new file mode 100644
index 0000000..5da3364
--- /dev/null
+++ b/DeepInfer/tests/test_native_prefill_state.py
@@ -0,0 +1,155 @@
+"""Host metadata invariants only; no CPU model or numerical NPU simulation."""
+import importlib.util
+from pathlib import Path
+import random
+import sys
+from types import SimpleNamespace as NS
+import unittest
+from collections import Counter
+
+PATH = Path(__file__).parents[1] / 'deepinfer/model_executor/models/glm5_next/full_model/native_prefill_state.py'
+SPEC = importlib.util.spec_from_file_location('tested_native_prefill_state', PATH)
+M = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = M
+SPEC.loader.exec_module(M)
+
+
+class Part:
+    def is_contiguous(self):
+        return True
+
+
+class Rows:
+    shape = (100, 512)
+    def __getitem__(self, idx):
+        if not 0 <= idx < 100:
+            raise IndexError(idx)
+        return Part()
+
+
+class Contracts(unittest.TestCase):
+    def test_batched_descriptors_preserve_exact_byte_extents_and_tails(self):
+        rows = [(4096, 1000000, 65537), (80000, 2000000, 17)]
+        plan = M.plan_byte_copies(rows, 3)
+        self.assertEqual(plan, ((4096, 1000000, 65536), (69632, 1065536, 1),
+                                (80000, 2000000, 17)))
+        self.assertEqual(sum(n for _s, _d, n in plan), sum(n for _s, _d, n in rows))
+        for s, d, n in plan:
+            self.assertTrue(any(a <= s < s+n <= a+length and b <= d < d+n <= b+length
+                                and s-a == d-b for a, b, length in rows))
+
+    def test_batched_copy_rejects_cross_region_alias_and_overflow(self):
+        for rows, capacity in [([(1000, 2000, 32), (1100, 2010, 16)], 4),
+                               ([(1000, 2000, 128), (3000, 1100, 32)], 4),
+                               ([(1000, 1000, 32)], 4),
+                               ([(1000, 1000000, 65537)], 1),
+                               ([(1000, 2**63-1, 2)], 4), ([], 4)]:
+            with self.subTest(rows=rows), self.assertRaises(ValueError):
+                M.plan_byte_copies(rows, capacity)
+
+    def test_pending_raw_storage_survives_wait_failure(self):
+        memo = M.NativePrefillState.__new__(M.NativePrefillState)
+        memo.counts = Counter()
+        storage = object()
+        def wait():
+            self.assertIs(memo.pending_copy_buffers[0][1], storage)
+            raise RuntimeError('device wait failed')
+        pending = [(NS(query=lambda: False, synchronize=wait), storage)]
+        pending += [(NS(query=lambda: False), object()) for _ in range(M.MAX_PENDING_COPY_HOST_BUFFERS-1)]
+        memo.pending_copy_buffers = pending.copy()
+        with self.assertRaisesRegex(RuntimeError, 'device wait failed'):
+            memo._retire_copy_buffers()
+        self.assertEqual(memo.pending_copy_buffers, pending)
+        self.assertEqual(memo.counts['copy_host_backpressure_waits'], 1)
+
+    def test_retire_only_completed_or_successfully_waited_buffers(self):
+        memo = M.NativePrefillState.__new__(M.NativePrefillState)
+        memo.counts = Counter()
+        pending = [(NS(query=lambda: False, synchronize=lambda: None), object())
+                   for _ in range(M.MAX_PENDING_COPY_HOST_BUFFERS)]
+        memo.pending_copy_buffers = [(NS(query=lambda: True), object())] + pending
+        memo._retire_copy_buffers()
+        self.assertEqual(memo.pending_copy_buffers, pending[1:])
+
+    def test_repeated_close_preserves_device_timing_receipt(self):
+        memo = M.NativePrefillState.__new__(M.NativePrefillState)
+        memo.closed = True
+        memo.copy_timings_ms = [{'example': 'already collected'}]
+        memo.close()
+        self.assertEqual(memo.copy_timings_ms, [{'example': 'already collected'}])
+
+    def test_suffix_allows_different_prefill_chunking_without_missing_hidden_rows(self):
+        self.assertEqual(M.reusable_suffix_start(0, 1024, 640), 640)
+        self.assertEqual(M.reusable_suffix_start(640, 1024, 640), 640)
+        self.assertEqual(M.reusable_suffix_start(896, 1024, 640), 896)
+        self.assertEqual(M.reusable_suffix_start(0, 640, 640), 0)
+
+    def test_arena_never_overlaps_and_conserves_capacity(self):
+        arena = M.ByteArena(16384)
+        rng = random.Random(53)
+        for i in range(500):
+            if arena.live and rng.randrange(3) == 0:
+                arena.release(rng.choice(list(arena.live)))
+            else:
+                before = (list(arena.free), dict(arena.live))
+                pos = arena.allocate(i, rng.randrange(1, 4097))
+                if pos is None:
+                    self.assertEqual(before, (arena.free, arena.live))
+            extents = sorted(arena.free + list(arena.live.values()))
+            self.assertEqual(sum(n for _, n in extents), arena.capacity)
+            cursor = 0
+            for start, length in extents:
+                self.assertEqual(start, cursor)
+                self.assertEqual(length % 512, 0)
+                cursor += length
+        for owner in list(arena.live):
+            arena.release(owner)
+        self.assertEqual(arena.free, [(0, arena.capacity)])
+
+    def test_state_pages_follow_semantics_not_draft_reservation(self):
+        self.assertEqual(M.written_columns('attention', 640, 1024, 640), (1,))
+        self.assertEqual(M.written_columns('attention', 512, 1536, 640), (0, 1, 2))
+        self.assertEqual(M.written_columns('mamba', 512, 1536, 640), (2,))
+        self.assertEqual(M.written_columns('tail', 640, 1024, 9), (0,))
+        with self.assertRaises(ValueError):
+            M.written_columns('attention', 1024, 1024, 640)
+
+    def make_memo(self, ref_cnt=1):
+        memo = M.NativePrefillState.__new__(M.NativePrefillState)
+        memo.runner = NS(requests={'r': NS(block_ids=[[8, 9], [12], [20, 21, 22, 23]])},
+                         mamba_state_idx={'r': 1})
+        memo.layers = [M.Layer('attn', 0, 'attention', 640, Rows(), ()),
+                       M.Layer('tail', 1, 'tail', 9, Rows(), ()),
+                       M.Layer('kda', 2, 'mamba', 640, Rows(), (Rows(), Rows()))]
+        managers = []
+        for ids in memo.runner.requests['r'].block_ids:
+            managers.append(NS(req_to_blocks={'r': [NS(block_id=i, is_null=False, ref_cnt=ref_cnt) for i in ids]}))
+        memo.owner_cache = NS(coordinator=NS(single_type_managers=managers))
+        return memo
+
+    def test_restore_writes_current_private_state_not_shared_prefix(self):
+        memo = self.make_memo()
+        tensors, addresses = memo._segments(('r', 640, 1024, 0, 'key'))
+        self.assertEqual(addresses, [(0, 1, 9), (1, 0, 12), (2, 1, 21)])
+        self.assertEqual(len(tensors), 4)
+        self.assertNotIn((0, 0, 8), addresses)
+        self.assertNotIn((2, 2, 22), addresses)
+
+    def test_refuses_shared_or_reassigned_destination(self):
+        memo = self.make_memo(ref_cnt=2)
+        with self.assertRaisesRegex(ValueError, 'request-private'):
+            memo._segments(('r', 640, 1024, 0, 'key'))
+        memo = self.make_memo()
+        memo.owner_cache.coordinator.single_type_managers[0].req_to_blocks['r'][1].block_id = 99
+        with self.assertRaisesRegex(ValueError, 'request-private'):
+            memo._segments(('r', 640, 1024, 0, 'key'))
+
+    def test_refuses_wrong_running_kda_column(self):
+        memo = self.make_memo()
+        memo.runner.mamba_state_idx['r'] = 2
+        with self.assertRaisesRegex(ValueError, 'running KDA'):
+            memo._segments(('r', 640, 1024, 0, 'key'))
+
+
+if __name__ == '__main__':
+    unittest.main()
