@@ -0,0 +1,78 @@
+"""Optional throughput-oriented admission boundary for the native HTTP engine.
+
+Already admitted requests keep their normal scheduler and state ownership.
+After the first decode step, new HTTP requests wait for that finite cohort to
+finish. No timer, benchmark concurrency, prompt identity or response is used.
+This trades admission latency for fewer mid-decode prefill interruptions; NPU
+performance and output validity require separate validation.
+"""
+
+
+class NativeAdmissionCohort:
+    def __init__(self, enabled=False):
+        self.enabled = bool(enabled)
+        self.decoding = False
+        self.cohort_ids = frozenset()
+        self.counts = {'cohorts_started': 0, 'cohorts_finished': 0,
+                       'admission_withheld_steps': 0, 'max_waiting_http_requests': 0,
+                       'admitted_requests': 0, 'queue_wait_ns_sum': 0,
+                       'queue_wait_ns_max': 0, 'events_dropped': 0}
+        self.events = []
+
+    def _record(self, value):
+        if len(self.events) < 4096:
+            self.events.append(value)
+        else:
+            self.counts['events_dropped'] += 1
+
+    def allow_admission(self, active_ids, waiting_count, now_ns):
+        if not self.enabled:
+            return True
+        active = frozenset(active_ids)
+        if self.decoding:
+            if not active.issubset(self.cohort_ids):
+                raise RuntimeError('new request entered an already decoding cohort')
+            if active:
+                if waiting_count:
+                    self.counts['admission_withheld_steps'] += 1
+                    self.counts['max_waiting_http_requests'] = max(
+                        self.counts['max_waiting_http_requests'], waiting_count)
+                return False
+            self._record({'kind': 'cohort_finished', 'monotonic_ns': now_ns})
+            self.counts['cohorts_finished'] += 1
+            self.decoding = False
+            self.cohort_ids = frozenset()
+        return True
+
+    def admitted(self, request_id, queued_ns, now_ns):
+        if not self.enabled:
+            return
+        if self.decoding or now_ns < queued_ns:
+            raise RuntimeError('invalid admission boundary or queue timestamp')
+        wait = now_ns - queued_ns
+        self.counts['admitted_requests'] += 1
+        self.counts['queue_wait_ns_sum'] += wait
+        self.counts['queue_wait_ns_max'] = max(self.counts['queue_wait_ns_max'], wait)
+        self._record({'kind': 'admitted', 'request_id': request_id,
+                      'queued_monotonic_ns': queued_ns, 'monotonic_ns': now_ns})
+
+    def after_step(self, active_ids, is_decode, now_ns):
+        if not self.enabled:
+            return
+        active = frozenset(active_ids)
+        if self.decoding:
+            if not active.issubset(self.cohort_ids):
+                raise RuntimeError('cohort ownership changed while decoding')
+            return
+        if is_decode and active:
+            self.decoding = True
+            self.cohort_ids = active
+            self.counts['cohorts_started'] += 1
+            self._record({'kind': 'cohort_started', 'monotonic_ns': now_ns,
+                          'request_ids': sorted(active)})
+
+    def snapshot(self):
+        return {'enabled': self.enabled, 'decoding_cohort_active': self.decoding,
+                'counts': dict(self.counts), 'events': list(self.events),
+                'scope': 'HTTP admission only;native schedule,model,state and sampling unchanged',
+                'performance_validated': False}
