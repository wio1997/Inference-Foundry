+                    result = self.store.batch_get_into_layers([key], [pointers], [lengths], 1)
+                    if list(result) != [0]:
+                        raise RuntimeError(f"Private pool readback GET failed: {result}")
+                    get_ms = (time.perf_counter()-started)*1000
