+    def _glm53_post_pool_readback(self, selected):
+        if (os.getenv("GLM53_KV_POST_POOL_READBACK") != "1"
+                or self._glm53_audit_tp_rank != 0
+                or "glm53-postkv-target-" not in self._glm53_audit_request_id):
+            return
