+        from pathlib import Path
+        counts = getattr(self, "_glm53_pool_readback_counts", 0)
+        selected = selected[:max(0, 512-counts)]
+        if not selected:
+            return
+        lengths = selected[0][2]
+        if len(lengths) != 115 or any(row[2] != lengths for row in selected):
+            raise RuntimeError("Private pool readback requires the fixed GLM115-entry layout")
+        total = sum(lengths)
+        if total != 6979584:
+            raise RuntimeError("Unexpected private pool readback object size")
+        arena = torch.empty(total, dtype=torch.int8, device=f"npu:{self.device_id}")
+        base = arena.data_ptr()
+        pointers, offsets, offset = [], [], 0
+        for length in lengths:
+            pointers.append(base+offset)
+            offsets.append(offset)
+            offset += length
+        registered = self.store.register_buffer(base, total)
+        if registered != 0:
+            raise RuntimeError(f"Private readback register failed: {registered}")
