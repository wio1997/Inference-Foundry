      "path": "/usr/local/python3.12.13/lib/python3.12/site-packages/torch_npu/profiler/analysis/prof_view/prof_db_parse/_fwk_api_db_parser.py",
      "sha256": "8a8c558bee4995efde7c4f91fc4afc7fc03697b8d0d33e970e88b487fd8df39f",
      "start": 1,
