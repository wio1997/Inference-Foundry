        "line": 56,
        "text": "    def group_aging_file(api_file_list: list) -> dict:"
      },
      {
        "line": 57,
        "text": "        file_dict = {}"
      },
      {
        "line": 58,
        "text": "        for file in api_file_list:"
      },
      {
        "line": 59,
        "text": "            if file.startswith('aging'):"
      },
      {
        "line": 60,
        "text": "                file_dict.setdefault('aging_file', []).append(file)"
      },
      {
        "line": 61,
        "text": "            elif file.startswith('unaging'):"
      },
      {
        "line": 62,
        "text": "                file_dict.setdefault('unaging_file', []).append(file)"
      },
      {
        "line": 63,
        "text": "            else:"
      },
      {
        "line": 64,
        "text": "                logging.warning('Invalid file name: %s', format(file))"
      },
      {
        "line": 65,
        "text": "        for data_list in file_dict.values():"
      },
      {
        "line": 66,
        "text": "            data_list.sort(key=lambda x: int(x.split(\"_\")[-1]))"
      },
      {
        "line": 67,
        "text": "        return file_dict"
      },
