      {
        "line": 114,
        "text": "        check_func = kwargs.get('check_func', lambda x: None)"
      },
      {
        "line": 115,
        "text": "        result_data = []"
      },
      {
        "line": 116,
        "text": "        _offset_calculator = OffsetCalculator(file_list, format_size, self._project_path)"
      },
      {
        "line": 117,
        "text": "        for file_name in file_list:"
      },
      {
        "line": 118,
        "text": "            if not is_valid_original_data(file_name, self._project_path):"
      },
      {
        "line": 119,
        "text": "                continue"
      },
      {
        "line": 120,
        "text": "            FileManager.add_complete_file(self._project_path, file_name)"
      },
      {
        "line": 121,
        "text": "            file_path = self.get_file_path_and_check(file_name)"
      },
      {
        "line": 122,
        "text": "            logging.info(\"start to process the file: %s\", file_name)"
      },
      {
        "line": 123,
        "text": "            with FileOpen(file_path, \"rb\") as file:"
      },
      {
        "line": 124,
        "text": "                all_log_bytes = _offset_calculator.pre_process(file.file_reader, os.path.getsize(file_path))"
