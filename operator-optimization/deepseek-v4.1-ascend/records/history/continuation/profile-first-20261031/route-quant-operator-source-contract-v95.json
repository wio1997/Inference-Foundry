            "const static int64_t MAX_COLS_ONE_LOOP_QUANT = 8192;",
            "const static int64_t INDEX_SCALE = 2;",
            "const static int64_t INDEX_OFFSET = 3;",
            "const static int64_t SMOOTH_NONE = 0;",
