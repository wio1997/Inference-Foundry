  "source_contract": {
    "Torch_TLV_5_6_7_gate": "record_shapes && (with_stack || with_modules) && profile_memory",
    "record_op_args_is_in_this_Torch_detail_gate": false,
    "record_op_args_has_separate_CANN_config_forwarding": true,
    "TensorMetadata_fields": [
      "TensorImpl pointer",
      "storage base pointer",
      "dtype label",
      "element byte size",
      "sizes",
      "strides if strided",
      "device type",
      "device index"
    ],
    "pointer_source": "t.storage().data(),not t.data_ptr()",
    "does_not_serialize": [
      "storage_offset",
      "storage_nbytes",
      "NPU storage format",
      "allocation generation",
      "tensor version/mutation epoch",
      "all queued readers",
      "actual tensor contents"
    ],
    "TLV7_scalar_payload": "Type labels Bool/Int/Double/Complex/Others;not scalar values.",
    "scalar_lists_are_not_expanded_into_actual_scalar_values_here": true,
    "valid_tensor_filter": "defined && !nested && !symbolic_sizes_strides",
    "scope": "RecordFunction input metadata,not all raw CANN arguments or all output tensors.",
    "normal_start_requires_CPU_activity_callback": true,
    "gate_scope": "The displayed detail expression is inside an active CPU RecordFunction callback;normal start registers it only with CPU activity."
  },
