          "name": "compressed_slot_mapping",
          "start": 195,
          "end": 202,
          "source": [
            "195: def compressed_slot_mapping(slot_mapping: torch.Tensor, ratio: int) -> torch.Tensor:",
            "196:     \"\"\"Convert original-token physical slots to completed compressed slots.",
            "197: ",
            "198:     Logical block sizes must be divisible by ratio. Negative/padded slots and",
            "199:     incomplete compression groups never produce a write.",
            "200:     \"\"\"",
            "201:     valid = (slot_mapping >= 0) & ((slot_mapping + 1) % ratio == 0)",
            "202:     return torch.where(valid, slot_mapping // ratio, -1)"
          ]
        },
        {
          "name": "_build_batch_metadata",
          "start": 902,
          "end": 927,
          "source": [
            "902:     def _build_batch_metadata(self, common, num_reqs, num_actual_reqs, num_input_tokens):",
            "903:         self._seq_lens[:num_reqs].copy_(common.seq_lens[:num_reqs])",
            "904:         if num_actual_reqs < num_reqs:",
            "905:             self._seq_lens[num_actual_reqs:num_reqs].zero_()",
            "906:         seq_lens_cpu = getattr(common, \"seq_lens_cpu\", None)",
            "907:         if seq_lens_cpu is None:",
            "908:             seq_lens_cpu = getattr(common, \"_seq_lens_cpu\", None)",
            "909:         max_seq_len = int(getattr(common, \"max_seq_len\", 0))",
            "910:         if seq_lens_cpu is not None:",
            "911:             max_seq_len = int(seq_lens_cpu[:num_actual_reqs].max().item()) if num_actual_reqs else 0",
            "912:         num_decodes, num_decode_tokens, num_prefills, num_prefill_tokens = _request_counts(common, num_reqs)",
            "913:         positions = common.positions",
            "914:         if positions is not None:",
            "915:             positions = positions[:num_input_tokens].long()",
            "916:         return dict(",
            "917:             query_start_loc=common.query_start_loc[: num_reqs + 1],",
            "918:             query_start_loc_cpu=getattr(common, \"query_start_loc_cpu\", None),",
            "919:             seq_lens=self._seq_lens[:num_reqs],",
            "920:             seq_lens_cpu=seq_lens_cpu,",
            "921:             positions=positions,",
            "922:             max_cache_seq_len=max_seq_len,",
            "923:             num_decodes=num_decodes,",
            "924:             num_decode_tokens=num_decode_tokens,",
            "925:             num_prefills=num_prefills,",
            "926:             num_prefill_tokens=num_prefill_tokens,",
            "927:         )"
          ]
        }
