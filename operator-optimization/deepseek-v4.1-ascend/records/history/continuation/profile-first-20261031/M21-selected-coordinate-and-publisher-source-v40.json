      "functions": [
        {
          "name": "set_inputs_first_pass",
          "start": 226,
          "end": 357,
          "source": [
            "226:     def set_inputs_first_pass(",
            "227:         self,",
            "228:         target_token_ids: torch.Tensor,",
            "229:         next_token_ids: torch.Tensor,",
            "230:         target_positions: torch.Tensor,",
            "231:         target_hidden_states: torch.Tensor,",
            "232:         token_indices_to_sample: torch.Tensor | None,",
            "233:         cad: CommonAttentionMetadata,",
            "234:         num_rejected_tokens_gpu: torch.Tensor | None,",
            "235:         req_scheduled_tokens=None,",
            "236:         long_seq_metadata=None,",
            "237:         num_prefill_reqs=0,",
            "238:         num_decode_reqs=0,",
            "239:     ) -> tuple[int, torch.Tensor, CommonAttentionMetadata, tuple[Any, Any] | None]:",
            "240:         # The initial input token of markovHead is the next token",
            "241:         n = next_token_ids.shape[0]",
            "242:         self._dspark_seed_buffer[:n].copy_(next_token_ids)",
            "243:         self._dspark_seed_buffer[n:].fill_(0)",
            "244:         batch_size = cad.num_reqs",
            "245:         num_query_total = batch_size * self.num_query_per_req",
            "246:         num_sample_total = batch_size * self.num_speculative_tokens",
            "247:         has_num_rejected = num_rejected_tokens_gpu is not None",
            "248:         dcp_size = getattr(self, \"dcp_size\", 1)",
            "249:         dcp_rank = getattr(self, \"dcp_rank\", 0)",
            "250:         cp_interleave_size = self.vllm_config.parallel_config.cp_kv_cache_interleave_size if dcp_size > 1 else 1",
            "251:         long_seq_args = None",
            "252:         primary_gid = getattr(self, \"kv_cache_gid\", 0)",
            "253:         self._per_group_block_table_buffers = {",
            "254:             attn_group.kv_cache_group_id: self._per_group_block_tables[attn_group.kv_cache_group_id]",
            "255:             for attn_group in self.draft_attn_groups",
            "256:         }",
            "257:         self._context_slot_mapping_buffers = None",
            "258:         self._dflash_num_context = int(cad.query_start_loc_cpu[batch_size])",
            "259:         self._dflash_hidden_states[: self._dflash_num_context] = target_hidden_states[: self._dflash_num_context]",
            "260: ",
            "261:         token_indices_to_sample = torch.empty(",
            "262:             num_sample_total,",
            "263:             dtype=torch.int32,",
            "264:             device=self.device,",
            "265:         )",
            "266: ",
            "267:         # Query block: reuse the DFlash inputs kernel logic (host-side ref)",
            "268:         # per kv-cache-group to fill positions / input_ids / query slot_mapping",
            "269:         # / token_indices.",
            "270:         for attn_group in self.draft_attn_groups:",
            "271:             gid = attn_group.kv_cache_group_id",
            "272:             gid_block_table = self._per_group_block_table_buffers[gid]",
            "273:             kernel_block_size = self._per_group_kernel_block_sizes[gid]",
            "274:             copy_and_expand_dflash_and_dspark_inputs_kernel[",
            "275:                 (_compute_num_programs(self._dflash_num_context, num_query_total),)",
            "276:             ](",
            "277:                 # Inputs",
            "278:                 next_token_ids_ptr=next_token_ids,",
            "279:                 target_positions_ptr=target_positions,",
            "280:                 context_slot_mapping_ptr=self._per_group_slot_mappings[gid],",
            "281:                 # Outputs",
            "282:                 out_input_ids_ptr=self.input_ids,",
            "283:                 out_context_positions_ptr=self._context_positions_buffer,",
            "284:                 out_query_positions_ptr=self.positions,",
            "285:                 out_context_slot_mapping_ptr=self._per_group_context_slot_mapping_buffers[gid],",
            "286:                 out_query_slot_mapping_ptr=self._per_group_query_slot_mapping_buffers[gid],",
            "287:                 out_token_indices_ptr=token_indices_to_sample,",
            "288:                 # Block table",
            "289:                 block_table_ptr=gid_block_table,",
            "290:                 block_table_stride=gid_block_table.stride(0),",
            "291:                 # Metadata",
            "292:                 query_start_loc_ptr=cad.query_start_loc,",
            "293:                 seq_lens_ptr=cad.seq_lens,",
            "294:                 num_rejected_tokens_ptr=num_rejected_tokens_gpu,",
            "295:                 # Scalars",
            "296:                 parallel_drafting_token_id=self.parallel_drafting_token_id,",
            "297:                 block_size=kernel_block_size,",
            "298:                 num_query_per_req=self.num_query_per_req,",
            "299:                 num_speculative_tokens=self.num_speculative_tokens,",
            "300:                 total_input_tokens=self._dflash_num_context,",
            "301:                 batch_size=batch_size,",
            "302:                 HAS_NUM_REJECTED=has_num_rejected,",
            "303:                 SAMPLE_FROM_ANCHOR=self.sample_from_anchor,",
            "304:                 DCP_SIZE=dcp_size,",
            "305:                 DCP_RANK=dcp_rank,",
            "306:                 CP_INTERLEAVE_SIZE=cp_interleave_size,",
            "307:             )",
            "308:         # to compute self._context_slot_mapping_buffers from dict to list",
            "309:         self._context_slot_mapping_buffers = [",
            "310:             self._per_group_context_slot_mapping_buffers[gidx] for gidx in self._layer_group_idx",
            "311:         ]",
            "312: ",
            "313:         effective_seq_lens = cad.seq_lens",
            "314:         if has_num_rejected:",
            "315:             effective_seq_lens = effective_seq_lens - num_rejected_tokens_gpu",
            "316: ",
            "317:         cad.query_start_loc = self.arange_dflash[: batch_size + 1] * self.num_query_per_req",
            "318:         cad.seq_lens = effective_seq_lens + self.num_query_per_req",
            "319:         # The model runner has already corrected this canonical host mirror",
            "320:         # with the accepted-token count. Extend it on CPU alongside the device",
            "321:         # lengths, without another reject D2H copy or attention-side wait.",
            "322:         if cad._seq_lens_cpu is not None:",
            "323:             draft_seq_lens_cpu = cad._seq_lens_cpu.clone()",
            "324:             draft_seq_lens_cpu[:batch_size].add_(self.num_query_per_req)",
            "325:             cad._seq_lens_cpu = draft_seq_lens_cpu",
            "326:             if getattr(cad, \"seq_lens_cpu\", None) is not None:",
            "327:                 cad.seq_lens_cpu = draft_seq_lens_cpu",
            "328:         cad.query_start_loc_cpu = (",
            "329:             torch.from_numpy(self.token_arange_np[: batch_size + 1]).clone() * self.num_query_per_req",
            "330:         ).to(torch.int32)",
            "331: ",
            "332:         if hasattr(cad, \"actual_seq_lengths_q\"):",
            "333:             cad.actual_seq_lengths_q = [self.num_query_per_req] * batch_size",
            "334:         if hasattr(cad, \"decode_token_per_req\"):",
            "335:             cad.decode_token_per_req = self.num_query_per_req",
            "336: ",
            "337:         cad.num_actual_tokens = num_query_total",
            "338:         cad.num_input_tokens = num_query_total",
            "339:         cad.max_query_len = self.num_query_per_req",
            "340:         cad.max_seq_len = cad.max_seq_len + self.num_query_per_req",
            "341:         cad.slot_mapping = self._per_group_query_slot_mapping_buffers[primary_gid][:num_query_total]",
            "342:         cad.positions = self.positions  # this would be sliced in attention backend",
            "343:         if hasattr(self.model, \"get_draft_attn_causal\"):",
            "344:             # Currently, attention causality across draft layers are uniform.",
            "345:             cad.causal = self.model.get_draft_attn_causal()[0]",
            "346:         else:",
            "347:             cad.causal = False",
            "348:         cad.attn_mask = None",
            "349:         cad.attn_state = AscendAttentionState.ChunkedPrefill",
            "350: ",
            "351:         if dcp_size > 1:",
            "352:             assert self.runner is not None",
            "353:             dcp_manager = getattr(self.runner, \"dcp_manager\", None)",
            "354:             assert dcp_manager is not None",
            "355:             dcp_manager.prepare_parallel_draft_metadata(cad, self.draft_attn_groups)",
            "356: ",
            "357:         return num_query_total, token_indices_to_sample, cad, long_seq_args"
          ]
        }
