            "127:         specs = list(specs_or_groups.values())",
            "128:     else:",
            "129:         specs = []",
            "130:         for item in specs_or_groups:",
            "131:             spec = getattr(item, \"kv_cache_spec\", item)",
            "132:             if isinstance(spec, UniformTypeKVCacheSpecs):",
            "133:                 specs.extend(spec.kv_cache_specs.values())",
            "134:             else:",
            "135:                 specs.append(spec)",
            "136:     return any(getattr(spec, \"model_version\", None) == \"deepseek_v41\" for spec in specs)"
          ]
