            "264:                 offset=0,",
            "265:                 layer_stride=0,",
            "266:                 block_stride=page_size,",
            "267:             )",
            "268:         )",
            "269:     return KVCacheConfig(",
            "270:         num_blocks=num_blocks,",
            "271:         kv_cache_tensors=tensors,",
            "272:         kv_cache_groups=groups,",
            "273:         prefix_cache_retention_interval=vllm_config.cache_config.prefix_cache_retention_interval,",
            "274:     )"
          ]
        }
