          "source": [
            "248: def get_deepseek_v41_kv_cache_config(",
            "249:     vllm_config: VllmConfig,",
            "250:     groups: list[KVCacheGroupSpec],",
            "251:     available_memory: int,",
            "252: ) -> KVCacheConfig:",
            "253:     \"\"\"Allocate four independent layer slots backed by one global block-ID pool.\"\"\"",
            "254:     page_sizes, layer_tuples = get_layer_tuples(_specs_from_groups(groups))",
            "255:     capacity = max(available_memory // sum(page_sizes), 0)",
            "256:     num_blocks = may_override_num_blocks(vllm_config, capacity)",
            "257:     tensors: list[KVCacheTensor] = []",
