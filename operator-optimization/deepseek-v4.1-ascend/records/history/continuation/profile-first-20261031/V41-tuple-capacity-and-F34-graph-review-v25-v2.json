        {
          "name": "get_layer_tuples",
          "start": 147,
          "end": 178,
          "source": [
            "147: def get_layer_tuples(specs):",
            "148:     \"\"\"Return DSV4-style ordered layer tuples and their physical page sizes.\"\"\"",
            "149:     mla = {name for name, spec in specs.items() if isinstance(spec, AscendMLAAttentionSpec)}",
            "150:     state = sorted((name for name, spec in specs.items() if isinstance(spec, CircularBufferSpec)), key=_layer_number)",
            "151:     swa = {name for name, spec in specs.items() if isinstance(spec, AscendSlidingWindowMLASpec)}",
            "152: ",
            "153:     full = sorted((name for name in mla if name.endswith(\".long_kv_cache\")), key=_layer_number)",
            "154:     target_swa = sorted((name for name in swa if \".mtp.\" not in f\".{name}\"), key=_layer_number)",
            "155:     draft_swa = sorted((name for name in swa if \".mtp.\" in f\".{name}\"), key=_draft_layer_number)",
            "156: ",
            "157:     layer_tuples: list[tuple[str, ...]] = []",
            "158:     page_sizes: list[int] = []",
            "159:     for slot_idx, kv_name in enumerate(full):",
            "160:         prefix = kv_name.rsplit(\".\", 1)[0]",
            "161:         index_name = prefix + \".indexer.k_cache\"",
            "162:         folded_name = index_name + \"_folded\"",
            "163:         folded_spec = specs.get(folded_name)",
            "164:         index_spec = specs[index_name]",
            "165:         kv_spec = specs[kv_name]",
            "166:         aliases = ([state[slot_idx]] if slot_idx < len(state) else []) + target_swa[slot_idx :: len(full)]",
            "167:         kv_bytes = kv_spec.unpadded_page_size_bytes",
            "168:         index_bytes = index_spec.unpadded_page_size_bytes",
            "169:         folded_bytes = folded_spec.unpadded_page_size_bytes if folded_spec is not None else 0",
            "170:         if slot_idx < len(draft_swa):",
            "171:             aliases.append(draft_swa[slot_idx])",
            "172:         capacity = max(",
            "173:             kv_bytes + index_bytes + folded_bytes,",
            "174:             *(specs[name].unpadded_page_size_bytes for name in aliases),",
            "175:         )",
            "176:         layer_tuples.append((kv_name, index_name, *((folded_name,) if folded_spec is not None else ()), *aliases))",
            "177:         page_sizes.append(capacity)",
            "178:     return page_sizes, layer_tuples"
          ]
        },
        {
          "name": "group_cache_specs",
          "start": 181,
          "end": 228,
          "source": [
            "181: def group_cache_specs(specs):",
            "182:     \"\"\"Merge full-context resources and pad layer tuples without mutating inputs.\"\"\"",
            "183:     page_sizes, layer_tuples = get_layer_tuples(specs)",
            "184:     padded = {}",
            "185:     for page_size, layer_tuple in zip(page_sizes, layer_tuples):",
            "186:         kv_name, index_name, *rest = layer_tuple",
            "187:         folded_name = index_name + \"_folded\"",
            "188:         has_folded = folded_name in rest",
            "189:         aliases = rest[1:] if has_folded else rest",
            "190:         kv_bytes = specs[kv_name].unpadded_page_size_bytes",
            "191:         index_bytes = specs[index_name].unpadded_page_size_bytes",
            "192:         padded[kv_name] = replace(specs[kv_name], page_size_padded=kv_bytes)",
            "193:         padded[index_name] = replace(",
            "194:             specs[index_name], page_size_padded=index_bytes if has_folded else page_size - kv_bytes",
            "195:         )",
            "196:         if has_folded:",
            "197:             padded[folded_name] = replace(specs[folded_name], page_size_padded=page_size - kv_bytes - index_bytes)",
            "198:         padded.update((name, replace(specs[name], page_size_padded=page_size)) for name in aliases)",
            "199: ",
            "200:     mla_names = [name for name, spec in padded.items() if isinstance(spec, AscendMLAAttentionSpec)]",
            "201:     state_names = [name for name, spec in padded.items() if isinstance(spec, CircularBufferSpec)]",
            "202:     groups = [",
            "203:         UniformTypeKVCacheSpecs.from_specs({name: padded[name] for name in mla_names}),",
            "204:         UniformTypeKVCacheSpecs.from_specs({name: padded[name] for name in state_names}),",
            "205:     ]",
            "206: ",
            "207:     # Transpose the physical tuples. Each scheduler SWA group takes one layer",
            "208:     # from every tuple, so its members use distinct slots at the same block ID.",
            "209:     swa_columns = [",
            "210:         [",
            "211:             name",
            "212:             for name in layer_tuple",
            "213:             if isinstance(padded[name], AscendSlidingWindowMLASpec) and \".mtp.\" not in f\".{name}\"",
            "214:         ]",
            "215:         for layer_tuple in layer_tuples",
            "216:     ]",
            "217:     for names in zip(*swa_columns):",
            "218:         groups.append(UniformTypeKVCacheSpecs.from_specs({name: padded[name] for name in names}))",
            "219: ",
            "220:     draft_names = [",
            "221:         name",
            "222:         for layer_tuple in layer_tuples",
            "223:         for name in layer_tuple",
            "224:         if isinstance(padded[name], AscendSlidingWindowMLASpec) and \".mtp.\" in f\".{name}\"",
            "225:     ]",
            "226:     if draft_names:",
            "227:         groups.append(UniformTypeKVCacheSpecs.from_specs({name: padded[name] for name in draft_names}))",
            "228:     return groups"
          ]
        },
