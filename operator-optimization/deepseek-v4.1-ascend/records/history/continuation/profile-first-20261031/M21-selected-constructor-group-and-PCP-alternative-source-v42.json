      "sha256": "3505769857f83fa7e67f652984f50bd0478158f1d24f185cab091203e70392fd",
      "functions": [
        {
          "owner": "AscendDSAV41MetadataBuilder",
          "name": "__init__",
          "start": 721,
          "end": 818,
          "source": [
            "721:     def __init__(",
            "722:         self,",
            "723:         kv_cache_spec,",
            "724:         layer_names,",
            "725:         vllm_config,",
            "726:         device,",
            "727:         *,",
            "728:         build_query_metadata=True,",
            "729:         build_compressor_metadata=True,",
            "730:     ):",
            "731:         if (",
            "732:             isinstance(kv_cache_spec, AscendMLAAttentionSpec)",
            "733:             and getattr(kv_cache_spec, \"model_version\", None) == \"deepseek_v41\"",
            "734:         ):",
            "735:             logical_block_size = vllm_config.cache_config.block_size",
            "736:             if kv_cache_spec.block_size != logical_block_size:",
            "737:                 updates = {\"block_size\": logical_block_size}",
            "738:                 if \"storage_block_size\" in kv_cache_spec.__dataclass_fields__:",
            "739:                     updates[\"storage_block_size\"] = logical_block_size // get_kv_cache_compression_ratio(kv_cache_spec)",
            "740:                 kv_cache_spec = replace(kv_cache_spec, **updates)",
            "741:         super().__init__(kv_cache_spec, layer_names, vllm_config, device)",
            "742:         max_tokens = getattr(vllm_config.scheduler_config, \"max_num_batched_tokens\", 4096)",
            "743:         max_reqs = getattr(vllm_config.scheduler_config, \"max_num_seqs\", 256)",
            "744:         self._supports_device_ops = getattr(device, \"type\", \"cpu\") != \"cpu\"",
            "745:         # Allocate both decode and prefill owners before graph capture.",
            "746:         self._build_query_metadata = build_query_metadata",
            "747:         self._build_compressor_metadata = build_compressor_metadata",
            "748:         if isinstance(kv_cache_spec, CircularBufferSpec):",
            "749:             self._cache_kind = \"compressor_state\"",
            "750:         elif isinstance(kv_cache_spec, AscendSlidingWindowMLASpec):",
            "751:             self._cache_kind = \"swa\"",
            "752:         elif isinstance(kv_cache_spec, AscendMLAAttentionSpec):",
            "753:             # make_folded_index_cache_spec packs eight index rows into one:",
            "754:             # 8 * (128 / 2 FP4 bytes + 128 / 32 scale bytes) = 544 bytes.",
            "755:             # Its scales are inline (scale_dim=0), like long KV, so identify",
            "756:             # this layout first to avoid treating it as compressed long KV.",
            "757:             if kv_cache_spec.tokens_per_state == 8 and kv_cache_spec.head_size == 544:",
            "758:                 self._cache_kind = \"index_k_folded\"",
            "759:             else:",
            "760:                 self._cache_kind = \"index_k\" if kv_cache_spec.scale_dim else \"long_kv\"",
            "761:         else:",
            "762:             raise TypeError(f\"Unsupported V4.1 cache spec: {type(kv_cache_spec).__name__}\")",
            "763:         self._device_backend = DeviceOperator.get_dsv41_packed_cache_ops()",
            "764:         self._uses_a5_packed_cache = self._device_backend is not None",
            "765:         text_config = vllm_config.model_config.hf_text_config",
            "766:         window_size = int(_config_value(text_config, \"sliding_window\", 0))",
            "767:         query_metadata_size = V41_METADATA_BUFFER_SIZE if build_query_metadata else 0",
            "768:         compressor_tokens = max_tokens if build_compressor_metadata else 0",
            "769:         compressor_reqs = max_reqs if build_compressor_metadata else 0",
            "770:         self._slot_mapping = torch.full((max_tokens,), -1, dtype=torch.int64, device=device)",
            "771:         self._slot_mapping_2d = torch.full((max_tokens, 2), -1, dtype=torch.int32, device=device)",
            "772:         self._flat_slot_mapping = torch.full((max_tokens,), -1, dtype=torch.int64, device=device)",
            "773:         self._seq_lens = torch.zeros(max_reqs, dtype=torch.int32, device=device)",
            "774:         self._max_tokens = max_tokens",
            "775:         self._dspark_swa_indices = None",
            "776:         self._dspark_swa_lengths = None",
            "777:         self._cache_seq_lens = torch.zeros(max_reqs, dtype=torch.int32, device=device)",
            "778:         self._cmp_residual = torch.zeros(max_reqs, dtype=torch.int32, device=device)",
            "779:         self._smla_metadata = torch.zeros(query_metadata_size, dtype=torch.int32, device=device)",
            "780:         self._qli_metadata = torch.zeros(query_metadata_size, dtype=torch.int32, device=device)",
            "781:         if self._supports_device_ops and self._uses_a5_packed_cache and self._cache_kind == \"swa\":",
            "782:             self._a5_causal_swa_indices = torch.empty((max_tokens, 1, window_size), dtype=torch.int32, device=device)",
            "783:             self._a5_causal_swa_lengths = torch.empty((max_tokens, 1), dtype=torch.int32, device=device)",
            "784:             self._a5_smla_metadata = torch.empty(V41_METADATA_BUFFER_SIZE, dtype=torch.int32, device=device)",
            "785:             self._a5_smla_length_rows = torch.empty((max_tokens, 1), dtype=torch.int32, device=device)",
            "786:         else:",
            "787:             self._a5_causal_swa_indices = None",
            "788:             self._a5_causal_swa_lengths = None",
            "789:             self._a5_smla_metadata = None",
            "790:             self._a5_smla_length_rows = None",
            "791:         self._c2_ring_metadata = torch.zeros(5 * compressor_reqs, dtype=torch.int32, device=device)",
            "792:         self._c2_complete_mask = torch.zeros(compressor_tokens, dtype=torch.bool, device=device)",
            "793:         self._c2_source_positions = torch.zeros(compressor_tokens, dtype=torch.int64, device=device)",
