          "source": [
            "242:     def from_local_metadata(",
            "243:         cls,",
            "244:         local: AscendDSAV41Metadata,",
            "245:         global_metadata: AscendDSAV41Metadata,",
            "246:         local_num_tokens_after_padding: int,",
            "247:         hidden_restore_idx: torch.Tensor,",
            "248:     ) -> \"AscendDSAV41PCPMetadata\":",
            "249:         values = {field.name: getattr(local, field.name) for field in fields(AscendDSAV41Metadata)}",
            "250:         values[\"global_metadata\"] = global_metadata",
            "251:         return cls(",
            "252:             **values,",
            "253:             local_num_tokens_after_padding=local_num_tokens_after_padding,",
            "254:             hidden_restore_idx=hidden_restore_idx,",
            "255:         )"
          ]
        },
        {
          "owner": "AscendDSAV41PCPMetadataBuilder",
          "name": "__init__",
          "start": 264,
          "end": 281,
          "source": [
            "264:     def __init__(self, kv_cache_spec, layer_names, vllm_config, device):",
            "265:         if vllm_config.parallel_config.decode_context_parallel_size != 1:",
            "266:             raise NotImplementedError(\"V4.1 PCP currently requires DCP=1 for replicated caches.\")",
            "267:         super().__init__(kv_cache_spec, layer_names, vllm_config, device, build_local_compressor_metadata=True)",
            "268:         self._pcp_world_size = vllm_config.parallel_config.prefill_context_parallel_size",
            "269:         self._pcp_rank = get_pcp_group().rank_in_group",
            "270:         self._is_decode_sharded = is_pcp_decode_sharding_enabled(vllm_config)",
            "271:         self._max_tokens = vllm_config.scheduler_config.max_num_batched_tokens",
            "272:         self._hidden_restore_idx_buffer = torch.empty(self._max_tokens, dtype=torch.int64, device=device)",
            "273: ",
            "274:         # DualChunkSwap doubles prefill rows; decode graphs also pad requests.",
            "275:         max_reqs = vllm_config.scheduler_config.max_num_seqs",
            "276:         capture_sizes = vllm_config.compilation_config.cudagraph_capture_sizes or ()",
            "277:         graph_reqs = max(capture_sizes, default=0)",
            "278:         self._resize_request_buffers(self, max(self._request_capacity_factor * max_reqs, graph_reqs) + 1)",
            "279:         self._resize_request_buffers(self._global_builder, max(max_reqs, graph_reqs) + 1)",
            "280: ",
            "281:         self._pcp_rope_buffers: dict[str, tuple[torch.Tensor, ...]] = {}"
          ]
        },
        {
          "owner": "AscendDSAV41PCPMetadataBuilder",
          "name": "_resize_request_buffers",
          "start": 284,
          "end": 292,
          "source": [
            "284:     def _resize_request_buffers(builder, capacity: int) -> None:",
            "285:         # Resize before graph capture.",
            "286:         for name in (\"_seq_lens\", \"_cache_seq_lens\", \"_cmp_residual\"):",
            "287:             buffer = getattr(builder, name)",
            "288:             setattr(builder, name, buffer.new_zeros(capacity))",
            "289:         if builder._build_compressor_metadata:",
            "290:             # C2 metadata rows: 0=start position, 1=valid token count,",
            "291:             # 2=output row base (reserved), 3=input row base, 4=state block ID.",
            "292:             builder._c2_ring_metadata = builder._c2_ring_metadata.new_zeros(5 * capacity)"
          ]
        },
        {
          "owner": "AscendDSAV41PCPMetadataBuilder",
          "name": "prepare_source_rope",
          "start": 294,
          "end": 317,
          "source": [
            "294:     def prepare_source_rope(self) -> None:",
            "295:         super().prepare_source_rope()",
            "296:         if self._cache_kind != \"swa\" or self._pcp_rope_buffers:",
            "297:             return",
            "298:         by_table: dict[tuple[int, int], tuple[torch.Tensor, ...]] = {}",
            "299:         for cache_name in self.layer_names:",
            "300:             layer_name = cache_name.removesuffix(\".swa_cache\") + \".attn\"",
            "301:             full_cos, full_sin = get_full_cos_and_sin_dsa_for_layer(layer_name)",
            "302:             key = (full_cos.data_ptr(), full_sin.data_ptr())",
            "303:             buffers = by_table.get(key)",
            "304:             if buffers is None:",
            "305:                 # Keep Q/KV RoPE buffers graph-stable and independent of the draft.",
            "306:                 shape = (self._max_tokens, *full_cos.shape[1:])",
            "307:                 # Full tables, local Q cos/sin, global KV cos/sin.",
            "308:                 buffers = (",
            "309:                     full_cos,",
            "310:                     full_sin,",
            "311:                     full_cos.new_empty(shape),",
            "312:                     full_sin.new_empty(shape),",
            "313:                     full_cos.new_empty(shape),",
            "314:                     full_sin.new_empty(shape),",
            "315:                 )",
            "316:                 by_table[key] = buffers",
            "317:             self._pcp_rope_buffers[layer_name] = buffers"
          ]
        },
        {
          "owner": "AscendDSAV41PCPMetadataBuilder",
          "name": "_build_pcp_rope_views",
          "start": 319,
          "end": 342,
          "source": [
            "319:     def _build_pcp_rope_views(self, common: AscendCommonAttentionMetadata, *, global_cache: bool):",
            "320:         if self._cache_kind != \"swa\":",
            "321:             return None",
            "322:         assert self._pcp_rope_buffers, \"Prepare V4.1 PCP RoPE before building attention metadata\"",
            "323:         num_tokens = common.num_input_tokens",
            "324:         positions = common.positions[:num_tokens].long()",
            "325:         cos_views, sin_views = {}, {}",
            "326:         gathered: dict[tuple[int, int], tuple[torch.Tensor, torch.Tensor]] = {}",
            "327:         for layer_name, buffers in self._pcp_rope_buffers.items():",
            "328:             full_cos, full_sin = buffers[:2]",
            "329:             key = (full_cos.data_ptr(), full_sin.data_ptr())",
            "330:             views = gathered.get(key)",
            "331:             if views is None:",
            "332:                 offset = 4 if global_cache else 2",
            "333:                 cos, sin = buffers[offset : offset + 2]",
            "334:                 cos, sin = cos[:num_tokens], sin[:num_tokens]",
            "335:                 if num_tokens:",
            "336:                     indices = positions.reshape(-1, 1, 1, 1).expand(num_tokens, 1, 1, full_cos.shape[-1])",
            "337:                     torch.gather(full_cos, 0, indices, out=cos)",
            "338:                     torch.gather(full_sin, 0, indices, out=sin)",
            "339:                 views = (cos, sin)",
            "340:                 gathered[key] = views",
            "341:             cos_views[layer_name], sin_views[layer_name] = views",
            "342:         return cos_views, sin_views"
          ]
        },
        {
          "owner": "AscendDSAV41PCPMetadataBuilder",
          "name": "_build_empty_local_metadata",
          "start": 344,
          "end": 370,
          "source": [
            "344:     def _build_empty_local_metadata(self, common: AscendCommonAttentionMetadata) -> AscendDSAV41Metadata:",
            "345:         # Skip SMLA/QLI metadata ops on ranks with no queries.",
            "346:         self._device_metadata_tasks = ()",
            "347:         num_tokens, num_reqs = common.num_input_tokens, common.num_reqs",
            "348:         is_state = self._cache_kind == \"compressor_state\"",
            "349:         slots = self._slot_mapping if is_state else self._slot_mapping_2d",
            "350:         return AscendDSAV41Metadata(",
            "351:             block_table=common.block_table_tensor[:num_reqs],",
            "352:             query_start_loc=common.query_start_loc[: num_reqs + 1],",
            "353:             query_start_loc_cpu=common.query_start_loc_cpu,",
            "354:             seq_lens=self._seq_lens[:num_reqs].zero_(),",
            "355:             seq_lens_cpu=common.seq_lens_cpu,",
            "356:             cache_seq_lens=self._cache_seq_lens[:num_reqs].zero_(),",
            "357:             slot_mapping=slots[:num_tokens].fill_(-1),",
            "358:             flat_slot_mapping=self._flat_slot_mapping[:num_tokens].fill_(-1),",
            "359:             compress_ratio=get_kv_cache_compression_ratio(self.kv_cache_spec),",
            "360:             storage_block_size=get_storage_block_size(self.kv_cache_spec),",
            "361:             logical_block_size=self.kv_cache_spec.block_size,",
            "362:             is_compressor_state=is_state,",
            "363:             cache_kind=self._cache_kind,",
            "364:             positions=common.positions[:num_tokens],",
            "365:             num_input_tokens=num_tokens,",
            "366:             num_reqs=num_reqs,",
            "367:             attn_state=common.attn_state,",
            "368:             is_prefilling=common.is_prefilling,",
            "369:             causal=common.causal,",
            "370:         )"
          ]
        },
        {
          "owner": "AscendDSAV41PCPMetadataBuilder",
          "name": "build",
          "start": 372,
          "end": 442,
          "source": [
            "372:     def build(",
            "373:         self,",
            "374:         common_prefix_len,",
            "375:         common_attn_metadata: AscendCommonAttentionMetadata,",
            "376:         fast_build=False,",
            "377:         pcp_context: \"AscendPCPAttentionContext | None\" = None,",
            "378:         pcp_cache_group_idx: int | None = None,",
            "379:         num_actual_reqs: int | None = None,",
            "380:         **kwargs: Any,",
            "381:     ) -> AscendDSAV41Metadata:",
            "382:         assert pcp_context is not None, \"V4.1 PCP requires the MRV2 global batch context\"",
            "383:         assert pcp_cache_group_idx is not None",
            "384: ",
            "385:         # Use the global batch so all ranks choose the same prefill/decode path.",
            "386:         has_prefill = bool(pcp_context.global_batch.is_prefilling_np.any())",
            "387:         # Sharded decodes have distinct queries but still need complete caches.",
            "388:         needs_global_metadata = has_prefill or self._is_decode_sharded",
            "389:         self._global_builder.take_device_metadata_tasks()",
            "390: ",
            "391:         if needs_global_metadata:",
            "392:             pcp_context = AscendDSAPCPMetadataBuilder._prepare_graph_pcp_context(self, pcp_context)",
            "393:             global_common = AscendDSAPCPMetadataBuilder._build_global_common_attn_metadata(",
            "394:                 pcp_context, pcp_cache_group_idx, common_attn_metadata",
            "395:             )",
            "396:         local_common = AscendDSAPCPMetadataBuilder._build_local_common_attn_metadata(",
            "397:             self, pcp_context, common_attn_metadata, pcp_cache_group_idx, has_prefill",
            "398:         )",
            "399: ",
            "400:         # Match graph capture shapes; dummy batches must not advance the C2 ring.",
            "401:         if kwargs.get(\"full_graph_mode\", False):",
            "402:             local_common = AscendDSAPCPMetadataBuilder._build_graph_common_attn_metadata(local_common, num_actual_reqs)",
            "403:             if needs_global_metadata:",
            "404:                 global_common = AscendDSAPCPMetadataBuilder._build_graph_common_attn_metadata(",
            "405:                     global_common, pcp_context.global_batch.num_reqs",
            "406:                 )",
            "407:         kwargs[\"skip_ring_state_update\"] = (",
            "408:             bool(kwargs.get(\"skip_ring_state_update\", False)) or pcp_context.global_batch.is_dummy",
            "409:         )",
            "410: ",
            "411:         # Keep global KV RoPE separate from rank-local Q positions.",
            "412:         if needs_global_metadata:",
            "413:             global_kwargs = dict(kwargs)",
            "414:             global_kwargs[\"num_actual_reqs\"] = pcp_context.global_batch.num_reqs",
            "415:             global_rope = self._build_pcp_rope_views(global_common, global_cache=True)",
            "416:             if global_rope is not None:",
            "417:                 global_kwargs[\"rope_views\"] = global_rope",
            "418:             global_metadata = self._build_global_metadata(common_prefix_len, global_common, fast_build, global_kwargs)",
            "419: ",
            "420:         # Empty Query ranks skip query metadata ops but still retain the global cache view.",
            "421:         if needs_global_metadata and local_common.num_actual_tokens == 0:",
            "422:             local_metadata = self._build_empty_local_metadata(local_common)",
            "423:         else:",
            "424:             local_kwargs = dict(kwargs)",
            "425:             local_kwargs[\"num_actual_reqs\"] = local_common.num_reqs if num_actual_reqs is None else num_actual_reqs",
            "426:             # C2 state updates belong to the cache metadata owner.",
            "427:             local_kwargs[\"build_compressor_metadata\"] = not needs_global_metadata",
            "428:             for name in (\"common_v41_metadata\", \"common_v41_batch_metadata\"):",
            "429:                 shared = kwargs.get(name)",
            "430:                 if shared is not None:",
            "431:                     local_kwargs[name] = shared.setdefault(\"pcp_local\", {})",
            "432:             local_rope = self._build_pcp_rope_views(local_common, global_cache=False)",
            "433:             if local_rope is not None:",
            "434:                 local_kwargs[\"rope_views\"] = local_rope",
            "435:             local_metadata = super().build(common_prefix_len, local_common, fast_build, **local_kwargs)",
            "436: ",
            "437:         # Replicated decode needs no hidden gather or separate cache metadata.",
            "438:         if not needs_global_metadata:",
            "439:             return local_metadata",
            "440:         return AscendDSAV41PCPMetadata.from_local_metadata(",
            "441:             local_metadata, global_metadata, local_common.num_input_tokens, pcp_context.hidden_restore_idx",
            "442:         )"
          ]
        },
        {
          "owner": "AscendDSAV41PCPImpl",
          "name": "_o_proj_batch",
          "start": 451,
          "end": 464,
          "source": [
            "451:     def _o_proj_batch(self, projector, *, needs_global_metadata: bool):",
            "452:         projector._pcp_o_proj_use_full_weight = projector.enable_pcp_o_proj_weight_sharding and needs_global_metadata",
            "453:         try:",
            "454:             # V4.1 bypasses DSA forward; prepare persistent aliases during warmup.",
            "455:             if projector.enable_pcp_o_proj_weight_sharding:",
            "456:                 projector._get_pcp_o_proj_weight_switches()",
            "457:             yield",
            "458:         finally:",
            "459:             for layer, method, state in projector._pcp_o_proj_weight_switches or ():",
            "460:                 if state.handles:",
            "461:                     method.wait_weight_all_gather(state)",
            "462:                 if projector._pcp_o_proj_use_full_weight:",
            "463:                     method.switch_weight(layer, state, use_full_weight=False)",
            "464:             projector._pcp_o_proj_use_full_weight = False"
          ]
        },
        {
          "owner": "AscendDSAV41PCPImpl",
          "name": "_gather_and_restore_hidden_states",
          "start": 467,
          "end": 473,
          "source": [
            "467:     def _gather_and_restore_hidden_states(",
            "468:         hidden_states: torch.Tensor,",
            "469:         metadata: AscendDSAV41PCPMetadata,",
            "470:     ) -> torch.Tensor:",
            "471:         assert hidden_states.shape[0] == metadata.local_num_tokens_after_padding",
            "472:         gathered = get_pcp_group().all_gather(hidden_states.contiguous(), dim=0)",
            "473:         return torch.index_select(gathered, 0, metadata.hidden_restore_idx)"
          ]
        },
        {
          "owner": "AscendDSAV41PCPImpl",
          "name": "_prepare_inputs_and_caches",
          "start": 475,
          "end": 483,
          "source": [
            "475:     def _prepare_inputs_and_caches(self, attn, hidden_states, metadata, metadata_by_prefix):",
            "476:         if not isinstance(metadata.swa, AscendDSAV41PCPMetadata):",
            "477:             return super()._prepare_inputs_and_caches(attn, hidden_states, metadata, metadata_by_prefix)",
            "478:         # Empty query ranks also join hidden and weight collectives.",
            "479:         global_hidden_states = self._gather_and_restore_hidden_states(hidden_states, metadata.swa)",
            "480:         projector = attn.dsa_attn.dsa_attn.impl",
            "481:         projector._maybe_all_gather_pcp_o_proj_weights()",
            "482:         global_metadata = self._global_layer_metadata(metadata_by_prefix)",
            "483:         return self._preprocess(attn, hidden_states, global_hidden_states, metadata, global_metadata)"
          ]
        },
        {
          "owner": "AscendDSAV41PCPImpl",
          "name": "forward",
          "start": 485,
          "end": 490,
          "source": [
            "485:     def forward(self, attn, positions, hidden_states, output=None):",
            "486:         metadata = get_forward_context().attn_metadata",
            "487:         needs_global_metadata = metadata is not None and isinstance(metadata[self.swa_prefix], AscendDSAV41PCPMetadata)",
            "488:         projector = attn.dsa_attn.dsa_attn.impl",
            "489:         with self._o_proj_batch(projector, needs_global_metadata=needs_global_metadata):",
            "490:             return super().forward(attn, positions, hidden_states, output)"
          ]
        }
      ]
    },
