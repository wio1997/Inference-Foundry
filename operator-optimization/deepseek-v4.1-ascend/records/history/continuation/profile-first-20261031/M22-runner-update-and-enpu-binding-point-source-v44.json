        "3192:     def _model_forward(",
        "3193:         self,",
        "3194:         num_tokens_padded: int,",
        "3195:         input_ids: torch.Tensor | None = None,",
        "3196:         positions: torch.Tensor | None = None,",
        "3197:         intermediate_tensors: IntermediateTensors | None = None,",
        "3198:         inputs_embeds: torch.Tensor | None = None,",
        "3199:         **model_kwargs: dict[str, Any],",
        "3200:     ):",
        "3201:         assert self.model is not None",
        "3202:         forward_context = get_forward_context()",
        "3203:         assert forward_context is not None",
        "3204:         if forward_context.cudagraph_runtime_mode == CUDAGraphMode.FULL:",
        "3205:             if hasattr(self.model, \"set_attn_backend\"):",
        "3206:                 self.model.set_attn_backend(self.attn_backend)",
        "3207: ",
        "3208:         model_inputs: dict[str, Any] = {",
        "3209:             \"input_ids\": input_ids,",
        "3210:             \"positions\": positions,",
        "3211:             \"intermediate_tensors\": intermediate_tensors,",
        "3212:             \"inputs_embeds\": inputs_embeds,",
        "3213:             **model_kwargs,",
        "3214:         }",
        "3215:         # Routing runs before replay on every DP, never inside capture.",
        "3216:         prepare_engram = getattr(self.model, \"prepare_engram_inputs\", None)",
        "3217:         if prepare_engram is not None:",
        "3218:             if (",
        "3219:                 getattr(self, \"_engram_capture_active\", False)",
        "3220:                 or getattr(forward_context, \"capturing\", False)",
        "3221:                 or torch.npu.is_current_stream_capturing()",
        "3222:             ):",
        "3223:                 model_inputs.update(self.model.prepare_engram_graph_inputs(num_tokens_padded))",
        "3224:             else:",
        "3225:                 # The window is upstream's: ``_preprocess`` already ran",
        "3226:                 # ``_init_model_kwargs`` -> ``_prepare_lookback_token_ids`` on",
        "3227:                 # this step's input batch, so ``model_kwargs`` carries the",
        "3228:                 # prompt-only lookback (column j = position start - 1 - j,",
        "3229:                 # -1 where that position is not a prompt token).  Generated",
        "3230:                 # positions stay -1 here and come from the slot cache the hash",
        "3231:                 # state fills itself, which is what keeps async draft",
        "3232:                 # placeholders out of the history.",
        "3233:                 model_inputs.update(",
        "3234:                     prepare_engram(",
        "3235:                         input_ids,",
        "3236:                         positions,",
        "3237:                         num_tokens_padded,",
        "3238:                         model_kwargs.get(\"lookback_token_ids\"),",
        "3239:                         **self._get_engram_device_inputs(),",
        "3240:                     )",
        "3241:                 )",
        "3242:         run_model = partial(self.model, **model_inputs)",
        "3243: ",
        "3244:         try:",
        "3245:             if self.enable_enpu:",
        "3246:                 # The soft segmentation scenario requires event.record first, then event.wait",
