        "                var = tl.sum(pooled_bf16 * pooled_bf16, axis=0) / HEAD_DIM",
        "                norm_out = pooled_bf16 * (1.0 / tl.sqrt(var + eps)) * norm_w",
        "                out_row = tl.load(meta_ptr + 2 * NUM_BATCH + batch) + local_group",
