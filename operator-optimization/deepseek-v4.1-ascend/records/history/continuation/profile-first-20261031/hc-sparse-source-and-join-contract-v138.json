        "    // |Q--|mm1ResGm|vec1ResGm|mm2ResGm|vec2ResGm",
        "    // |Core0_Q1-Core0_Q2-Core1_Q1-Core1_Q2....Core32_Q1-Core32_Q2|Core0_mmRes",
