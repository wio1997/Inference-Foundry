        "839:     def build_for_drafting(self, common_attn_metadata, draft_index, **kwargs):",
        "840:         # DSpark issues one eager block per step. Group-local tables and slots",
        "841:         # remain independent; the builder owns the operator metadata buffers.",
        "842:         return self.build(0, common_attn_metadata)"
