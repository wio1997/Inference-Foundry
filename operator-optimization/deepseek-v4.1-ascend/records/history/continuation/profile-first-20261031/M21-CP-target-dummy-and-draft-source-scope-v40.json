      "source": [
        "2560:     def build_draft_attn_metadata(",
        "2561:         self,",
        "2562:         common_attn_metadata,",
        "2563:         num_input_tokens,",
        "2564:         num_actual_tokens,",
        "2565:     ):",
        "2566:         # FIXME(woosuk): The below two ops cause synchronization. Optimize.",
        "2567:         assert len(self.draft_attn_groups) > 0",
        "2568:         if (",
        "2569:             getattr(self.runner, \"sparse_kv_offload_enabled\", False)",
        "2570:             and self.runner.sparse_kv_offload_config.use_fused_copy_sfa",
        "2571:         ):",
        "2572:             # Step 0 uses build(), unlike subsequent build_for_drafting() calls.",
        "2573:             common_attn_metadata = self.shallow_copy_metadata(common_attn_metadata)",
        "2574:             common_attn_metadata.copy_sfa_draft_index = 0",
        "2575:             common_attn_metadata.copy_sfa_restore_tails = False",
        "2576:         per_layer_attn_metadata: dict[str, Any] = {}",
        "2577:         # One DSA cache dict shared by all attn groups within this decode step.",
        "2578:         # DSpark draft layers span multiple kv-cache groups; every group gets",
        "2579:         # its own build_for_drafting call but most of the drafted metadata",
        "2580:         # (RoPE tables, local token metadata, SAS metadata) only depends",
        "2581:         # on group-invariant fields of common_attn_metadata, so it is computed",
        "2582:         # by the first group and reused by the remaining ones. Only the DSA",
        "2583:         # metadata builder (used by dspark) understands this kwarg; the generic",
        "2584:         # GQA builder used by dflash/eagle does not accept **kwargs, so leave",
        "2585:         # the cache empty in the non-compression path to avoid passing an",
        "2586:         # unexpected argument.",
        "2587:         shared_dsa_draft_cache: dict = dict(common_ratio_to_sas_metadata=dict()) if self.use_compress else {}",
        "2588:         dcp_manager = getattr(self.runner, \"dcp_manager\", None)",
        "2589:         device_metadata_tasks: list[DeviceMetadataTask] = []",
        "2590:         device_metadata_executor = (",
        "2591:             getattr(self.runner, \"device_metadata_executor\", None)",
        "2592:             if (",
        "2593:                 self.method == \"dspark\"",
        "2594:                 and self.dcp_size == 1",
        "2595:                 and self.vllm_config.parallel_config.prefill_context_parallel_size == 1",
        "2596:             )",
        "2597:             else None",
        "2598:         )",
        "2599:         for attn_group in self.draft_attn_groups:",
        "2600:             builder = attn_group.get_metadata_builder()",
        "2601:             device_metadata_provider = (",
        "2602:                 builder",
        "2603:                 if device_metadata_executor is not None and isinstance(builder, DeviceMetadataTaskProvider)",
        "2604:                 else None",
        "2605:             )",
        "2606:             extra_attn_metadata_args: dict = dict(shared_dsa_draft_cache)",
        "2607:             if self.use_compress:",
        "2608:                 extra_attn_metadata_args[\"block_size\"] = attn_group.kv_cache_spec.block_size",
        "2609:             if self.method == \"dspark\":",
        "2610:                 gid = attn_group.kv_cache_group_id",
        "2611:                 common_attn_metadata = copy.copy(common_attn_metadata)",
        "2612:                 block_table = getattr(self, \"_per_group_block_table_buffers\", {}).get(gid)",
        "2613:                 if block_table is not None:",
        "2614:                     common_attn_metadata.block_table_tensor = block_table[: common_attn_metadata.num_reqs]",
        "2615:                 slot_mapping = self._per_group_query_slot_mapping_buffers[gid]",
        "2616:                 if slot_mapping is not None:",
        "2617:                     common_attn_metadata.slot_mapping = slot_mapping[:num_input_tokens]",
        "2618:                 # Apply the sliding window to the per-group block_table + seq_lens",
        "2619:                 # that DSpark's draft FIA actually reads. This branch overwrites",
        "2620:                 # common_attn_metadata.block_table_tensor with the full per-group",
        "2621:                 # table, so the window applied earlier (line 922) is bypassed; we",
        "2622:                 # skipped it there for dspark and re-apply here on the per-group",
        "2623:                 # table so FIA reads the recent-blocks clone instead of block 0.",
        "2624:                 # (dspark only - self.sliding_window is None for MTP.)",
        "2625:                 if self.sliding_window is not None:",
        "2626:                     self.sliding_window.apply(common_attn_metadata)",
        "2627:                 if dcp_manager is not None:",
        "2628:                     dcp_manager.prepare_common_attn_metadata(common_attn_metadata)",
        "2629:                 attn_metadata = builder.build_for_drafting(",
        "2630:                     common_attn_metadata, draft_index=1, **extra_attn_metadata_args",
        "2631:                 )",
        "2632:                 if device_metadata_provider is not None:",
        "2633:                     device_metadata_tasks.extend(device_metadata_provider.take_device_metadata_tasks())",
        "2634:             else:",
        "2635:                 if dcp_manager is not None:",
        "2636:                     dcp_manager.prepare_common_attn_metadata(common_attn_metadata)",
        "2637:                 attn_metadata = builder.build(",
        "2638:                     0, common_attn_metadata, self.runner.get_model(), **extra_attn_metadata_args",
        "2639:                 )",
        "2640:             if hasattr(attn_metadata, \"causal\") and not attn_metadata.causal:",
        "2641:                 attn_metadata.attn_mask = None",
        "2642: ",
        "2643:             for layer_name in attn_group.layer_names:",
        "2644:                 per_layer_attn_metadata[layer_name] = attn_metadata",
        "2645:         if device_metadata_executor is not None and device_metadata_tasks:",
        "2646:             device_metadata_executor.submit(device_metadata_tasks)",
        "2647:         multi_steps_attn_metadata = [per_layer_attn_metadata]",
        "2648:         # Copy the old attn_metadata and update",
        "2649:         primary_group = self._get_primary_draft_attn_group()",
        "2650:         attn_metadata_i = per_layer_attn_metadata[primary_group.layer_names[0]]",
        "2651:         return multi_steps_attn_metadata, attn_metadata_i"
      ]
