      "source": [
        "112:     def build(self, common_prefix_len, common_attn_metadata, fast_build=False, **kwargs):",
        "113:         common = common_attn_metadata",
        "114:         global_metadata = self._build_global_metadata(common_prefix_len, common, fast_build, kwargs)",
        "115:         seq_lens_cpu = (",
        "116:             common._seq_lens_cpu if getattr(common, \"_seq_lens_cpu\", None) is not None else common.seq_lens_cpu",
        "117:         )",
        "118:         start, end, per_rank, padded, qsl, seq_lens = AscendDSACPMetadataBuilder._build_local_token_metadata(",
        "119:             self,",
        "120:             common.num_reqs,",
        "121:             common.num_input_tokens,",
        "122:             common.query_start_loc_cpu,",
        "123:             seq_lens_cpu,",
        "124:             is_noncausal=not bool(getattr(common, \"causal\", True)),",
        "125:         )",
        "126:         actual_end = min(end, common.num_actual_tokens)",
        "127:         actual_start = min(start, actual_end)",
        "128:         # Padding participates in the output exchange, not in cache reads.",
        "129:         qsl = qsl.clamp_max(actual_end - actual_start).to(self._cp_query_start_loc.dtype)",
        "130:         query_start_loc = self._cp_query_start_loc[: qsl.numel()]",
        "131:         query_start_loc.copy_(qsl.pin_memory(), non_blocking=True)",
        "132:         # Device lengths are authoritative after speculative rejection; the",
        "133:         # CPU mirror may still be an upper bound. Remove only the query suffix",
        "134:         # beyond this rank's token interval from each request's device length.",
        "135:         query_ends = common.query_start_loc_cpu[1 : common.num_reqs + 1]",
        "136:         suffix = query_ends - query_ends.clamp(min=actual_start, max=actual_end)",
        "137:         if not bool(getattr(common, \"causal\", True)):",
        "138:             suffix = torch.zeros_like(suffix)",
        "139:         local_seq_lens = (",
        "140:             common.seq_lens[: common.num_reqs] - suffix.pin_memory().to(common.seq_lens.device, non_blocking=True)",
        "141:         ).clamp_min(0)",
        "142:         local_seq_lens = torch.where(query_start_loc[1:] > query_start_loc[:-1], local_seq_lens, 0)",
        "143:         local_common = common.replace(",
        "144:             query_start_loc=query_start_loc,",
        "145:             query_start_loc_cpu=qsl,",
        "146:             seq_lens=local_seq_lens,",
        "147:             seq_lens_cpu=seq_lens,",
        "148:             num_actual_tokens=actual_end - actual_start,",
        "149:             num_input_tokens=actual_end - actual_start,",
        "150:             positions=common.positions[actual_start:actual_end],",
        "151:             slot_mapping=common.slot_mapping[actual_start:actual_end],",
        "152:             max_query_len=int((qsl[1:] - qsl[:-1]).max()) if common.num_reqs else 0,",
        "153:             max_seq_len=int(seq_lens.max()) if common.num_reqs else 0,",
        "154:         )",
        "155:         kwargs[\"num_query_heads\"] = _config_value(self.vllm_config.model_config.hf_text_config, \"num_attention_heads\")",
        "156:         if global_metadata.cos is not None and global_metadata.sin is not None:",
        "157:             # Q owns a contiguous token slice of the global KV batch. Reuse",
        "158:             # that slice: a second cached RoPE gather would overwrite the",
        "159:             # process-wide buffer still referenced by global KV metadata.",
        "160:             kwargs[\"rope_views\"] = (",
        "161:                 global_metadata.cos[actual_start:actual_end],",
        "162:                 global_metadata.sin[actual_start:actual_end],",
        "163:             )",
        "164:         if global_metadata.ori_sparse_indices is not None:",
        "165:             kwargs[\"ori_sparse_indices\"] = global_metadata.ori_sparse_indices[actual_start:actual_end]",
        "166:         local = super().build(common_prefix_len, local_common, fast_build, **kwargs)",
        "167:         return replace(local, global_metadata=global_metadata, cp_token_range=(start, end, per_rank, padded))"
      ]
