        "690:     def forward(self, attn, positions, hidden_states, output: torch.Tensor | None = None):",
        "691:         # The custom-op caller provides a graph-stable output buffer.  Write",
        "692:         # O-projection results into it directly instead of materializing a",
        "693:         # second full hidden-state tensor and copying it at the graph boundary.",
        "694:         if output is None:",
        "695:             output = torch.empty_like(hidden_states)",
        "696:         forward_context = get_forward_context()",
        "697:         if forward_context.attn_metadata is None:",
        "698:             output.zero_()",
        "699:             return output",
        "700:         metadata = self._get_layer_metadata(forward_context.attn_metadata)",
        "701:         q, qr, prepared_indexer = self._prepare_inputs_and_caches(",
        "702:             attn, hidden_states, metadata, forward_context.attn_metadata",
        "703:         )",
        "704:         num_tokens = metadata.swa.num_actual_tokens",
        "705:         if num_tokens:",
        "706:             positions = metadata.positions[:num_tokens]",
        "707:             cos, sin = metadata.rope(attn.rotary_emb.layername, num_tokens)",
        "708:             compressed_indices = self._select_sparse_indices(",
        "709:                 attn, hidden_states, qr, positions, cos, sin, metadata, prepared_indexer",
        "710:             )",
        "711:             attention_output = self._forward_attention(attn, q, metadata, compressed_indices)",
        "712:             AscendDSAV41Impl._apply_rotary(attn, attention_output, cos, sin, inverse=True)",
        "713:         else:",
        "714:             heads = attn.n_heads if getattr(attn, \"enable_dsa_cp\", False) else attn.n_local_heads",
        "715:             attention_output = hidden_states.new_empty((0, heads, attn.head_dim))",
        "716:         self._project_output(attn, attention_output, hidden_states, metadata, projected=output)",
        "717:         return output"
      ]
    }
  ],
