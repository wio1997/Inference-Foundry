        "            pertoken_scale=pertoken_scale,",
        "            bias=bias if self.act_quant_type == torch.int8 else None,",
        "            output_dtype=output_dtype,",
        "        )",
        "        if need_unsqz:",
        "            output = output.unsqueeze(dim=1)",
        "        return output"
