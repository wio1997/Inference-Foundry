            "70:             expert_weight_key = self.eplb_adaptor.expert_weight_key_per_layer[layer_id]",
            "71:             for buffer_tensor in self.eplb_adaptor.buffer_tensor_list[expert_weight_key][buffer_tensor_id]:",
