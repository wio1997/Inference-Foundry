            "73:                     dist.P2POp(",
            "74:                         dist.irecv, buffer_tensor, self.comm_group.ranks[recv_rank], group=self.comm_group.device_group",
            "75:                     )",
            "76:                 )",
            "77:             local_expert_to_replace = self.updated_expert_map[global_expert_id_to_recv].item()",
            "78:             self.recv_expert_list.append((local_expert_to_replace, buffer_tensor_id))",
