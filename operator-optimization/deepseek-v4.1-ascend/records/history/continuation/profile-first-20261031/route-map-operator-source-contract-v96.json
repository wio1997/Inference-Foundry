            "  if (duplicateNum > 0) {",
            "    int duplicateIndex = this->totalLength - duplicateNum;",
            "    uint64_t mask0 = UINT64_MAX;",
            "    mask0 = mask0 << duplicateNum;",
            "    mask0 = mask0 & (UINT64_MAX >> ONE_REPEAT_SORT_NUM);",
            "    uint64_t mask[2] = {mask0, 0};",
