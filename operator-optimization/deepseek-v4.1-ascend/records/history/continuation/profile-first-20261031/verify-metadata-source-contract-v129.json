        "        markov_embs = model.markov_embed(",
        "            draft_token_ids[",
        "                :num_reqs,",
        "                :num_draft_tokens,",
        "            ]",
        "        )",
        "",
        "        flat_markov = markov_embs.reshape(",
        "            num_tokens,",
        "            markov_embs.shape[-1],",
