        "        # size. Return an empty [batch_size, 0] draft so downstream copy/unpack",
        "        # paths (which key off ``draft_token_ids.shape[1]``) stay consistent.",
        "        # Mirrors vLLM's llm_base_proposer._propose empty-draft early return.",
