        "",
        "        confidence = model.compute_confidence(",
        "            flat_hidden,",
        "            flat_markov,",
        "        )",
        "",
        "        token_probs = self._token_probs_buffer[:num_reqs]",
        "",
        "        token_probs.copy_(",
        "            confidence.reshape(",
        "                num_reqs,",
