        "    CATLASS_DEVICE",
        "    DispatchFFNCombineKernel(Params const &params)",
        "    {",
        "        if ASCEND_IS_AIC {",
        "            coreIdx = AscendC::GetBlockIdx();",
        "            coreNum = AscendC::GetBlockNum();",
        "        }",
        "",
        "        if ASCEND_IS_AIV {",
        "            coreIdx = get_block_idx() + get_subblockid() * get_block_num();",
        "            coreNum = get_block_num() * get_subblockdim();",
        "        }",
        "",
        "        initBuffer(params);"
      ]
    },
    {
      "path": "/Users/wio/work/169-vllm-ascend-reproduce-172/analysis/operator-ceiling-v2-20261028/operator-ceiling-agent-kit/runs/169-vllm-v41/whole-scope-20261030/frozen-source-snapshot/vllm-ascend/csrc/mc2/dispatch_ffn_combine/op_kernel/dispatch_ffn_combine_kernel.hpp",
