{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R247 actual R246 PASS/idle8 signoff",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "project_id",
    "unit",
    "kind",
    "actual",
    "passed",
    "r246_unit",
    "r246_host_receipt_sha256",
    "idle8",
    "r247_review_sha256",
    "signed_by",
    "signed_at",
    "authorization"
  ],
  "properties": {
    "project_id": {"const": "glm53-flash"},
    "unit": {"const": "r247"},
    "kind": {"const": "R246_ACTUAL_PASS_IDLE8_SIGNOFF"},
    "actual": {"const": true},
    "passed": {"const": true},
    "r246_unit": {"const": "r246"},
    "r246_host_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "r246_launch_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idle8": {
      "type": "object",
      "required": ["node46", "node47"],
      "properties": {
        "node46": {"const": true},
        "node47": {"const": true}
      }
    },
    "r247_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signed_by": {"const": "main-control"},
    "signed_at": {"type": "string"},
    "authorization": {
      "type": "object",
      "required": ["r247_dispatch_allowed", "execute_once", "exact_command"],
      "properties": {
        "r247_dispatch_allowed": {"const": true},
        "execute_once": {"const": true},
        "exact_command": {"const": "python3 dispatch.py"}
      }
    }
  }
}
