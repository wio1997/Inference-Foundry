+// One workspace per frontend thread, device and actual ACL stream.
+// Operators on one stream execute in order; concurrent streams never alias.
+// Old growing buffers remain owned by existing g5 launch callbacks, so graph
+// addresses and deferred launches remain valid. Geometric growth bounds the
+// sum of all retained generations below twice the largest capacity per key.
+inline at::Tensor SglangV41StreamWorkspace(uint64_t bytes, aclrtStream stream) {
+  int32_t device = -1;
+  TORCH_CHECK(aclrtGetDevice(&device) == 0, "workspace current device query failed");
+  TORCH_CHECK(bytes > 0 && bytes <= static_cast<uint64_t>(std::numeric_limits<int64_t>::max()),
+              "invalid custom-op workspace size");
+  thread_local std::unordered_map<int32_t, std::unordered_map<uintptr_t, at::Tensor>> pools;
+  auto &buffer = pools[device][reinterpret_cast<uintptr_t>(stream)];
+  if (!buffer.defined() || static_cast<uint64_t>(buffer.numel()) < bytes) {
+    uint64_t capacity = 1;
+    while (capacity < bytes) {
+      TORCH_CHECK(capacity <= static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) / 2,
+                  "custom-op workspace capacity overflow");
+      capacity *= 2;
+    }
+    buffer = at::empty({static_cast<int64_t>(capacity)},
+        at::TensorOptions(torch_npu::utils::get_npu_device_type()).dtype(at::kByte));
+    std::fprintf(stderr, "A3_V41_WORKSPACE_POOL device=%d stream=%p requested=%llu capacity=%llu\n",
+        device, reinterpret_cast<void *>(stream),
+        static_cast<unsigned long long>(bytes), static_cast<unsigned long long>(capacity));
+  }
+  return buffer;
+}
