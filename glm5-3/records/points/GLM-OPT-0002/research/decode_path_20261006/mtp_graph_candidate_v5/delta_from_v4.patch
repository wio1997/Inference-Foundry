+    def _glm_k1_stage_block_table(self, common_attn_metadata):
+        # The SFA builder retains a local view of this table. Bind persistent
+        # storage before building metadata, including the first draft step.
+        source = common_attn_metadata.block_table_tensor
+        target = self.block_table_tensor_clone
+        assert target is not None and source.ndim == target.ndim == 2
+        assert source.shape[0] <= target.shape[0] and source.shape[1] == target.shape[1]
+        view = target[: source.shape[0]]
+        if source.data_ptr() != view.data_ptr() or source.stride() != view.stride():
+            view.copy_(source)
+        common_attn_metadata.block_table_tensor = view
