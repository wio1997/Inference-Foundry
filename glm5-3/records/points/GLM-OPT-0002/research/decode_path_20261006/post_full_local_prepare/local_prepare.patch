         self.tp_size = get_tensor_model_parallel_world_size()
         self.tp_rank = get_tensor_model_parallel_rank()
 
+    def _select_tp_slice(self, tensor: torch.Tensor) -> torch.Tensor:
+        quotient, remainder = divmod(tensor.shape[0], self.tp_size)
+        start = self.tp_rank * quotient + min(self.tp_rank, remainder)
+        rows = quotient + int(self.tp_rank < remainder)
+        return tensor.narrow(0, start, rows)
+
+    def _pad_local_slice(self, tensor: torch.Tensor, rows: int) -> torch.Tensor:
+        start = min(self.tp_rank * rows, tensor.shape[0])
+        present = min(rows, tensor.shape[0] - start)
+        local = tensor.narrow(0, start, present)
+        if present == 0:
+            # Fresh zeros preserve padding ownership without an empty-input pad.
+            return tensor.new_zeros((rows, *tensor.shape[1:]))
+        if present < rows:
+            return nn.functional.pad(local, (0, 0, 0, rows - present))
+        # Global padding previously made this input independent of the caller.
+        return local.clone(memory_format=torch.contiguous_format)
+
