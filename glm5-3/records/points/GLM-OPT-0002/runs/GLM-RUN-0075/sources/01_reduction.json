          "line": 259,
          "text": "            \"enable_dsa_cp\": false,"
        },
        {
          "line": 393,
          "text": "    enable_dsa_cp: bool = False"
        },
        {
          "line": 525,
          "text": "        # so users only need `enable_dsa_cp=true` in additional_config."
        },
        {
          "line": 526,
          "text": "        if self.enable_dsa_cp and not flashcomm_explicitly_enabled:"
        },
        {
          "line": 529,
          "text": "        effective_flashcomm = flashcomm_explicitly_enabled or self.enable_dsa_cp"
        },
        {
          "line": 547,
          "text": "        if self.enable_dsa_cp:"
        },
        {
          "line": 552,
          "text": "                    \"Prefill context parallelism is already enabled; remove enable_dsa_cp from additional_config.\""
        },
        {
          "line": 558,
          "text": "                    \"to preserve the current world size. Remove enable_dsa_cp from \""
        },
        {
          "line": 565,
          "text": "                    \"Remove enable_dsa_cp from additional_config when enabling PCP.\""
        },
        {
          "line": 568,
          "text": "                \"enable_dsa_cp will be fully deprecated once PCP is ready. %s \""
        },
        {
          "line": 580,
          "text": "        if self.enable_dsa_cp and not vc.parallel_config.use_sequence_parallel_moe:"
        },
        {
          "line": 584,
          "text": "        self.enable_dsa_cp = self.enable_dsa_cp and has_indexer and vc.parallel_config.use_sequence_parallel_moe"
        },
        {
          "line": 588,
          "text": "            \"enabled\" if self.enable_dsa_cp else \"disabled\","
        }
