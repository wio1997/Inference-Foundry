      "lines": [
        "def _is_shared_expert_layer(prefix: str) -> bool:",
        "    return \"shared_experts\" in prefix or \"shared_expert\" in prefix or \"share_expert\" in prefix"
      ]
    },
    {
      "runtime_path": "/vllm-workspace/vllm-ascend/vllm_ascend/ops/linear_op.py",
      "sha256": "2a28240882788db363c14a0999b1cad68b4f9f63896d0ad9475f2d39051e818b",
