diff --git a/deepinfer/engine/dspark910c.py b/deepinfer/engine/dspark910c.py
new file mode 100644
index 0000000..e2f376f
--- /dev/null
+++ b/deepinfer/engine/dspark910c.py
@@ -0,0 +1,143 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Native DSpark greedy rejection sampling for the fixed DP2/TP8 service.
+
+Candidates come exclusively from checkpoint mtp layers, never from text
+lookup. All accepted outputs are checked against the full target model.
+"""
+import torch
+import torch.distributed as dist
+import time
+import os
+
+
+def target_tokens(runner,logits):
+    shape=logits.shape[:-1]
+    result=logits.argmax(-1).long() if runner.tp_rank==0 else torch.empty(
+        shape,dtype=torch.int64,device=runner.model.device)
+    dist.broadcast(result,runner.root,group=runner.tp_group)
+    return result.cpu().tolist()
+
+
+@torch.inference_mode()
+def generate(runner,owned,logits,hits,emit,started):
+    model=runner.model
+    draft=model.dspark
+    count=len(owned)
+    if count!=runner.slots or count!=4:
+        raise ValueError('DSpark fixed profile requires four requests per DP')
+    model.use_decode_graph=False
+    n=draft.nextn
+    width=n+1
+    model.mc2_global_bs=((count*width+runner.tp_size-1)//runner.tp_size)*dist.get_world_size()
+    maximum=[r['max_tokens'] for _,r in owned]
+    generated=[[] for _ in owned]
+    finished=[False]*count
+    eos=runner.engine.model.reader.config['eos_token_id']
+    stats={'method':'dspark','max_draft_tokens':n,'draft_network_layers':len(draft.layers),
+        'target_feature_layers':list(draft.target_layer_ids),'verification_query_tokens':width,
+        'confidence_head_executed':False,'markov_head_executed':False,
+        'verification_mode':'fixed-5','proposals':0,'draft_tokens_verified':0,
+        'draft_tokens_accepted':0,'emitted_target_tokens':0,'repair_forwards':0,
+        'draft_and_sampling_wall_seconds':0.,'target_and_sampling_wall_seconds':0.,
+        'commit_and_emit_wall_seconds':0.}
+    model.dspark_stats=stats
+    variable=os.environ.get('DEEPINFER_ENABLE_MTP_VARLEN')=='1'
+    policy=None
+    if variable:
+        from .dspark_graphs910c import DSparkTargetGraphs
+        from .dspark_confidence910c import DSparkConfidenceScheduler
+        if model.dspark_graphs is None:
+            model.dspark_graphs=DSparkTargetGraphs(model)
+        stats.update(verification_mode='confidence-scheduled',query_length_histogram={},
+                     selected_total_queries=0,padded_target_queries=0)
+
+    def output(slot,tokens):
+        import time
+        index,request=owned[slot]
+        if finished[slot]:return
+        for token in tokens:
+            generated[slot].append(token)
+            stats['emitted_target_tokens']+=1
+            emit({'type':'token','index':index,'token_id':token,'step':len(generated[slot])-1,
+                  'elapsed':time.monotonic()-started})
+            if (len(generated[slot])==maximum[slot] or
+                    (not request.get('ignore_eos',False) and token==eos)):
+                finished[slot]=True
+                break
+        if finished[slot]:
+            emit({'type':'done','index':index,'prompt_tokens':len(request['token_ids']),
+                'cached_tokens':hits[slot],'output_tokens':len(generated[slot]),
+                'token_ids':generated[slot],'finish_reason':
+                    'length' if len(generated[slot])==maximum[slot] else 'stop'})
+
+    for slot,token in enumerate(target_tokens(runner,logits)):
+        output(slot,[token])
+    first_proposal=True
+    while runner._global_busy(not all(finished)):
+        bases=[model.next_positions[s] for s in range(count)]
+        golden=[row[-1] for row in generated]
+        draft_start=time.perf_counter()
+        proposals,confidence=draft.propose(golden,bases,list(range(count)))
+        proposal_values=proposals.cpu().tolist()
+        stats['confidence_head_executed']=stats['markov_head_executed']=True
+        draft_seconds=time.perf_counter()-draft_start
+        stats['draft_and_sampling_wall_seconds']+=draft_seconds
+        confidence_values=confidence.cpu().tolist() if variable or first_proposal else None
+        if first_proposal:
+            stats['first_draft_token_ids']=proposal_values
+            stats['first_confidence']=confidence_values
+            first_proposal=False
+        if variable:
+            if policy is None:
+                curve=model.dspark_graphs.profile(golden,proposal_values)
+                policy=DSparkConfidenceScheduler(curve)
+                stats['measured_target_curve_ms']=curve
+                stats['variable_target_prefix_validation']=model.dspark_graphs.prefix_validation
+            lengths=policy.schedule()
+        else:lengths=[width]*count
+        chunks=[[g,*row[:length-1]] for g,row,length in zip(golden,proposal_values,lengths)]
+        target_start=time.perf_counter()
+        if variable:
+            values=target_tokens(runner,model.dspark_graphs.run(chunks,[[g,*row] for g,row in zip(golden,proposal_values)]))
+            predictions=model.dspark_graphs.split_predictions(values,lengths)
+            frame=model.dspark_graphs.last_frame
+            stats['selected_total_queries']+=sum(lengths)
+            stats['padded_target_queries']+=frame.tokens-sum(lengths)
+        else:
+            predictions=target_tokens(runner,model.verify_chunks(chunks))
+            frame=model._verify_graph
+        target_seconds=time.perf_counter()-target_start
+        stats['target_and_sampling_wall_seconds']+=target_seconds
+        commit_start=time.perf_counter()
+        stats['proposals']+=1
+        commits=[]
+        for slot,(candidates,targets,length) in enumerate(zip(proposal_values,predictions,lengths)):
+            if finished[slot]:
+                commits.append(0);continue
+            accepted=0
+            for candidate,target in zip(candidates[:length-1],targets):
+                if candidate!=target:break
+                accepted+=1
+            stats['draft_tokens_verified']+=length-1
+            stats['draft_tokens_accepted']+=accepted
+            if variable:
+                histogram=stats['query_length_histogram']
+                histogram[str(length)]=histogram.get(str(length),0)+1
+            commit=min(accepted+1,maximum[slot]-len(generated[slot]))
+            before=len(generated[slot])
+            output(slot,targets[:commit])
+            commits.append(len(generated[slot])-before)
+        frame.commit_prefixes(bases,commits)
+        commit_seconds=time.perf_counter()-commit_start
+        stats['commit_and_emit_wall_seconds']+=commit_seconds
+        if variable:
+            events=frame.last_forward_events
+            forward_ms=events[0].elapsed_time(events[1])
+            policy.observe_forward_ms(model.dspark_graphs.last_graph_size,forward_ms)
+            policy.observe_sampler_ms(max(0.,1000*(draft_seconds+target_seconds+commit_seconds)-forward_ms))
+            policy.observe_confidence(confidence_values)
+            stats['confidence_fp32_roundoff_clamps']=policy.confidence_roundoff_clamps
+        if runner.tp_rank==0 and stats['proposals']%32==0:
+            runner.engine.progress({'stage':'dspark','dp_rank':runner.dp_rank,
+                'generated_tokens':[len(row) for row in generated],**stats})
+    return generated
diff --git a/deepinfer/engine/dspark_confidence910c.py b/deepinfer/engine/dspark_confidence910c.py
new file mode 100644
index 0000000..8d30aef
--- /dev/null
+++ b/deepinfer/engine/dspark_confidence910c.py
@@ -0,0 +1,81 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CPU counterpart of upstream csrc/engine/mtp_varlen.hpp::MTPVarlen.
+
+Native file-IPC serving has synchronous completion, so process/schedule are
+paired. Keep the upstream two-round budget lag and one-round prefix-allocation
+lag. Current proposal confidence must not select its own verification budget.
+Hardware curve entries must be measured on the actual target graphs.
+"""
+import bisect
+import collections
+import statistics
+import math
+
+
+class DSparkConfidenceScheduler:
+    def __init__(self, curve, requests=4, nextn=5):
+        self.curve=sorted((int(size),float(ms)) for size,ms in curve)
+        if (not self.curve or any(ms<=0 for _,ms in self.curve)
+                or self.curve[-1][0]<requests*(nextn+1)):
+            raise ValueError('measured target graph curve must cover the full draft budget')
+        self.requests,self.nextn=requests,nextn
+        self.confidence_roundoff_clamps=0
+        self.accept_rates=None
+        self.prev_accept_rates=None
+        self.sampler_times=collections.deque(maxlen=9)
+        self.forward_samples=collections.deque(maxlen=5000)
+
+    def observe_forward_ms(self,graph_size,elapsed):
+        index=bisect.bisect_left([size for size,_ in self.curve],graph_size)
+        baseline=self.curve[index][1]
+        self.forward_samples.append((graph_size,(elapsed-baseline)/graph_size))
+
+    def observe_confidence(self, conditional):
+        if len(conditional)!=self.requests or any(len(row)!=self.nextn for row in conditional):
+            raise ValueError('one confidence value per request/draft position required')
+        marginal=[]
+        for row in conditional:
+            cumulative=1.
+            values=[]
+            for rate in row:
+                if not math.isfinite(rate) or not -1e-6<=rate<=1+1e-6:
+                    raise ValueError(f'invalid learned acceptance confidence {rate!r}; row={row!r}')
+                # Device sigmoid may overshoot [0,1] by a few FP32 ULPs.
+                # Bound only that roundoff; never conceal NaN/invalid values.
+                if not 0<=rate<=1:self.confidence_roundoff_clamps+=1
+                cumulative*=min(1.,max(0.,rate))
+                values.append(cumulative)
+            marginal.append(values)
+        self.prev_accept_rates=self.accept_rates
+        self.accept_rates=marginal
+
+    def observe_sampler_ms(self, elapsed):
+        if elapsed>=0:self.sampler_times.append(float(elapsed))
+
+    def schedule(self):
+        count,n=self.requests,self.nextn
+        default=[[1.]*n for _ in range(count)]
+        budget_rates=self.prev_accept_rates or default
+        allocation_rates=self.accept_rates or default
+        budget_queue=sorted(((rate,seq) for seq,row in enumerate(budget_rates)
+                             for rate in row),key=lambda x:(-x[0],x[1]))
+        allocation_queue=sorted(((rate,seq) for seq,row in enumerate(allocation_rates)
+                                 for rate in row),key=lambda x:(-x[0],x[1]))
+        sizes=[size for size,_ in self.curve]
+        sampling=statistics.median(self.sampler_times) if len(self.sampler_times)>=5 else 0.
+        groups=collections.defaultdict(list)
+        for size,residual in self.forward_samples:groups[size].append(residual)
+        medians=[statistics.median(values) for values in groups.values() if len(values)>=10]
+        slope=max(0.,statistics.median(medians)) if medians else 0.
+        expected=float(count)
+        best_throughput,budget=-1.,count
+        for total in range(count,count*(n+1)+1):
+            if total>count:expected+=budget_queue[total-count-1][0]
+            index=bisect.bisect_left(sizes,total)
+            elapsed=self.curve[index][1]+slope*self.curve[index][0]+sampling
+            throughput=expected/elapsed
+            if throughput>best_throughput:
+                best_throughput,budget=throughput,total
+        lengths=[1]*count
+        for _,seq in allocation_queue[:budget-count]:lengths[seq]+=1
+        return lengths
diff --git a/deepinfer/engine/dspark_graphs910c.py b/deepinfer/engine/dspark_graphs910c.py
new file mode 100644
index 0000000..951bfca
--- /dev/null
+++ b/deepinfer/engine/dspark_graphs910c.py
@@ -0,0 +1,129 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Native DSpark target-graph pool and measured confidence-scheduler curve."""
+import torch
+import torch.distributed as dist
+
+from deepinfer.model_executor.models.w8a8_graph910c import NativeDecodeGraph
+from deepinfer.model_executor.models.dspark_varlen910c import DSparkVarlenGraph
+
+
+class DSparkTargetGraphs:
+    def __init__(self,model):
+        self.model=model
+        # Keep sparse-MLA query spans positive in this pinned backend.
+        # Reserve one real scratch query in padded graphs; curve keys are
+        # supported REAL-query budget7, physical shape8.
+        # The all-real six-per-request graph supports budget24 directly.
+        # Reject the numerically inconsistent16-query graph (v13) and
+        # dominated23-query graph (v11). Keep verified real budgets4/7/24.
+        self.frames={4:NativeDecodeGraph(model,list(range(4))),
+                     7:DSparkVarlenGraph(model,8)}
+        self.full=NativeDecodeGraph(model,list(range(4)),query_tokens=6)
+        model._decode_graph=self.frames[4]
+        model._verify_graph=self.full
+        self.curve=None
+        self.prefix_validation=None
+        self.last_frame=None
+        self.last_graph_size=None
+
+    def reset_sequence(self):
+        for frame in self.frames.values():frame.reset_sequence()
+        self.full.reset_sequence()
+
+    def select(self,lengths):
+        total=sum(lengths)
+        size=4 if total==4 else 7 if total<=7 else 24
+        return size,self.full if size==24 else self.frames[size]
+
+    def run(self,chunks,full_chunks):
+        size,frame=self.select(list(map(len,chunks)))
+        self.last_frame,self.last_graph_size=frame,size
+        if frame is self.full:
+            lengths=list(map(len,chunks))
+            # Compute actual five-token proposals even outside the admitted
+            # prefix, retaining exactly the full target's numerical shape.
+            values=frame.step(full_chunks)
+            if lengths==[6]*4:return values
+            # Extra future positions are causal padding and never sampled.
+            return torch.cat([values[slot*6:slot*6+length] for slot,length in enumerate(lengths)])
+        return frame.step(chunks)
+
+    def split_predictions(self,values,lengths):
+        result=[];offset=0
+        for length in lengths:
+            result.append(values[offset:offset+length]);offset+=length
+        return result
+
+    def capture_initial(self,golden,proposals):
+        """Capture every selectable EP graph in the same startup order.
+
+        Request warmups then run after all graph-private memory is allocated.
+        The hardware curve is still measured on the actual warmup requests.
+        """
+        bases=self.model.next_positions[:4]
+        chunks=[[g,*p] for g,p in zip(golden,proposals)]
+        cases=[(self.frames[4],[1]*4),(self.frames[7],[2,2,2,1]),
+               (self.full,[6]*4)]
+        for frame,lengths in cases:
+            frame.step([row[:n] for row,n in zip(chunks,lengths)])
+            frame.commit_prefixes(bases,[0]*4)
+            dist.barrier()
+        self.reset_sequence()
+
+    def profile(self,golden,proposals):
+        if self.curve is not None:return self.curve
+        model=self.model
+        bases=model.next_positions[:4]
+        chunks=[[g,*p] for g,p in zip(golden,proposals)]
+        # All ranks capture the same graph pool in the same order before
+        # adaptive scheduling. Asymmetric lazy capture would break global EP
+        # ordering when the two DP replicas choose different graph sizes.
+        cases=[(4,self.frames[4],[1]*4),(7,self.frames[7],[2,2,2,1]),
+               (24,self.full,[6]*4)]
+        measured_curve={}
+        prefix_predictions=[]
+        for size,frame,lengths in cases:
+            frame.forward_event_timing=False
+            sample=[row[:n] for row,n in zip(chunks,lengths)]
+            logits=frame.step(sample)
+            predicted=logits[:sum(lengths)].argmax(-1).cpu().tolist()
+            offset=0;rows=[]
+            for length in lengths:
+                rows.append(predicted[offset:offset+length]);offset+=length
+            prefix_predictions.append((size,lengths,rows))
+            frame.commit_prefixes(bases,[0]*4)
+            dist.barrier()
+            frame.graph.replay()
+            dist.barrier()
+            events=[]
+            for _ in range(5):
+                start=torch.npu.Event(enable_timing=True)
+                end=torch.npu.Event(enable_timing=True)
+                start.record();frame.graph.replay();end.record()
+                events.append((start,end))
+                dist.barrier()
+            torch.npu.synchronize()
+            measured=sorted(start.elapsed_time(end) for start,end in events)
+            average=sum(measured[1:-1])/3
+            value=torch.tensor([average],dtype=torch.float32,device=model.device)
+            dist.all_reduce(value)
+            measured_curve[size]=max(measured_curve.get(size,0.),value.item()/dist.get_world_size())
+            frame.forward_event_timing=True
+        # These are the same real-context forwards already needed for the
+        # startup cost curve. Check all shorter/nonuniform queries against
+        # the full causal target; no extra API/model request is added.
+        reference=prefix_predictions[-1][2]
+        checked=0
+        for size,lengths,rows in prefix_predictions[:-1]:
+            for slot,(length,row) in enumerate(zip(lengths,rows)):
+                if row!=reference[slot][:length]:
+                    raise ValueError(f'variable DSpark target prefix mismatch: budget={size}, slot={slot}, actual={row}, full={reference[slot][:length]}')
+                checked+=length
+        self.prefix_validation={'state':'PASS','real_context_query_tokens_compared':checked,
+            'budgets':[size for size,_,_ in prefix_predictions],
+            'query_lengths':[lengths for _,lengths,_ in prefix_predictions],
+            'reference':'same-context full causal target graph; no saved predictions',
+            'additional_model_forwards':0}
+        self.curve=sorted(measured_curve.items())
+        self.reset_sequence()
+        return self.curve
