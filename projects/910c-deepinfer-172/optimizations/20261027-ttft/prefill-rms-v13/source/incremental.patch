+import os
 
 import torch
 import torch.nn.functional as F
 
+_FUSED_RMS_ENABLED = os.environ.get('DEEPINFER_910C_FUSED_RMS') == '1'
+_FUSED_RMS_CALLS = 0
+_RMS_NPU_FALLBACK_CALLS = 0
+
+
+def reset_rms_norm_stats():
+    global _FUSED_RMS_CALLS, _RMS_NPU_FALLBACK_CALLS
+    _FUSED_RMS_CALLS = _RMS_NPU_FALLBACK_CALLS = 0
+
+
+def rms_norm_stats():
+    return {'enabled': _FUSED_RMS_ENABLED, 'fused_eager_or_capture_calls': _FUSED_RMS_CALLS,
+            'npu_fallback_calls': _RMS_NPU_FALLBACK_CALLS,
+            'counts_include_graph_capture_but_not_graph_replays': True}
+
 
 def rms_norm_mixed(x, weight, eps):
+    global _FUSED_RMS_CALLS, _RMS_NPU_FALLBACK_CALLS
+    if _FUSED_RMS_ENABLED and x.device.type == 'npu':
+        # The pinned op keeps the BF16 result AND its FP32 pre-cast value.
+        # Its gamma ABI requires the input dtype; retain mixed-dtype math
+        # rather than silently round a higher-precision checkpoint weight.
+        if x.dtype == torch.bfloat16 and weight.dtype == x.dtype:
+            result = torch.ops._C_ascend.npu_rms_norm_cast(x, weight, eps)
+            _FUSED_RMS_CALLS += 1
+            return result
+        _RMS_NPU_FALLBACK_CALLS += 1
     value = x.float() * torch.rsqrt(x.float().square().mean(-1, keepdim=True) + eps) * weight.float()
     return value.bfloat16(), value
 
