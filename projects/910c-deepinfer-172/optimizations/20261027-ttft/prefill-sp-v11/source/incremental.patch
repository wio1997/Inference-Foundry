diff --git a/deepinfer/npu_ops/sp910c.py b/deepinfer/npu_ops/sp910c.py
new file mode 100644
index 0000000..11575a3
--- /dev/null
+++ b/deepinfer/npu_ops/sp910c.py
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Token-axis ownership for native TP attention and sequence-parallel trunk.
+
+Attention caches retain full request coordinates on every TP rank. Only the
+mHC residual stream, normalization and FFN own disjoint token slices; gather
+normalized attention inputs and reduce-scatter the partial output projection.
+"""
+import torch.distributed as dist
+
+
+class SequenceShard:
+    def __init__(self, group):
+        self.group = group
+        self.world = dist.get_world_size(group) if group is not None else 1
+        self.rank = dist.get_rank(group) if group is not None else 0
+
+    def _pad(self, value, *, fill=0):
+        tokens = value.shape[0]
+        width = (tokens + self.world - 1) // self.world
+        if width * self.world == tokens:
+            return value.contiguous(), width
+        padded = value.new_full((width * self.world, *value.shape[1:]), fill)
+        padded[:tokens].copy_(value)
+        return padded, width
+
+    def split(self, value, *, fill=0):
+        padded, width = self._pad(value, fill=fill)
+        return padded[self.rank * width:(self.rank + 1) * width].contiguous()
+
+    def gather(self, local, tokens):
+        if self.world == 1:
+            return local[:tokens]
+        output = local.new_empty((local.shape[0] * self.world, *local.shape[1:]))
+        dist.all_gather_into_tensor(output, local.contiguous(), group=self.group)
+        return output[:tokens]
+
+    def reduce(self, partial):
+        padded, width = self._pad(partial)
+        if self.world == 1:
+            return padded
+        local = padded.new_empty((width, *padded.shape[1:]))
+        dist.reduce_scatter_tensor(local, padded, group=self.group)
+        return local
diff --git a/tests/test_ascend910c_sequence_shard.py b/tests/test_ascend910c_sequence_shard.py
new file mode 100644
index 0000000..b5ad50b
--- /dev/null
+++ b/tests/test_ascend910c_sequence_shard.py
@@ -0,0 +1,25 @@
+"""CPU contracts for TP token ownership, including an idle DP scratch row."""
+import pytest
+import torch
+
+from deepinfer.npu_ops.sp910c import SequenceShard
+
+
+@pytest.mark.parametrize('tokens', [1, 7, 9, 640])
+def test_sequence_shards_preserve_tokens_and_mask_padding(tokens):
+    values = torch.arange(tokens * 3, dtype=torch.int32).reshape(tokens, 3)
+    slices = []
+    for rank in range(8):
+        shard = SequenceShard(None)
+        shard.world, shard.rank = 8, rank
+        slices.append(shard.split(values, fill=-1))
+    combined = torch.cat(slices)
+    torch.testing.assert_close(combined[:tokens], values, rtol=0, atol=0)
+    assert (combined[tokens:] == -1).all()
+    assert len({piece.shape for piece in slices}) == 1
+
+
+def test_single_rank_preserves_mhc_axes():
+    value = torch.arange(7 * 4 * 16).reshape(7, 4, 16)
+    shard = SequenceShard(None)
+    torch.testing.assert_close(shard.gather(shard.split(value), 7), value)
