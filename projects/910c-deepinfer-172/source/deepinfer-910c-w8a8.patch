diff --git a/deepinfer/model_executor/models/w8a8_compressor910c.py b/deepinfer/model_executor/models/w8a8_compressor910c.py
new file mode 100644
index 0000000..7dde0c1
--- /dev/null
+++ b/deepinfer/model_executor/models/w8a8_compressor910c.py
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Vectorized C1/C2 compression with per-request incomplete-pair state."""
+import torch
+import torch.nn.functional as F
+
+from .w8a8_math910c import rms_norm_mixed
+
+
+def compress_batch(x, batch, request_slots, ratio, wkv, wgate, norm, eps, pending):
+    """Return unrotated completed latents, source positions and request slots.
+
+    Source positions are the first token of each completed pair. A trailing
+    even token retains its FP32 projection, without BF16 rounding, until the
+    next chunk supplies its odd partner. Requests never share pending state.
+    """
+    slots = list(request_slots)
+    if len(slots) != len(batch.query_lengths) or len(set(slots)) != len(slots) or x.shape[0] != sum(batch.query_lengths):
+        raise ValueError('packed compressor token/request shape mismatch')
+    if ratio == 1:
+        latent = rms_norm_mixed(F.linear(x, wkv), norm, eps)[0]
+        positions, requests = [], []
+        for q, s, slot in zip(batch.query_lengths, batch.seq_lengths, slots):
+            positions.extend(range(s-q, s)); requests.extend([slot]*q)
+        return latent, positions, requests
+    if ratio != 2 or wgate is None:
+        raise ValueError('C2 requires an FP32 gate projection')
+    projected, scores = F.linear(x.float(), wkv.float()), F.linear(x.float(), wgate.float())
+    latents, positions, requests = [], [], []
+    offset = 0
+    for q, s, slot in zip(batch.query_lengths, batch.seq_lengths, slots):
+        start = s-q
+        kv, gate = projected[offset:offset+q], scores[offset:offset+q]
+        offset += q
+        if start % 2:
+            previous = pending.pop(slot, None)
+            if previous is None:
+                raise ValueError('C2 odd chunk start lacks preceding even-token state')
+            kv, gate = torch.cat((previous[0], kv)), torch.cat((previous[1], gate))
+            start -= 1
+        elif slot in pending:
+            raise ValueError('C2 even chunk start has unconsumed pending state')
+        if kv.shape[0] % 2:
+            pending[slot] = (kv[-1:].clone(), gate[-1:].clone())
+            kv, gate = kv[:-1], gate[:-1]
+        pairs = kv.shape[0]//2
+        if pairs:
+            pooled = (kv.reshape(pairs, 2, -1)*gate.reshape(pairs, 2, -1).softmax(1)).sum(1).bfloat16()
+            latents.append(rms_norm_mixed(pooled, norm, eps)[0])
+            positions.extend(range(start, start+2*pairs, 2)); requests.extend([slot]*pairs)
+    return torch.cat(latents) if latents else x.new_empty((0, norm.numel())), positions, requests
diff --git a/deepinfer/model_executor/models/w8a8_engram910c.py b/deepinfer/model_executor/models/w8a8_engram910c.py
new file mode 100644
index 0000000..65328cc
--- /dev/null
+++ b/deepinfer/model_executor/models/w8a8_engram910c.py
@@ -0,0 +1,132 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CPU-owned Engram hash history and selected-row staging for ModelSlim."""
+import torch
+
+from deepinfer.hugging_face.config import _build_engram
+from deepinfer.model_executor.models.v4_modules.engram_metadata import CompressedVocabulary, NgramHashMapping
+from deepinfer.npu_ops.engram910c import hashes
+from .w8a8_math910c import rotated_engram_gate
+
+
+class CpuEngramHistory:
+    def __init__(self, reader):
+        self.reader = reader
+        self.cfg = reader.config['text_config']
+        cfg = _build_engram(reader.config, reader.root)
+        vocabulary = CompressedVocabulary(cfg.tokenizer_name_or_path)
+        if len(vocabulary) != self.cfg['engram_compressed_vocab_size']:
+            raise ValueError('Engram compressed vocabulary differs from checkpoint config')
+        self.token_map = vocabulary.old2new
+        self.token_lookup = torch.from_numpy(vocabulary.lookup_table)
+        self.pad_id = self.token_map[cfg.engram_pad_token_id]
+        mapping = NgramHashMapping(cfg, device='cpu')
+        self.layers = mapping.layer_ids
+        self.multipliers = mapping.ngram_multipliers
+        self.primes = mapping.ngram_vocab_sizes
+        self.offsets = mapping.ngram_offsets
+        totals = self.primes.flatten(1).long().sum(-1).tolist()
+        if totals != self.cfg['engram_num_embeddings']:
+            raise ValueError('Engram prime bucket totals differ from checkpoint tables')
+        self.image_ids = {reader.config.get('image_token_id'), reader.config.get('image_pad_token_id')}
+        self.reset()
+
+    def reset(self):
+        self.history = []
+
+    def step(self, token_id):
+        if not 0 <= token_id < len(self.token_map):
+            raise ValueError('token outside tokenizer vocabulary')
+        self.history.append(token_id)
+        values = []
+        blocked = False
+        for shift in range(self.cfg['engram_max_ngram_size']):
+            source = self.history[-shift-1] if shift < len(self.history) else None
+            blocked = blocked or source is None or source in self.image_ids
+            values.append(self.pad_id if blocked else self.token_map[source])
+        tokens = torch.tensor([values], dtype=torch.int32)
+        image_mask = torch.tensor([token_id in self.image_ids], dtype=torch.bool)
+        output = hashes(tokens, self.multipliers, self.primes, self.offsets, image_mask)
+        return {layer: output[i, 0] for i, layer in enumerate(self.layers)}
+
+    def batch(self, token_ids):
+        """Hash a whole prefill chunk once, preserving step() history semantics."""
+        token_ids = list(token_ids)
+        if not token_ids or any(type(t) is not int or not 0 <= t < len(self.token_map) for t in token_ids):
+            raise ValueError('a nonempty chunk of valid integer tokens is required')
+        width = self.cfg['engram_max_ngram_size']
+        tail = self.history[-(width-1):] if width > 1 else []
+        context = torch.tensor(tail+token_ids, dtype=torch.int64)
+        # Vocabulary normalization is immutable. Converting its129k Python
+        # entries for each request/token dominated the CPU staging path.
+        token_map = self.token_lookup
+        target = torch.arange(len(token_ids))+len(tail)
+        blocked = torch.zeros(len(token_ids), dtype=torch.bool)
+        values = []
+        for shift in range(width):
+            source = target-shift
+            ids = context[source.clamp_min(0)]
+            image = torch.zeros_like(blocked)
+            for image_id in self.image_ids-{None}:
+                image |= ids == image_id
+            blocked |= (source < 0) | image
+            values.append(torch.where(blocked, self.pad_id, token_map[ids]))
+        image_mask = torch.zeros_like(blocked)
+        current = context[len(tail):]
+        for image_id in self.image_ids-{None}:
+            image_mask |= current == image_id
+        output = hashes(torch.stack(values, -1), self.multipliers, self.primes, self.offsets, image_mask)
+        self.history.extend(token_ids)
+        return {layer: output[i] for i, layer in enumerate(self.layers)}
+
+
+def load_rotation(reader, device):
+    rotation_cfg = reader.config.get('engram_rotation_config', {})
+    if not rotation_cfg.get('value_projection_rotated', False):
+        return None
+    if (rotation_cfg.get('value_basis') != 'quarot_global'
+            or rotation_cfg.get('key_and_gate_basis') != 'original'
+            or rotation_cfg.get('runtime_delta_rotation', False)):
+        raise ValueError('unsupported Engram checkpoint rotation contract')
+    from safetensors import safe_open
+    path = reader.root / 'optional/quarot.safetensors'
+    if not path.is_file():
+        raise ValueError('rotated Engram requires optional/quarot.safetensors')
+    with safe_open(path, framework='pt') as f:
+        rotation = f.get_tensor('global_rotation')
+    width = reader.config['text_config']['hidden_size']
+    block = rotation[:32, :32].float().contiguous()
+    if rotation.shape != (width, width) or width % 32:
+        raise ValueError('invalid global rotation shape')
+    if not torch.equal(rotation, torch.block_diag(*[block.to(rotation.dtype)] * (width//32))):
+        raise ValueError('Engram rotation must repeat the same block32')
+    return block.to(device)
+
+
+class AscendW8A8Engram(torch.nn.Module):
+    def __init__(self, reader, layer_id, device):
+        super().__init__()
+        self.reader = reader
+        self.layer_id = layer_id
+        self.device = device
+        self.eps = reader.config['text_config']['rms_norm_eps']
+        prefix = f'layers.{layer_id}.engram'
+        # The index intentionally selects the BF16 rotated projection overrides.
+        self.projection = reader.load_linear(prefix+'.wkv', device)
+        for key in ('q_weight', 'k_weight'):
+            self.register_buffer(key, reader.tensor(prefix+'.'+key)[0].to(device))
+
+    def forward(self, trunk, indices, rotation):
+        # The global table stays on host/storage. Only 24 selected group32
+        # rows (6144 BF16 values) are transferred per sequence position.
+        if indices.ndim == 1:
+            indices = indices[None]
+        if indices.shape[0] != trunk.shape[0]:
+            raise ValueError('one Engram row-index group per packed token required')
+        rows = self.reader.engram_rows(self.layer_id, indices, self.device).reshape(trunk.shape[0], -1)
+        valid = (indices >= 0).all(-1).to(trunk.device)
+        return self.forward_rows(trunk,rows,rotation,valid)
+
+    def forward_rows(self,trunk,rows,rotation,valid):
+        """Device-only gate for persistent decode graphs; CPU stages rows."""
+        kv = self.projection(rows)
+        return rotated_engram_gate(trunk, kv, self.q_weight, self.k_weight, rotation, valid, self.eps)
diff --git a/deepinfer/model_executor/models/w8a8_graph910c.py b/deepinfer/model_executor/models/w8a8_graph910c.py
new file mode 100644
index 0000000..42692ac
--- /dev/null
+++ b/deepinfer/model_executor/models/w8a8_graph910c.py
@@ -0,0 +1,184 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Persistent native full-model graph for the target four-request DP decode.
+
+CPU Engram lookup/history and API sampling stay outside the graph. IDs,
+lengths and selected Engram rows are copied into persistent inputs. All model
+layers, native MC2, cache writes, indexers and attention run in one NPU graph.
+No external inference runtime is used.
+"""
+import time
+
+import torch
+import torch.nn.functional as F
+
+from deepinfer.npu_ops.dsa910c import DSABatch
+from .ascend_w8a8_packed import PackedForward
+from .w8a8_math910c import rms_norm_mixed
+from .w8a8_paged_cache910c import CacheWritePlan
+
+
+class NativeDecodeGraph:
+    def __init__(self,model,slots,query_tokens=1):
+        self.model=model
+        self.slots=list(slots)
+        self.count=len(slots)
+        self.query_tokens=query_tokens
+        self.tokens=self.count*query_tokens
+        self.inputs=torch.zeros(self.tokens+self.count,dtype=torch.int32,device=model.device)
+        self.cpu_inputs=torch.empty_like(self.inputs,device='cpu',pin_memory=True)
+        self.requests=torch.tensor(slots,dtype=torch.int32,device=model.device)
+        self.query_requests=self.requests.repeat_interleave(query_tokens)
+        self.query_offsets=torch.arange(query_tokens,dtype=torch.int32,device=model.device)
+        self.scratch_rows=torch.arange(self.tokens,dtype=torch.int32,device=model.device)
+        self.request_rows=torch.arange(self.count,dtype=torch.int64,device=model.device)
+        self.cu_query=torch.arange(self.count+1,dtype=torch.int32,device=model.device)*query_tokens
+        self.valid=torch.ones(self.tokens,dtype=torch.bool,device=model.device)
+        self.tables={name:{key:plane.table(slots) for key,plane in getattr(model.cache,name).items()}
+                     for name in ('swa','compressed','index_key','index_scale')}
+        self.rows={i:torch.empty((self.tokens,getattr(model.engrams[str(i)].projection,'input_size',
+                    model.engrams[str(i)].projection.weight.shape[1])),
+                    dtype=torch.bfloat16,device=model.device) for i in model.cfg['engram_layer_ids']}
+        self.even={}
+        for layer in model.layers:
+            if layer.layer_id in model.cfg['kv_source_layer_ids'] and layer.ratio==2:
+                self.even[layer.layer_id]=tuple(torch.zeros((self.count,weight.shape[0]),dtype=torch.float32,device=model.device)
+                    for weight in (layer.compressor_wkv_weight,layer.compressor_wgate_weight))
+        self.even_before={key:tuple(torch.empty_like(t) for t in pair) for key,pair in self.even.items()}
+        self.graph=None
+        self.replays=0
+        self.captures=0
+        self.prepared=False
+        self.staging_seconds=0.
+
+    def reset_sequence(self):
+        self.prepared=False
+        self.replays=0
+        self.staging_seconds=0.
+
+    def _prepare_sequence(self):
+        for source,pair in self.even.items():
+            for tensor in pair:
+                tensor.zero_()
+            pending=self.model.pending.get(source,{})
+            for row,slot in enumerate(self.slots):
+                if slot in pending:
+                    for target,value in zip(pair,pending[slot]):
+                        target[row:row+1].copy_(value)
+        self.prepared=True
+
+    def _stage(self,chunks):
+        model=self.model
+        if len(chunks)!=self.count or any(len(chunk)!=self.query_tokens for chunk in chunks):
+            raise ValueError('verification chunks must match the fixed graph shape')
+        tokens=[token for chunk in chunks for token in chunk]
+        positions=[model.next_positions[slot] for slot in self.slots]
+        if max(positions)+self.query_tokens>model.max_tokens:
+            raise ValueError('verification lookahead exceeds native context capacity')
+        self.cpu_inputs.copy_(torch.tensor(tokens+[p+self.query_tokens for p in positions],dtype=torch.int32))
+        self.inputs.copy_(self.cpu_inputs,non_blocking=True)
+        hashes=[model.histories[slot].batch(chunk) for slot,chunk in zip(self.slots,chunks)] if model.histories else []
+        for layer,buffer in self.rows.items():
+            indices=torch.cat([entry[layer] for entry in hashes])
+            rows=model.reader.engram_rows(layer,indices,model.device).reshape(self.tokens,-1)
+            buffer.copy_(rows)
+
+    @staticmethod
+    def _plan(plane,positions,requests):
+        indices=plane.physical_indices(positions[:,None],requests).squeeze(-1).long()
+        return CacheWritePlan(indices,positions.shape[0])
+
+    def compressed_plans(self,source,source_positions):
+        ratio=self.model.cfg['compress_ratios'][source]
+        logical=torch.div(source_positions,ratio,rounding_mode='floor')
+        requests=self.query_requests
+        if ratio==2:
+            # Only odd tokens complete a real C2 pair. Temporary even-token
+            # rows use distinct coordinates in the reserved scratch request.
+            # This avoids aliased index_copy_ destinations for multi-token
+            # verification while keeping every active request's cache causal.
+            completed=self.positions.remainder(2)==1
+            logical=torch.where(completed,logical,self.scratch_rows)
+            requests=torch.where(completed,requests,self.model.requests-1)
+        return tuple(self._plan(getattr(self.model.cache,name)[source],logical,requests)
+                     for name in ('compressed','index_key','index_scale'))
+
+    def compress(self,layer,x,positions):
+        c=layer.config
+        if layer.ratio==1:
+            latent=rms_norm_mixed(F.linear(x,layer.compressor_wkv_weight),layer.compressor_norm_weight,c['rms_norm_eps'])[0]
+            return latent,positions
+        current=F.linear(x.float(),layer.compressor_wkv_weight.float()).reshape(self.count,self.query_tokens,-1)
+        gate=F.linear(x.float(),layer.compressor_wgate_weight.float()).reshape(self.count,self.query_tokens,-1)
+        previous,previous_gate=self.even[layer.layer_id]
+        for saved,value in zip(self.even_before[layer.layer_id],(previous,previous_gate)):
+            saved.copy_(value)
+        left=torch.cat((previous[:,None],current[:,:-1]),1)
+        left_gate=torch.cat((previous_gate[:,None],gate[:,:-1]),1)
+        pairs=torch.stack((left,current),2)
+        scores=torch.stack((left_gate,gate),2)
+        pooled=(pairs*scores.softmax(2)).sum(2).reshape(self.tokens,-1).bfloat16()
+        latent=rms_norm_mixed(pooled,layer.compressor_norm_weight,c['rms_norm_eps'])[0]
+        last=self.query_tokens-1-positions.reshape(self.count,self.query_tokens)[:,-1].remainder(2)
+        valid=(last>=0)[:,None]
+        last=last.clamp_min(0).long()
+        previous.copy_(torch.where(valid,current[self.request_rows,last],previous))
+        previous_gate.copy_(torch.where(valid,gate[self.request_rows,last],previous_gate))
+        return latent,torch.div(positions,2,rounding_mode='floor')*2
+
+    def _forward(self):
+        model=self.model
+        used=self.inputs[self.tokens:]
+        positions=(used[:,None]-self.query_tokens+self.query_offsets[None]).flatten()
+        self.positions=positions
+        batch=DSABatch((self.query_tokens,)*self.count,(model.max_tokens,)*self.count,
+            self.cu_query,used,position_values=positions)
+        plan=self._plan(model.cache.swa[0],positions,self.query_requests)
+        state=PackedForward(batch,self.slots,positions,plan,self.tables['swa'][0],
+            mc2_global_bs=model.mc2_global_bs,decode_frame=self)
+        trunk=model.embedding.index_select(0,self.inputs[:self.tokens].long())[:,None].expand(-1,model.cfg['hc_mult'],-1).contiguous()
+        previous=torch.zeros((self.tokens,model.cfg['hc_mult'],1),dtype=torch.float32,device=model.device)
+        previous[:,0]=1.
+        for i,layer in enumerate(model.layers):
+            if str(i) in model.engrams:
+                trunk=model.engrams[str(i)].forward_rows(trunk,self.rows[i],model.engram_rotation,self.valid)
+            trunk,previous=layer(trunk,previous,cache=model.cache,pending=model.pending,state=state)
+        hidden=(trunk.float()*previous).sum(-2).bfloat16()
+        hidden=rms_norm_mixed(hidden,model.norm,model.cfg['rms_norm_eps'])[0]
+        return F.linear(hidden,model.head).float()
+
+    @torch.inference_mode()
+    def step(self,chunks):
+        if not self.prepared:
+            self._prepare_sequence()
+        staged_at=time.perf_counter()
+        self._stage(chunks)
+        self.staging_seconds+=time.perf_counter()-staged_at
+        if self.graph is None:
+            # Repeated writes at the same position are idempotent. C2 even
+            # rows are invisible and odd steps retain the preceding even KV.
+            # This warms real decode kernels without advancing CPU histories.
+            initial={key:tuple(t.clone() for t in pair) for key,pair in self.even.items()}
+            def restore_even():
+                for key,pair in initial.items():
+                    for target,value in zip(self.even[key],pair):
+                        target.copy_(value)
+            for _ in range(2):
+                restore_even()
+                self._forward()
+            torch.npu.synchronize()
+            restore_even()
+            self.graph=torch.npu.NPUGraph()
+            with torch.npu.graph(self.graph):
+                self.output=self._forward()
+            self.captures+=1
+            restore_even()
+        else:
+            for layer in self.model.layers:
+                layer.cann_attention_calls+=1
+        # Capture records the model; it does not produce a usable inference
+        # output. Launch once before consuming the first captured output too.
+        self.graph.replay()
+        self.replays+=1
+        for slot in self.slots:
+            self.model.next_positions[slot]+=self.query_tokens
+        return self.output
