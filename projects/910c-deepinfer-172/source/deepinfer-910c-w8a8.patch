+    entries = {'linear.weight': (weight, 'I8'), 'linear.weight_scale': (scales, 'F32'), 'linear.weight_offset': (torch.zeros_like(scales), 'F32')}
+    return write_checkpoint(tmp_path, entries, {'linear.weight': 'W8A8_DYNAMIC'}), weight, scales
