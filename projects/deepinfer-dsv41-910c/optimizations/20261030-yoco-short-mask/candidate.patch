--- a/deepinfer/engine/short_mask910c.py
+++ b/deepinfer/engine/short_mask910c.py
@@ -0,0 +1,25 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Eligibility for page-aligned YOCO mask on a short final prefill chunk.
+
+This is an opt-in diagnostic candidate, not the default exact fallback. The
+retained queries are unchanged; only the consumer SWA left edge is shortened.
+"""
+def eligible_short_mask(model, owned, slots, chunks, hits, *, internal):
+    keep = 256
+    if internal or len(owned) != 4 or slots != list(range(4)) or len(chunks) != 4 or len(hits) != 4:
+        return False
+    if (not model.tail_ffn or not model.sequence_parallel or not model.layers[0].context_parallel
+            or model.sp.world != 8 or model.dspark is None or keep < model.cfg['sliding_window'] + model.dspark.nextn + 1):
+        return False
+    if any(slot not in model.restored_prefix_slots or hits[slot] <= 0 for slot in slots):
+        return False
+    if any(not req.get('ignore_eos', False) for _, req in owned):
+        return False
+    qlens = [len(chunk) for chunk in chunks]
+    if min(qlens) < 1 or max(qlens) > keep or max(qlens) <= keep - (model.cfg['sliding_window'] - 1):
+        return False
+    ends = [model.next_positions[slot] + len(chunk) for slot,chunk in zip(slots,chunks)]
+    if (len(set(ends)) != 1 or ends[0] % 128 or ends[0] - keep <= model.cfg['index_topk']
+            or any(end != len(owned[slot][1]['token_ids']) for slot,end in zip(slots,ends))):
+        return False
+    return True
