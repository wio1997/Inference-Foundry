--- /dev/null
+++ b/deepinfer/npu_ops/fused_swiglu910c.py
@@ -0,0 +1,37 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Experimental shared-expert clamp/SwiGLU with a BF16 output boundary.
+
+This standalone candidate is not connected to the service.  It keeps the
+existing dynamic INT8 quantization as a separate operation.  Numerical and
+graph equivalence on 910C must be established before integration.
+"""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _clamped_swiglu(x, output, ROWS: tl.constexpr, HALF: tl.constexpr,
+                    LIMIT: tl.constexpr, BLOCK: tl.constexpr):
+    offsets = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offsets < ROWS * HALF
+    row = offsets // HALF
+    col = offsets % HALF
+    gate = tl.load(x + row * (2 * HALF) + col, mask=mask, other=0).to(tl.float32)
+    up = tl.load(x + row * (2 * HALF) + HALF + col, mask=mask, other=0).to(tl.float32)
+    gate = tl.minimum(gate, LIMIT)
+    up = tl.maximum(-LIMIT, tl.minimum(up, LIMIT))
+    activated = (gate * tl.sigmoid(gate)) * up
+    tl.store(output + offsets, activated.to(tl.bfloat16), mask=mask)
+
+
+def fused_shared_activation(combined):
+    """Return the experimental BF16 activation for the fixed 3×4608 case."""
+    if (combined.ndim != 2 or tuple(combined.shape) != (3, 4608) or
+            combined.dtype != torch.bfloat16 or not combined.is_contiguous() or
+            combined.device.type != 'npu'):
+        raise ValueError('expected contiguous BF16 [3,4608] on an NPU')
+    output = torch.empty((3, 2304), dtype=torch.bfloat16, device=combined.device)
+    _clamped_swiglu[(triton.cdiv(3 * 2304, 512),)](
+        combined, output, ROWS=3, HALF=2304, LIMIT=10.0, BLOCK=512, num_warps=4)
+    return output
