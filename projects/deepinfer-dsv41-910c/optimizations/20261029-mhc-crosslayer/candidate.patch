+# SPDX-License-Identifier: Apache-2.0
+"""Fixed-24 local post/pre fusion adapter for an isolated 910C graph.
+
+The library and tiling are frozen experiment artifacts. A runtime is owned by
+one graph and all uses must execute sequentially on its single NPU stream.
+"""
+import hashlib
+from pathlib import Path
+import torch
+
+LIB=Path('/data/tiankuan/wio/910c-deepinfer-172/experiments/mhc-full-extension-axpy1024-build-20261029/hc_post_pre_check.so')
+TILING=Path('/data/tiankuan/wio/910c-deepinfer-172/experiments/mhc-real-tiling-24-20261029/tiling.bin')
+LIB_SHA='e2e5da50512304928214a954f820759f9f18af897731cdb7008591a3db8c7019'
+TILING_SHA='2e42be646314e62c56f85c1556e81fa2bf0fae5b0aee54354d93e6b9c88cba6b'
+WORKSPACE_BYTES=218103808
+
+class LazyMHC:
+    def __init__(self,model):
+        raw=TILING.read_bytes()
+        if hashlib.sha256(LIB.read_bytes()).hexdigest()!=LIB_SHA or hashlib.sha256(raw).hexdigest()!=TILING_SHA or len(raw)!=416:
+            raise RuntimeError('fixed mHC library or tiling changed')
+        config=model.cfg
+        if ((config['hidden_size'],config['hc_mult'],config['hc_sinkhorn_iters'])!=(5120,4,20) or
+                config['rms_norm_eps']!=1e-20 or config['hc_eps']!=1e-6):
+            raise ValueError('unsupported checkpoint for fixed mHC tiling')
+        props=torch.npu.get_device_properties(model.device)
+        if (props.name,props.cube_core_num,props.multi_processor_count)!=('Ascend910_9382',24,48):
+            raise ValueError('unsupported device for fixed mHC tiling')
+        torch.ops.load_library(str(LIB))
+        self.workspace=torch.empty(WORKSPACE_BYTES,dtype=torch.uint8,device=model.device)
+        self.tiling=torch.tensor(list(raw),dtype=torch.uint8,device=model.device)
+    def merge(self,layer,value,residual,post,comb,previous,kind):
+        # Keep the model's existing attention/FFN normalization outside this
+        # kernel: their rounding and router-output contracts differ.
+        return torch.ops.wio_mhc_post_pre_check.run(
+            value,residual,post,comb,getattr(layer,f'hc_{kind}_fn'),
+            getattr(layer,f'hc_{kind}_scale'),getattr(layer,f'hc_{kind}_base'),
+            previous.squeeze(-1),self.workspace,self.tiling)
